<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ClassNex.Views.NexEdgeBarWindow"
        Title="NEX 唤醒条" Width="14" Height="120" Topmost="True"
        Background="Transparent" TransparencyLevelHint="Transparent"
        SystemDecorations="None" ShowInTaskbar="False" ShowActivated="False" CanResize="False">
    <Window.Styles>
        <Style Selector="Button#WakeButton">
            <Setter Property="Opacity" Value="0.72"/>
            <Setter Property="Transitions"><Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.12"/></Transitions></Setter>
        </Style>
        <Style Selector="Button#WakeButton:pointerover"><Setter Property="Opacity" Value="1"/></Style>
        <Style Selector="Button#WakeButton:pressed"><Setter Property="Opacity" Value="0.86"/></Style>
    </Window.Styles>
    <Button x:Name="WakeButton" AutomationProperties.Name="唤醒 NEX Intelligence" Click="OnWake"
            HorizontalAlignment="Stretch" VerticalAlignment="Stretch" MinWidth="0" MinHeight="0"
            HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Cursor="Hand"
            Padding="0" CornerRadius="7" Background="{DynamicResource ClassNexSurfaceBrush}"
            BorderBrush="{DynamicResource ClassNexOutlineBrush}" BorderThickness="1">
        <Border Width="4" Height="36" CornerRadius="2" Background="{DynamicResource AccentFillColorDefaultBrush}"/>
    </Button>
</Window>
