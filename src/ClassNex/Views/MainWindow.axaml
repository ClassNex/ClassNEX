<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ctl="using:ClassNex.Controls"
        mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="200"
        x:Class="ClassNex.Views.MainWindow"
        Title="ClassNEX 主界面"
        Icon="/Assets/icon.ico"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        CanResize="False"
        SizeToContent="Height"
        WindowStartupLocation="Manual">

    
    <Panel x:Name="CardHost">
        <Panel.ContextMenu>
            <ContextMenu>
                <MenuItem Header="显示 / 隐藏主界面" Click="OnMenuToggleVisible"/>
                <Separator/>
                <MenuItem Header="编辑主界面（编辑模式）…" Click="OnMenuEnterEditMode"/>
                <MenuItem Header="组件设置…" Click="OnMenuEditWidgets"/>
                <MenuItem Header="编辑档案…" Click="OnMenuEditProfile"/>
                <MenuItem Header="应用设置…" Click="OnMenuOpenSettings"/>
                <Separator/>
                <MenuItem Header="退出 ClassNEX" Click="OnMenuExit"/>
            </ContextMenu>
        </Panel.ContextMenu>

        <Panel x:Name="HoverHost">
            <Panel.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.100"/>
                </Transitions>
            </Panel.Transitions>

            
            <Grid Margin="0,0,0,16">

                <LayoutTransformControl x:Name="RootScale" ClipToBounds="False"
                                        TextElement.FontWeight="Medium">
                    
                    <LayoutTransformControl.LayoutTransform>
                        <ScaleTransform/>
                    </LayoutTransformControl.LayoutTransform>

                    <StackPanel>
                        <Panel x:Name="LinePanel" ClipToBounds="False">

                            
                            <Border x:Name="IslandBackground"
                                    Height="40"
                                    HorizontalAlignment="Center"
                                    CornerRadius="8"
                                    BorderThickness="1"
                                    BoxShadow="0 4 8 2 #48000000">
                            </Border>

                            
                            <Border x:Name="CardContent"
                                    Margin="12,0"
                                    MinWidth="20"
                                    Background="Transparent"
                                    HorizontalAlignment="Center">
                                <Border.RenderTransform>
                                    <TranslateTransform/>
                                </Border.RenderTransform>
                                <Border.Transitions>
                                    <Transitions>
                                        <DoubleTransition Property="Opacity" Duration="0:0:0.2">
                                            <DoubleTransition.Easing>
                                                <SineEaseIn/>
                                            </DoubleTransition.Easing>
                                        </DoubleTransition>
                                    </Transitions>
                                </Border.Transitions>
                                <Grid>
                                    <StackPanel x:Name="WidgetHost"
                                                Orientation="Horizontal"
                                                Spacing="0"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Stretch"/>

                                    
                                    <StackPanel x:Name="SkeletonHost"
                                                Orientation="Horizontal"
                                                Spacing="14"
                                                Margin="6,0"
                                                IsVisible="False"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                        <Border x:Name="SkeletonBlock1" Width="80" Height="24" CornerRadius="6"/>
                                        <Border x:Name="SkeletonBlock2" Width="620" Height="24" CornerRadius="6"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            
                            <Border x:Name="NexPanel"
                                    Height="40"
                                    Margin="12,0"
                                    MinWidth="240" MaxWidth="820"
                                    CornerRadius="8"
                                    BorderThickness="1"
                                    IsVisible="False"
                                    Opacity="0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                <Border.RenderTransform>
                                    <TranslateTransform/>
                                </Border.RenderTransform>
                                <TextBlock x:Name="NexPanelText"
                                           Margin="18,0"
                                           FontSize="17"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                            </Border>

                            
                            <Border x:Name="NotificationMask"
                                    Height="40"
                                    HorizontalAlignment="Center"
                                    CornerRadius="8"
                                    ClipToBounds="True"
                                    IsVisible="False"
                                    IsHitTestVisible="False"
                                    TextElement.Foreground="Black"
                                    Width="{Binding #IslandBackground.Width}">
                                <Panel>
                                    <ctl:SlantedMaskControl x:Name="NotificationMaskBg"
                                                            ClipToBounds="True"
                                                            RegionDurationMs="360"
                                                            StageStaggerMs="120"
                                                            Fill="{DynamicResource AccentFillColorDefaultBrush}"/>
                                    <Border Padding="12 0">
                                        <StackPanel x:Name="NotificationMaskContent"
                                                    Orientation="Horizontal"
                                                    Spacing="0"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    RenderTransformOrigin="50%,50%">
                                            <StackPanel.RenderTransform>
                                                <ScaleTransform/>
                                            </StackPanel.RenderTransform>
                                            <TextBlock Text="&#xE087;" FontFamily="avares://ClassNex/Assets/Fonts/#lucide"
                                                       FontSize="20" Height="20" Width="20" TextAlignment="Center"
                                                       Foreground="Black" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="NotificationMaskText"
                                                       FontSize="18" FontWeight="Bold" Foreground="Black" Margin="8,0"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="&#xE087;" FontFamily="avares://ClassNex/Assets/Fonts/#lucide"
                                                       FontSize="20" Height="20" Width="20" TextAlignment="Center"
                                                       Foreground="Black" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Panel>
                            </Border>

                            
                            <Border x:Name="NotificationOverlay"
                                    Height="40"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    IsVisible="False"
                                    IsHitTestVisible="False"
                                    TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    Width="{Binding #IslandBackground.Width}">
                                
                                <Grid ColumnDefinitions="*,*" Margin="12,0">
                                    <TextBlock x:Name="NotificationOverlayLeft" Grid.Column="0"
                                               FontSize="16"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                                HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="下节课是：" FontSize="14" Opacity="0.7" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="NotificationOverlaySubject" FontSize="20" FontWeight="Bold"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock x:Name="NotificationOverlayTeacher" FontSize="14" Opacity="0.7"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock x:Name="NotificationOverlayTime" FontSize="14" Opacity="0.7"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            
                            <Panel x:Name="NotificationTrack"
                                   Height="2" MinHeight="2"
                                   VerticalAlignment="Bottom"
                                   HorizontalAlignment="Center"
                                   IsVisible="False"
                                   Width="{Binding #IslandBackground.Width}">
                                <Border Background="#4D808080"/>
                                <Border x:Name="NotificationTrackFill"
                                        Background="{DynamicResource AccentFillColorDefaultBrush}"
                                        HorizontalAlignment="Left"/>
                            </Panel>

                        </Panel>

                        
                        <Panel x:Name="EditBarHost"
                               IsVisible="False"
                               Margin="0,8,0,0"
                               HorizontalAlignment="Center"/>
                    </StackPanel>
                </LayoutTransformControl>

            </Grid>
        </Panel>
    </Panel>
</Window>
