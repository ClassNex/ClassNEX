<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="200"
        x:Class="ClassNex.Views.MainWindow"
        Title="ClassNEX 主界面"
        Icon="/Assets/icon.ico"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        CanResize="False"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual">

    <!-- 与 CI 一致：卡片按内容自适应宽度，停靠屏幕顶部并水平居中 -->
    <Border x:Name="RootCard" CornerRadius="8" Margin="0" Padding="26,12">
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Header="显示 / 隐藏主界面" Click="OnMenuToggleVisible"/>
                <Separator/>
                <MenuItem Header="编辑主界面（组件）…" Click="OnMenuEditWidgets"/>
                <MenuItem Header="编辑档案…" Click="OnMenuEditProfile"/>
                <MenuItem Header="应用设置…" Click="OnMenuOpenSettings"/>
                <Separator/>
                <MenuItem Header="退出 ClassNEX" Click="OnMenuExit"/>
            </ContextMenu>
        </Border.ContextMenu>

        <!-- 组件宿主：内容由 WidgetFactory 按配置动态生成，在横条内水平居中 -->
        <StackPanel x:Name="WidgetHost" Orientation="Vertical" Spacing="6"
                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
</Window>
