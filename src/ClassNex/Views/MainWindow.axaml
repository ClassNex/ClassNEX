<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ctl="using:ClassNex.Controls"
        xmlns:af="using:AvaloniaFluentUI.Controls"
        xmlns:views="using:ClassNex.Views"
        mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="200"
        x:Class="ClassNex.Views.MainWindow"
        Title="ClassNEX 主界面"
        Icon="/Assets/icon.ico"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        CanResize="False"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual">

    <Panel x:Name="CardHost">
        <Panel.ContextMenu>
            <ContextMenu>
                <MenuItem Header="显示 / 隐藏主界面" Click="OnMenuToggleVisible"/>
                <Separator/>
                <MenuItem Header="编辑主界面（编辑模式）…" Click="OnMenuEnterEditMode"/>
                <MenuItem Header="组件设置…" Click="OnMenuEditWidgets"/>
                <MenuItem Header="编辑档案…" Click="OnMenuEditProfile"/>
                <MenuItem Header="应用设置…" Click="OnMenuOpenSettings"/>
                <MenuItem Header="NEX Intelligence…" Click="OnMenuOpenNex"/>
                <MenuItem Header="恢复顶部居中" Click="OnMenuResetPlacement"/>
                <Separator/>
                <MenuItem Header="退出 ClassNEX" Click="OnMenuExit"/>
            </ContextMenu>
        </Panel.ContextMenu>

        <Panel x:Name="HoverHost">
            <Panel.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.100"/>
                </Transitions>
            </Panel.Transitions>

            <Grid Margin="16,0,16,16">

                <LayoutTransformControl x:Name="RootScale" ClipToBounds="False"
                                        TextElement.FontWeight="Medium">

                    <LayoutTransformControl.LayoutTransform>
                        <ScaleTransform/>
                    </LayoutTransformControl.LayoutTransform>

                    <StackPanel>
                        <Panel x:Name="LinePanel" ClipToBounds="False">
                            <Panel.Styles><StyleInclude Source="/Styles/ClassIslandClassroomNotification.axaml"/></Panel.Styles>

                            <Border x:Name="IslandBackground"
                                    Height="44"
                                    HorizontalAlignment="Center"
                                    CornerRadius="14"
                                    BorderThickness="0">
                                <Border x:Name="IslandSheen" CornerRadius="13" IsHitTestVisible="False"/>
                            </Border>

                            <Border x:Name="CardContent"
                                    Margin="16,0"
                                    MinWidth="20"
                                    Background="Transparent" ClipToBounds="True"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border.RenderTransform>
                                    <TranslateTransform/>
                                </Border.RenderTransform>
                                <Grid>
                                    <ScrollViewer x:Name="WidgetViewport" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                                        <StackPanel x:Name="WidgetHost" Orientation="Horizontal" Spacing="0"
                                                    HorizontalAlignment="Center" VerticalAlignment="Stretch"/>
                                    </ScrollViewer>

                                    <StackPanel x:Name="SkeletonHost"
                                                Orientation="Horizontal"
                                                Spacing="14"
                                                Margin="6,0"
                                                IsVisible="False"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                        <Border x:Name="SkeletonBlock1" Width="80" Height="24" CornerRadius="6"/>
                                        <Border x:Name="SkeletonBlock2" Width="620" Height="24" CornerRadius="6"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border x:Name="NexPanel"
                                    Height="44"
                                    Margin="16,0"
                                    MinWidth="240" MaxWidth="820"
                                    CornerRadius="14"
                                    BorderThickness="0"
                                    IsVisible="False"
                                    Opacity="0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                <Border.RenderTransform>
                                    <TranslateTransform/>
                                </Border.RenderTransform>
                                <Grid>
                                    <Border x:Name="NexSheen" CornerRadius="13" IsHitTestVisible="False"/>
                                    <TextBlock x:Name="NexPanelText"
                                               Margin="18,0"
                                               FontSize="17"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </Border>

                            <Border x:Name="NotificationMaskShadow" ZIndex="1" IsHitTestVisible="False" HorizontalAlignment="Center"
                                    Height="{Binding #IslandBackground.Height}" Width="{Binding #IslandBackground.Width}" CornerRadius="8" Opacity="0"
                                    Background="{DynamicResource AccentFillColorDefaultBrush}">
                                <Border.Transitions><Transitions><BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.1"/></Transitions></Border.Transitions>
                                <Border.Styles>
                                    <Style Selector="Border#NotificationMaskShadow.entering">
                                        <Setter Property="BoxShadow" Value="0 8 32 0 #66000000"/>
                                        <Style.Animations>
                                            <Animation Delay="0:0:0.60" Duration="0:0:0.1" IterationCount="1" FillMode="Forward">
                                                <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.0"/></KeyFrame>
                                                <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1.0"/></KeyFrame>
                                            </Animation>
                                        </Style.Animations>
                                    </Style>
                                    <Style Selector="Border#NotificationMaskShadow.revealing">
                                        <Style.Animations>
                                            <Animation Duration="0:0:0.1" IterationCount="1" FillMode="Forward">
                                                <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.0"/></KeyFrame>
                                            </Animation>
                                        </Style.Animations>
                                    </Style>
                                </Border.Styles>
                            </Border>
                            <Border x:Name="NotificationMask" ZIndex="2" Height="{Binding #IslandBackground.Height}" CornerRadius="8"
                                    HorizontalAlignment="Center" IsVisible="False" IsHitTestVisible="False" ClipToBounds="True"
                                    TextElement.Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                    Width="{Binding #IslandBackground.Width}">
                                <Panel>
                                    <ctl:SlantedMaskControl x:Name="NotificationMaskBg" ClipToBounds="True" RegionDurationMs="360" StageStaggerMs="120"
                                                            Fill="{DynamicResource AccentFillColorDefaultBrush}"/>
                                    <ScrollViewer x:Name="MaskTitleViewport" Padding="12 0" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                  HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled">
                                        <Border x:Name="NotificationMaskContent" RenderTransformOrigin="50%,50%">
                                            <Border.RenderTransform><TransformGroup><ScaleTransform/></TransformGroup></Border.RenderTransform>
                                            <StackPanel x:Name="NotificationMaskIcons" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <Border Width="20" Height="20" VerticalAlignment="Center">
                                                    <af:FontIcon x:Name="NotificationMaskLeftIcon" Glyph="&#xE0FF;" FontSize="20" Margin="0,-1.5,0,-1.5" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                                                </Border>
                                                <TextBlock x:Name="NotificationMaskText" FontSize="{DynamicResource MainWindowEmphasizedFontSize}" Margin="8 0" FontWeight="Bold"/>
                                                <Border Width="20" Height="20" VerticalAlignment="Center">
                                                    <af:FontIcon x:Name="NotificationMaskRightIcon" Glyph="&#xE54F;" FontSize="20" Margin="0,-1.5,0,-1.5" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </ScrollViewer>
                                </Panel>
                            </Border>

                            <Border x:Name="NotificationOverlay"
                                    Height="{Binding #IslandBackground.Height}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    IsVisible="False"
                                    IsHitTestVisible="False"
                                    Background="Transparent"
                                    TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    ClipToBounds="True" CornerRadius="8"
                                    Width="{Binding #IslandBackground.Width}">
                                <Border.Styles>
                                    <Style Selector="TextBlock">
                                        <Setter Property="FontSize" Value="{DynamicResource MainWindowBodyFontSize}"/>
                                        <Setter Property="FontWeight" Value="{Binding $parent[Control].(TextElement.FontWeight)}"/>
                                    </Style>
                                </Border.Styles>
                                <Grid x:Name="NotificationDetailLayout" HorizontalAlignment="Center">
                                    <Canvas VerticalAlignment="Bottom"
                                            HorizontalAlignment="Stretch"
                                            x:Name="ProgressContainer"
                                            Height="{Binding #OverlayTimeProgressBar.Bounds.Height}">
                                        <Canvas.Resources>
                                            <ResourceDictionary>
                                                <ResourceDictionary.MergedDictionaries>
                                                    <ResourceInclude Source="/Styles/ClassIslandNotificationProgressTheme.axaml"/>
                                                </ResourceDictionary.MergedDictionaries>
                                            </ResourceDictionary>
                                        </Canvas.Resources>
                                        <ProgressBar VerticalAlignment="Bottom"
                                                     Maximum="1"
                                                     Theme="{StaticResource ClassIslandNotificationProgressTheme}"
                                                     Value="{Binding CountdownProgressValue, RelativeSource={RelativeSource AncestorType=views:MainWindow}}"
                                                     x:Name="OverlayTimeProgressBar"
                                                     Width="{Binding #ProgressContainer.Bounds.Width, Mode=OneWay}"
                                                     MinWidth="0">
                                            <ProgressBar.Transitions>
                                                <Transitions>
                                                    <DoubleTransition Property="Value" Duration="0:0:0.05">
                                                        <DoubleTransition.Easing>
                                                            <LinearEasing/>
                                                        </DoubleTransition.Easing>
                                                    </DoubleTransition>
                                                </Transitions>
                                            </ProgressBar.Transitions>
                                        </ProgressBar>
                                    </Canvas>
                                    <ScrollViewer x:Name="NotificationBodyViewport" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled"
                                                  HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                                    <Grid x:Name="NotificationPages">
                                    <Grid x:Name="NotificationCourseProvider" Margin="16 0">
                                        <Grid.Resources>
                                            <ResourceDictionary>
                                                <ResourceDictionary.MergedDictionaries>
                                                    <ResourceInclude Source="/Styles/Upstream/FluentAvalonia/ListBoxStyles.axaml"/>
                                                </ResourceDictionary.MergedDictionaries>
                                            </ResourceDictionary>
                                        </Grid.Resources>
                                        <ListBox x:Name="NotificationSlides" Theme="{StaticResource {x:Type ListBox}}" Classes="sliding" IsHitTestVisible="False" Focusable="False">
                                            <ListBoxItem FontSize="{DynamicResource MainWindowBodyFontSize}" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                                                <Grid x:Name="NotificationOverlayCoursePage" ColumnDefinitions="Auto,Auto" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock x:Name="NotificationOverlayLeft" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="12 0">
                                                        <Run Text="距上课还剩" Classes="l-instructive"/>
                                                        <Run x:Name="NotificationSeconds" FontWeight="Bold"/>
                                                        <Run Text="秒" Classes="l-instructive"/>
                                                    </TextBlock>
                                                    <TextBlock x:Name="NotificationBreakCaption" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="12 0" IsVisible="False">
                                                        <Run Text="本节" Classes="l-instructive"/><Run x:Name="NotificationBreakName"/><Run Text="长" Classes="l-instructive"/>
                                                        <Run x:Name="NotificationBreakDuration" FontWeight="Bold"/>
                                                    </TextBlock>
                                                    <TextBlock x:Name="NotificationPlainCaption" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="12 0" IsVisible="False"/>
                                                    <WrapPanel x:Name="NotificationLesson" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Orientation="Horizontal" Margin="12 0">
                                                        <TextBlock x:Name="NotificationOverlayPrefix" VerticalAlignment="Center" Classes="l-instructive"/>
                                                        <TextBlock x:Name="NotificationOverlaySubject" VerticalAlignment="Center" FontWeight="Bold" FontSize="{DynamicResource MainWindowLargeFontSize}"/>
                                                        <TextBlock x:Name="NotificationOverlayTeacher" Margin="6 0 0 0" FontSize="{DynamicResource MainWindowSecondaryFontSize}" VerticalAlignment="Bottom" Classes="l-secondary"/>
                                                        <TextBlock x:Name="NotificationOverlayTime" Margin="2 0 0 0" FontSize="{DynamicResource MainWindowSecondaryFontSize}" VerticalAlignment="Bottom" Classes="l-secondary"/>
                                                    </WrapPanel>
                                                </Grid>
                                            </ListBoxItem>
                                            <ListBoxItem FontSize="{DynamicResource MainWindowBodyFontSize}" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                                                <TextBlock x:Name="NotificationOverlayMessagePage" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            </ListBoxItem>
                                        </ListBox>
                                    </Grid>
                                    <Grid x:Name="NotificationSimpleProvider" IsVisible="False">
                                        <TextBlock x:Name="NotificationSimpleMessage" Margin="24 0" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                   FontSize="{DynamicResource MainWindowBodyFontSize}" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                    </Grid>
                                    </ScrollViewer>
                                </Grid>
                            </Border>

                        </Panel>

                        <Panel x:Name="EditBarHost"
                               IsVisible="False"
                               Margin="0,8,0,0"
                               HorizontalAlignment="Center"/>
                    </StackPanel>
                </LayoutTransformControl>

            </Grid>
        </Panel>
    </Panel>
</Window>
