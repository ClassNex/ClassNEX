<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ctl="using:ClassNex.Controls"
        mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="200"
        x:Class="ClassNex.Views.MainWindow"
        Title="ClassNEX 主界面"
        Icon="/Assets/icon.ico"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        CanResize="False"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual">

    <Panel x:Name="CardHost">
        <Panel.ContextMenu>
            <ContextMenu>
                <MenuItem Header="显示 / 隐藏主界面" Click="OnMenuToggleVisible"/>
                <Separator/>
                <MenuItem Header="编辑主界面（编辑模式）…" Click="OnMenuEnterEditMode"/>
                <MenuItem Header="组件设置…" Click="OnMenuEditWidgets"/>
                <MenuItem Header="编辑档案…" Click="OnMenuEditProfile"/>
                <MenuItem Header="应用设置…" Click="OnMenuOpenSettings"/>
                <MenuItem Header="NEX Intelligence…" Click="OnMenuOpenNex"/>
                <MenuItem Header="恢复顶部居中" Click="OnMenuResetPlacement"/>
                <Separator/>
                <MenuItem Header="退出 ClassNEX" Click="OnMenuExit"/>
            </ContextMenu>
        </Panel.ContextMenu>

        <Panel x:Name="HoverHost">
            <Panel.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.100"/>
                </Transitions>
            </Panel.Transitions>

            <Grid Margin="16,0,16,16">

                <LayoutTransformControl x:Name="RootScale" ClipToBounds="False"
                                        TextElement.FontWeight="Medium">

                    <LayoutTransformControl.LayoutTransform>
                        <ScaleTransform/>
                    </LayoutTransformControl.LayoutTransform>

                    <StackPanel>
                        <Panel x:Name="LinePanel" ClipToBounds="False">

                            <Border x:Name="IslandBackground"
                                    Height="44"
                                    HorizontalAlignment="Center"
                                    CornerRadius="14"
                                    BorderThickness="0">
                                <Border x:Name="IslandSheen" CornerRadius="13" IsHitTestVisible="False"/>
                            </Border>

                            <Border x:Name="CardContent"
                                    Margin="16,0"
                                    MinWidth="20"
                                    Background="Transparent" ClipToBounds="True"
                                    HorizontalAlignment="Center">
                                <Border.RenderTransform>
                                    <TranslateTransform/>
                                </Border.RenderTransform>
                                <Border.Transitions>
                                    <Transitions>
                                        <DoubleTransition Property="Opacity" Duration="0:0:0.2">
                                            <DoubleTransition.Easing>
                                                <SineEaseIn/>
                                            </DoubleTransition.Easing>
                                        </DoubleTransition>
                                    </Transitions>
                                </Border.Transitions>
                                <Grid>
                                    <ScrollViewer x:Name="WidgetViewport" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                                        <StackPanel x:Name="WidgetHost" Orientation="Horizontal" Spacing="0"
                                                    HorizontalAlignment="Center" VerticalAlignment="Stretch"/>
                                    </ScrollViewer>

                                    <StackPanel x:Name="SkeletonHost"
                                                Orientation="Horizontal"
                                                Spacing="14"
                                                Margin="6,0"
                                                IsVisible="False"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                        <Border x:Name="SkeletonBlock1" Width="80" Height="24" CornerRadius="6"/>
                                        <Border x:Name="SkeletonBlock2" Width="620" Height="24" CornerRadius="6"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border x:Name="NexPanel"
                                    Height="44"
                                    Margin="16,0"
                                    MinWidth="240" MaxWidth="820"
                                    CornerRadius="14"
                                    BorderThickness="0"
                                    IsVisible="False"
                                    Opacity="0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                <Border.RenderTransform>
                                    <TranslateTransform/>
                                </Border.RenderTransform>
                                <Grid>
                                    <Border x:Name="NexSheen" CornerRadius="13" IsHitTestVisible="False"/>
                                    <TextBlock x:Name="NexPanelText"
                                               Margin="18,0"
                                               FontSize="17"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </Border>

                            <Border x:Name="NotificationMask"
                                    Height="44"
                                    HorizontalAlignment="Center"
                                    CornerRadius="14"
                                    ClipToBounds="True"
                                    IsVisible="False"
                                    IsHitTestVisible="False"
                                    TextElement.Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                    Width="{Binding #IslandBackground.Width}">
                                <Panel>
                                    <ctl:SlantedMaskControl x:Name="NotificationMaskBg"
                                                            ClipToBounds="True"
                                                            RegionDurationMs="190"
                                                            StageStaggerMs="50"
                                                            Fill="{DynamicResource AccentFillColorDefaultBrush}"/>
                                    <Border Padding="12 0">
                                        <StackPanel x:Name="NotificationMaskContent"
                                                    Orientation="Horizontal"
                                                    Spacing="0"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    RenderTransformOrigin="50%,50%">
                                            <StackPanel.RenderTransform>
                                                <ScaleTransform/>
                                            </StackPanel.RenderTransform>
                                            <TextBlock x:Name="NotificationMaskLeftIcon"
                                                       Text="&#xE0FF;" FontFamily="avares://ClassNex/Assets/Fonts/#lucide"
                                                       FontSize="20" Height="20" Width="20" TextAlignment="Center"
                                                       Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="NotificationMaskText"
                                                       FontSize="18" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" Margin="8,0"
                                                       TextWrapping="Wrap" TextAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock x:Name="NotificationMaskRightIcon"
                                                       Text="&#xE54F;" FontFamily="avares://ClassNex/Assets/Fonts/#lucide"
                                                       FontSize="20" Height="20" Width="20" TextAlignment="Center"
                                                       Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Panel>
                            </Border>

                            <Border x:Name="NotificationOverlay"
                                    Height="44"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    IsVisible="False"
                                    IsHitTestVisible="False"
                                    Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                                    TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    ClipToBounds="True" CornerRadius="14"
                                    Width="{Binding #IslandBackground.Width}">

                                <Grid>
                                    <Grid x:Name="NotificationOverlayCoursePage"
                                          ColumnDefinitions="Auto,*" Margin="16,0" ColumnSpacing="16">
                                        <TextBlock x:Name="NotificationOverlayLeft" Grid.Column="0"
                                                   FontSize="16" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                                        <Grid Grid.Column="1" x:Name="NotificationLesson" VerticalAlignment="Center"
                                              ColumnDefinitions="Auto,Auto,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="6">
                                            <TextBlock x:Name="NotificationOverlayPrefix" Text="下节课是"
                                                       FontSize="14" Opacity="0.77" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="NotificationOverlaySubject" Grid.Column="1" FontSize="20"
                                                       TextWrapping="Wrap" VerticalAlignment="Center"/>
                                            <StackPanel x:Name="NotificationLessonMeta" Grid.Column="2" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                <TextBlock x:Name="NotificationOverlayTeacher" FontSize="13" Opacity="0.8"/>
                                                <TextBlock x:Name="NotificationOverlayTime" FontSize="13" Opacity="0.8"/>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                    <TextBlock x:Name="NotificationOverlayMessagePage"
                                               IsVisible="False"
                                               FontSize="16"
                                               Margin="24,0"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               HorizontalAlignment="Stretch"
                                               VerticalAlignment="Center">
                                        <TextBlock.RenderTransform>
                                            <TranslateTransform/>
                                        </TextBlock.RenderTransform>
                                    </TextBlock>
                                </Grid>
                            </Border>

                            <Panel x:Name="NotificationTrack"
                                   Height="2" MinHeight="2"
                                   VerticalAlignment="Bottom"
                                   HorizontalAlignment="Center"
                                   IsVisible="False"
                                   Width="{Binding #IslandBackground.Width}">
                                <Border Background="{DynamicResource ControlStrongStrokeColorDefaultBrush}"/>
                                <Border x:Name="NotificationTrackFill"
                                        Background="{DynamicResource AccentFillColorDefaultBrush}"
                                        HorizontalAlignment="Left"/>
                            </Panel>

                        </Panel>

                        <Panel x:Name="EditBarHost"
                               IsVisible="False"
                               Margin="0,8,0,0"
                               HorizontalAlignment="Center"/>
                    </StackPanel>
                </LayoutTransformControl>

            </Grid>
        </Panel>
    </Panel>
</Window>
