<wd:AppWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:AvaloniaFluentUI.Controls"
        xmlns:wd="using:AvaloniaFluentUI.Windowing"
        x:Class="ClassNex.Views.OobeWindow"
        Title="欢迎使用 ClassNEX"
        Icon="/Assets/icon.ico"
        TitleBarHeight="48"
        IsTitleBarContentVisible="False"
        Width="1040" Height="660"
        MinWidth="880" MinHeight="560"
        WindowStartupLocation="CenterScreen">

    

    <Window.Styles>
        
        <Style Selector="Button.Link">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style Selector="Button.Link:pointerover /template/ ContentPresenter">
            <Setter Property="TextBlock.TextDecorations" Value="Underline"/>
        </Style>
        <Style Selector="TextBlock.OobeTitle">
            <Setter Property="FontSize" Value="30"/>
        </Style>
        <Style Selector="TextBlock.OobeBody">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="Button.SetupChoice">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource ClassNexCardRadius}"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="MinHeight" Value="184"/>
            <Setter Property="Padding" Value="22,18"/>
        </Style>
        <Style Selector="TextBlock.MigrationDetail">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="TextBlock.NextGlyph">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="Text" Value="&#xE76C;"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        
        <Style Selector="Button.Primary">
            <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="20,8"/>
        </Style>
        <Style Selector="Button.Primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentFillColorSecondaryBrush}"/>
        </Style>
        <Style Selector="Button.Primary:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentFillColorTertiaryBrush}"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="*,Auto">
        <Grid Grid.Row="0">
            <Panel x:Name="PageBody" ClipToBounds="True">

            
            <Grid x:Name="PageWelcome" ColumnDefinitions="3*,2*">
                <StackPanel x:Name="WelcomeTextPanel" Grid.Column="0" Spacing="14" Margin="56,16,32,0"
                            VerticalAlignment="Center" HorizontalAlignment="Left" MaxWidth="560">
                    <TextBlock x:Name="GreetingText"
                               Text="你好"
                               FontSize="46"/>

                    <TextBlock x:Name="WelcomeBody" Classes="OobeBody"
                               Text="欢迎使用 ClassNEX，让我们开始吧"/>

                    <TextBlock x:Name="Bullet1" Classes="OobeBody"
                               Text="• 选择「同意并继续」即表示您同意隐私政策。"/>

                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                        <Button x:Name="PrivacyLink" Classes="Link" Content="隐私政策"/>
                        <TextBlock Text="|" Opacity="0.5" VerticalAlignment="Center"/>
                        <Button x:Name="LicenseLink" Classes="Link" Content="开源许可（GPL-3.0）"/>
                    </StackPanel>

                    <StackPanel Spacing="6" Margin="0,14,0,0">
                        <TextBlock x:Name="LanguageLabel" Text="选择语言" FontSize="15"/>
                        <ComboBox x:Name="LanguageCombo" Width="280" HorizontalAlignment="Left">
                            <ComboBoxItem Content="简体中文"/>
                            <ComboBoxItem Content="English"/>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>

                
                <Border x:Name="WelcomeImage" Grid.Column="0" Grid.ColumnSpan="2"
                        Margin="445,121,0,23" ClipToBounds="True" IsHitTestVisible="False"/>
            </Grid>

            <Grid x:Name="PageData" IsVisible="False" Margin="56,50,56,16" VerticalAlignment="Center">
                <StackPanel Spacing="22" MaxWidth="840" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="6">
                        <TextBlock x:Name="DataTitle" Classes="OobeTitle" Text="数据与迁移"/>
                        <TextBlock x:Name="DataBody" Classes="OobeBody" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                        <Button x:Name="NewDeviceButton" Classes="SetupChoice" AutomationProperties.LabeledBy="{Binding #NewDeviceTitle}">
                            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="8">
                                <Image Width="48" Height="48" HorizontalAlignment="Left" Source="/Assets/SettingsIcons/window.png"/>
                                <TextBlock x:Name="NewDeviceTitle" Grid.Row="1" Margin="0,10,0,0" FontSize="19" VerticalAlignment="Bottom" TextWrapping="Wrap"/>
                                <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <TextBlock x:Name="NewDeviceDetail" Classes="MigrationDetail"/>
                                    <TextBlock Grid.Column="1" Classes="NextGlyph"/>
                                </Grid>
                            </Grid>
                        </Button>
                        <Button x:Name="ImportDeviceButton" Grid.Column="1" Classes="SetupChoice" AutomationProperties.LabeledBy="{Binding #ImportDeviceTitle}">
                            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="8">
                                <Image Width="48" Height="48" HorizontalAlignment="Left" Source="/Assets/SettingsIcons/profile.png"/>
                                <TextBlock x:Name="ImportDeviceTitle" Grid.Row="1" Margin="0,10,0,0" FontSize="19" VerticalAlignment="Bottom" TextWrapping="Wrap"/>
                                <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <TextBlock x:Name="ImportDeviceDetail" Classes="MigrationDetail"/>
                                    <TextBlock Grid.Column="1" Classes="NextGlyph"/>
                                </Grid>
                            </Grid>
                        </Button>
                    </Grid>
                </StackPanel>
            </Grid>

            <ScrollViewer x:Name="PageImport" IsVisible="False" Margin="56,50,48,8" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="840" Margin="0,4,8,8" Spacing="14" VerticalAlignment="Center">
                    <StackPanel Spacing="6" Margin="0,0,0,4">
                        <TextBlock x:Name="ImportTitle" Classes="OobeTitle" Text="从 ClassIsland 迁移"/>
                        <TextBlock x:Name="ImportBody" Classes="OobeBody" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <Border Classes="sectionSurface">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                            <Image Width="36" Height="36" Source="/Assets/SettingsIcons/profile.png"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                <TextBlock x:Name="ImportSourceLabel" FontSize="16" TextWrapping="Wrap"/>
                                <SelectableTextBlock x:Name="ImportSourcePath" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button x:Name="BrowseImportButton" Grid.Column="2" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <Grid x:Name="ImportFeedback" RowDefinitions="Auto,Auto,Auto,Auto" IsVisible="False" Margin="2,0">
                        <TextBlock x:Name="ImportStatus" FontSize="15" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                        <Border x:Name="ImportProgressRow" Grid.Row="1" IsVisible="False" Margin="0,6,0,0" MinHeight="12" ClipToBounds="True">
                            <ProgressBar x:Name="ImportProgress" Minimum="0" Maximum="100" Height="4" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="ImportDetails" Grid.Row="2" Classes="MigrationDetail" IsVisible="False" Margin="0,4,0,0"/>
                        <Expander x:Name="ImportNotes" Grid.Row="3" Margin="0,6,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsVisible="False" IsExpanded="False">
                            <TextBlock x:Name="ImportNotesText" Classes="MigrationDetail"/>
                        </Expander>
                    </Grid>
                    <Expander x:Name="ImportAdvanced" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="False">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" Margin="0,3">
                            <StackPanel Spacing="4" VerticalAlignment="Center">
                                <TextBlock x:Name="CleanupLabel" FontSize="15" TextWrapping="Wrap"/>
                                <TextBlock x:Name="CleanupDetail" Classes="MigrationDetail"/>
                            </StackPanel>
                            <ToggleSwitch x:Name="CleanupToggle" Grid.Column="1" IsChecked="True" VerticalAlignment="Center" AutomationProperties.LabeledBy="{Binding #CleanupLabel}"/>
                        </Grid>
                    </Expander>
                    <TextBlock x:Name="CleanupSummary" Classes="MigrationDetail" Margin="2,0"/>
                </StackPanel>
            </ScrollViewer>

            
            <StackPanel x:Name="PagePreferences" IsVisible="False" Margin="56,16,56,0" Spacing="16" MaxWidth="620"
                        HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock x:Name="PreferencesTitle" Classes="OobeTitle" Text="个性化设置"/>
                <TextBlock x:Name="PreferencesBody" Classes="OobeBody" Opacity="0.8"
                           Text="这些设置稍后都能在「应用设置」里修改。"/>

                <StackPanel Spacing="6">
                    <TextBlock x:Name="ThemeLabel" Text="外观" FontSize="15"/>
                    <ComboBox x:Name="ThemeCombo" Width="280" HorizontalAlignment="Left">
                        <ComboBoxItem Content="跟随系统"/>
                        <ComboBoxItem Content="浅色"/>
                        <ComboBoxItem Content="深色"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock x:Name="SemesterLabel" Text="开学日期" FontSize="15"/>
                    <DatePicker x:Name="SemesterPicker" Width="280" HorizontalAlignment="Left"/>
                </StackPanel>

                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock x:Name="RunAtStartupText" Text="开机时自动启动 ClassNEX"
                               VerticalAlignment="Center"/>
                    <ToggleSwitch Grid.Column="1" x:Name="RunAtStartupCheck"/>
                </Grid>
            </StackPanel>

            
            <StackPanel x:Name="PageAccount" IsVisible="False" Margin="56,16,56,0" Spacing="12" MaxWidth="620"
                        HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock x:Name="AccountTitle" Classes="OobeTitle" Text="账户"/>
                <TextBlock x:Name="AccountBody" Classes="OobeBody" Opacity="0.8"
                           Text="登录后，头像、用户名与邮箱会从账户服务同步到本机。"/>
                <Button x:Name="OobeLoginButton" Content="登录 / 注册 ClassNEX 账号" Classes="Primary"
                        MinWidth="220" HorizontalAlignment="Left"/>
                <TextBlock x:Name="OobeLoginStatus" FontSize="13" TextWrapping="Wrap" MaxWidth="560"
                           Opacity="0.85"/>
                <Border x:Name="OobeAccountCard" IsVisible="False" CornerRadius="8" Padding="14"
                        BorderThickness="1" MaxWidth="420"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <Border x:Name="OobeAvatar" Width="48" Height="48" CornerRadius="24" BorderThickness="3" ClipToBounds="True"/>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock x:Name="OobeAccountName" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock x:Name="OobeAccountEmail" FontSize="12" Opacity="0.7"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Button x:Name="OobeLogoutButton" Content="退出登录" IsVisible="False" HorizontalAlignment="Left"/>
            </StackPanel>

            
            <StackPanel x:Name="PageMore" IsVisible="False" Margin="56,16,56,0" Spacing="12" MaxWidth="620"
                        HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock x:Name="MoreTitle" Classes="OobeTitle" Text="语音唤醒"/>
                <TextBlock x:Name="MoreBody" Classes="OobeBody" Opacity="0.8"
                           Text="开启后，NEX 会在向导完成后使用麦克风监听唤醒词。关闭也可以手动打开 NEX。"/>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
                    <TextBlock x:Name="VoiceWakeLabel" Text="监听唤醒词" VerticalAlignment="Center"/>
                    <ToggleSwitch Grid.Column="1" x:Name="VoiceWakeCheck"/>
                </Grid>
            </StackPanel>

            
            <Panel x:Name="PageFinish" IsVisible="False">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
                    <TextBlock x:Name="FinishTitle" Text="一切就绪" FontSize="34" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="FinishBody" Classes="OobeBody" Opacity="0.85"
                               TextAlignment="Center" MaxWidth="560"
                               Text="点击「完成」后 ClassNEX 会重新启动，并在桌面上显示课表浮窗。"/>
                </StackPanel>
            </Panel>
            </Panel>
            <TextBlock x:Name="StepIndicator"
                       Margin="56,18,0,0"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top"
                       FontSize="12"
                       Opacity="0.62"
                       ZIndex="10"
                       IsHitTestVisible="False"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
        </Grid>

        
        <Grid Grid.Row="1" Margin="56,12,56,28" HorizontalAlignment="Right">
            <StackPanel x:Name="FooterActions" Orientation="Horizontal" Spacing="12">
                <Button x:Name="BackButton" Content="上一步" MinWidth="104"/>
                <Button x:Name="NextButton" Content="同意并继续" MinWidth="120" Classes="Primary"/>
            </StackPanel>
        </Grid>
    </Grid>
</wd:AppWindow>
