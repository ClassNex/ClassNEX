<wd:AppWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:AvaloniaFluentUI.Controls"
        xmlns:views="using:ClassNex.Views"
        xmlns:wd="using:AvaloniaFluentUI.Windowing"
        x:Class="ClassNex.Views.OobeWindow"
        Title="欢迎使用 ClassNEX"
        Icon="/Assets/icon.ico"
        TitleBarHeight="48"
        IsTitleBarContentVisible="False"
        Width="1040" Height="660"
        MinWidth="880" MinHeight="560"
        WindowStartupLocation="CenterScreen">

    

    <Window.Styles>
        
        <Style Selector="Button.Link">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style Selector="Button.Link:pointerover /template/ ContentPresenter">
            <Setter Property="TextBlock.TextDecorations" Value="Underline"/>
        </Style>
        <Style Selector="TextBlock.OobeTitle">
            <Setter Property="FontSize" Value="30"/>
        </Style>
        <Style Selector="TextBlock.OobeBody">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        
        <Style Selector="Button.Primary">
            <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="20,8"/>
        </Style>
        <Style Selector="Button.Primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentFillColorSecondaryBrush}"/>
        </Style>
        <Style Selector="Button.Primary:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentFillColorTertiaryBrush}"/>
        </Style>
        <Style Selector="Ellipse.PageDot">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Height" Value="8"/>
            <Setter Property="Fill" Value="{DynamicResource ControlStrongStrokeColorDefaultBrush}"/>
        </Style>
        <Style Selector="Ellipse.PageDot.Active">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Fill" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="*,Auto">
        <Grid Grid.Row="0">

            
            <Grid x:Name="PageWelcome" ColumnDefinitions="3*,2*">
                <StackPanel Grid.Column="0" Spacing="14" Margin="56,16,32,0"
                            VerticalAlignment="Center" HorizontalAlignment="Left" MaxWidth="560">
                    <TextBlock x:Name="GreetingText"
                               Text="你好"
                               FontFamily="Noto Serif SC, Source Han Serif SC, SimSun"
                               FontSize="46"/>

                    <TextBlock x:Name="WelcomeBody" Classes="OobeBody"
                               Text="欢迎使用 ClassNEX，让我们开始吧"/>

                    <TextBlock x:Name="Bullet1" Classes="OobeBody"
                               Text="• 选择「同意并继续」即表示您同意隐私政策。"/>

                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                        <Button x:Name="PrivacyLink" Classes="Link" Content="隐私政策"/>
                        <TextBlock Text="|" Opacity="0.5" VerticalAlignment="Center"/>
                        <Button x:Name="LicenseLink" Classes="Link" Content="开源许可（GPL-3.0）"/>
                    </StackPanel>

                    <StackPanel Spacing="6" Margin="0,14,0,0">
                        <TextBlock x:Name="LanguageLabel" Text="选择语言" FontSize="15"/>
                        <ComboBox x:Name="LanguageCombo" Width="280" HorizontalAlignment="Left">
                            <ComboBoxItem Content="简体中文"/>
                            <ComboBoxItem Content="English"/>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>

                
                <Border Grid.Column="0" Grid.ColumnSpan="2"
                        Margin="445,121,0,23" ClipToBounds="True">
                    <Border.Background>
                        <ImageBrush Source="avares://ClassNex/Assets/Oobe/Classroom.png"
                                    Stretch="UniformToFill"
                                    AlignmentX="Left" AlignmentY="Center"/>
                    </Border.Background>
                </Border>
            </Grid>

            
            <StackPanel x:Name="PagePreferences" IsVisible="False" Margin="56,16,56,0" Spacing="16" MaxWidth="620"
                        HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock x:Name="PreferencesTitle" Classes="OobeTitle" Text="个性化设置"/>
                <TextBlock x:Name="PreferencesBody" Classes="OobeBody" Opacity="0.8"
                           Text="这些设置稍后都能在「应用设置」里修改。"/>

                <StackPanel Spacing="6">
                    <TextBlock x:Name="ThemeLabel" Text="外观" FontSize="15"/>
                    <ComboBox x:Name="ThemeCombo" Width="280" HorizontalAlignment="Left">
                        <ComboBoxItem Content="跟随系统"/>
                        <ComboBoxItem Content="浅色"/>
                        <ComboBoxItem Content="深色"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock x:Name="SemesterLabel" Text="开学日期" FontSize="15"/>
                    <DatePicker x:Name="SemesterPicker" Width="280" HorizontalAlignment="Left"/>
                </StackPanel>

                <CheckBox x:Name="RunAtStartupCheck" Content="开机时自动启动 ClassNEX"/>
            </StackPanel>

            
            <StackPanel x:Name="PageAccount" IsVisible="False" Margin="56,16,56,0" Spacing="12" MaxWidth="620"
                        HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock x:Name="AccountTitle" Classes="OobeTitle" Text="账户"/>
                <TextBlock x:Name="AccountBody" Classes="OobeBody" Opacity="0.8"
                           Text="登录后，头像、用户名与邮箱会从账户服务同步到本机。"/>
                <Button x:Name="OobeLoginButton" Content="登录 / 注册 ClassNEX 账号" Classes="Primary"
                        MinWidth="220" HorizontalAlignment="Left"/>
                <TextBlock x:Name="OobeLoginStatus" FontSize="13" TextWrapping="Wrap" MaxWidth="560"
                           Opacity="0.85"/>
                <Border x:Name="OobeAccountCard" IsVisible="False" CornerRadius="8" Padding="14"
                        BorderThickness="1" MaxWidth="420"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <Border x:Name="OobeAvatar" Width="48" Height="48" CornerRadius="24" BorderThickness="3"/>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock x:Name="OobeAccountName" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock x:Name="OobeAccountEmail" FontSize="12" Opacity="0.7"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Button x:Name="OobeLogoutButton" Content="退出登录" IsVisible="False" HorizontalAlignment="Left"/>
            </StackPanel>

            
            <StackPanel x:Name="PageMore" IsVisible="False" Margin="56,16,56,0" Spacing="12" MaxWidth="620"
                        HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock x:Name="MoreTitle" Classes="OobeTitle" Text="更多设置"/>
                <TextBlock x:Name="MoreBody" Classes="OobeBody" Opacity="0.8"
                           Text="此页面预留：后续版本继续补充。"/>
            </StackPanel>

            
            <Panel x:Name="PageFinish" IsVisible="False">
                <views:FireworksView x:Name="Fireworks"/>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
                    <TextBlock x:Name="FinishTitle" Text="一切就绪" FontSize="34" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="FinishBody" Classes="OobeBody" Opacity="0.85"
                               TextAlignment="Center" MaxWidth="560"
                               Text="点击「完成」后 ClassNEX 会重新启动，并在桌面上显示课表浮窗。"/>
                </StackPanel>
            </Panel>
        </Grid>

        
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="56,12,56,28">
            <StackPanel x:Name="PageDots" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                <Button x:Name="BackButton" Content="上一步" MinWidth="104"/>
                <Button x:Name="NextButton" Content="同意并继续" MinWidth="120" Classes="Primary"/>
            </StackPanel>
        </Grid>
    </Grid>
</wd:AppWindow>
