<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:AvaloniaFluentUI.Controls"
        x:Class="ClassNex.Views.TrayMenuWindow"
        Width="240" SizeToContent="Height"
        SystemDecorations="None" ShowInTaskbar="False" Topmost="True"
        CanResize="False" TransparencyLevelHint="Transparent"
        Background="Transparent" WindowStartupLocation="Manual">

    <Window.Styles>
        <!-- 菜单项悬停高亮（照 Fluent 菜单） -->
        <Style Selector="Button.TrayMenuItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
        </Style>
        <Style Selector="Button.TrayMenuItem:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}"/>
        </Style>
    </Window.Styles>

    <!-- 托盘左键菜单（原生托盘菜单只能右键弹，所以左键用这个 Fluent 菜单窗） -->
    <Border Margin="8" CornerRadius="6" BorderThickness="1" Padding="4"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            Background="{DynamicResource AcrylicBackgroundFillColorDefaultBrush}">
        <StackPanel x:Name="ItemsPanel" Spacing="2"/>
    </Border>
</Window>
