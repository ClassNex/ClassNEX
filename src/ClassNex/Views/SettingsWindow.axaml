<wd:AppWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="using:AvaloniaFluentUI.Controls"
        xmlns:wd="using:AvaloniaFluentUI.Windowing"
        mc:Ignorable="d" d:DesignWidth="1240" d:DesignHeight="620"
        x:Class="ClassNex.Views.SettingsWindow"
        Title="应用设置"
        Icon="/Assets/icon.ico"
        TitleBarHeight="48"
        IsTitleBarContentVisible="False"
        Width="1050" Height="720"
        MinWidth="680" MinHeight="480"
        WindowStartupLocation="CenterScreen">

    
    <Grid x:Name="SettingsRoot" RowDefinitions="48,*" Background="{DynamicResource ClassNexSurfaceBrush}">
        
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12" Margin="12,0,150,0">
            <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                <Button x:Name="BackButton" Theme="{StaticResource TransparentButton}" Padding="8,6" ToolTip.Tip="返回上一页" AutomationProperties.Name="返回上一页" Click="OnNavigateBack"><ui:FontIcon Glyph="&#xE048;" FontSize="15" VerticalAlignment="Center"/></Button>
                <Image Source="/Assets/icon.ico" Width="22" Height="22"/>
                <TextBlock Text="ClassNEX" FontSize="14" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBox x:Name="SearchBox" Grid.Column="1" MaxWidth="380" HorizontalAlignment="Stretch" VerticalAlignment="Center" Watermark="搜索设置" MinHeight="32">
                <TextBox.InnerLeftContent><ui:FontIcon Glyph="&#xE151;" FontSize="15" VerticalAlignment="Center"/></TextBox.InnerLeftContent>
            </TextBox>
            <TextBlock Grid.Column="2" x:Name="VersionText" FontSize="12" VerticalAlignment="Center" ToolTip.Tip="连点 10 次可解锁开发者选项" PointerPressed="OnVersionPointerPressed" Classes="muted"/>
                            <Button Grid.Column="3" x:Name="MoreOptionsButton" Theme="{StaticResource TransparentButton}"
                    VerticalAlignment="Center" ToolTip.Tip="更多选项…">
                <ui:FontIcon FontFamily="avares://ClassNex/Assets/Fonts/#lucide" Glyph="&#xE0B6;" FontSize="14"/>
                <Button.Flyout>
                    <MenuFlyout>
                        <MenuItem Header="创建快捷方式…">
                            <MenuItem.Icon><ui:FontIcon FontFamily="avares://ClassNex/Assets/Fonts/#lucide" Glyph="&#xE102;"/></MenuItem.Icon>
                            <MenuItem Header="创建桌面快捷方式" Click="OnCreateDesktopShortcut">
                                <MenuItem.Icon><ui:FontIcon FontFamily="avares://ClassNex/Assets/Fonts/#lucide" Glyph="&#xE11D;"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="创建开始菜单快捷方式" Click="OnCreateStartMenuShortcut">
                                <MenuItem.Icon><ui:FontIcon FontFamily="avares://ClassNex/Assets/Fonts/#lucide" Glyph="&#xE426;"/></MenuItem.Icon>
                            </MenuItem>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="NEX Intelligence…" Click="OnOpenNexChat"/>
                        <MenuItem Header="日志…" Click="OnOpenLogFile">
                            <MenuItem.Icon><ui:FontIcon FontFamily="avares://ClassNex/Assets/Fonts/#lucide" Glyph="&#xE0CC;"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="导出诊断数据…" Click="OnExportDiagnostics">
                            <MenuItem.Icon><ui:FontIcon FontFamily="avares://ClassNex/Assets/Fonts/#lucide" Glyph="&#xE0B2;"/></MenuItem.Icon>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="打开日志目录…" Click="OnOpenLogsFolder">
                            <MenuItem.Icon><ui:FontIcon FontFamily="avares://ClassNex/Assets/Fonts/#lucide" Glyph="&#xE0D7;"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="打开数据目录…" Click="OnOpenDataFolder">
                            <MenuItem.Icon><ui:FontIcon FontFamily="avares://ClassNex/Assets/Fonts/#lucide" Glyph="&#xE0D7;"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="打开应用目录…" Click="OnOpenAppFolder">
                            <MenuItem.Icon><ui:FontIcon FontFamily="avares://ClassNex/Assets/Fonts/#lucide" Glyph="&#xE0D7;"/></MenuItem.Icon>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="重启 ClassNEX" Click="OnRestartApp">
                            <MenuItem.Icon><ui:FontIcon FontFamily="avares://ClassNex/Assets/Fonts/#lucide" Glyph="&#xE145;"/></MenuItem.Icon>
                        </MenuItem>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <ui:NavigationView Grid.Row="1" x:Name="NavView"
                           Background="Transparent"
                           PaneDisplayMode="Auto" OpenPaneLength="208" CompactModeThresholdWidth="540" ExpandedModeThresholdWidth="860"
                           IsBackButtonVisible="False" IsSettingsVisible="False"
                           IsPaneToggleButtonVisible="True">

            
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Tag="home" Content="总览">
                    <ui:NavigationViewItem.IconSource><ui:FontIconSource FontFamily="avares://ClassNex/Assets/Fonts/#lucide" Glyph="&#xE1C1;"/></ui:NavigationViewItem.IconSource>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Tag="schedule" Content="课表与课程">
                    <ui:NavigationViewItem.IconSource><ui:FontIconSource FontFamily="avares://ClassNex/Assets/Fonts/#lucide" Glyph="&#xE2B9;"/></ui:NavigationViewItem.IconSource>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Tag="profile" Content="档案管理">
                    <ui:NavigationViewItem.IconSource><ui:FontIconSource FontFamily="avares://ClassNex/Assets/Fonts/#lucide" Glyph="&#xE0D7;"/></ui:NavigationViewItem.IconSource>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Tag="widgets" Content="桌面组件">
                    <ui:NavigationViewItem.IconSource><ui:FontIconSource FontFamily="avares://ClassNex/Assets/Fonts/#lucide" Glyph="&#xE0FF;"/></ui:NavigationViewItem.IconSource>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Tag="window" Content="悬浮窗口">
                    <ui:NavigationViewItem.IconSource><ui:FontIconSource FontFamily="avares://ClassNex/Assets/Fonts/#lucide" Glyph="&#xE426;"/></ui:NavigationViewItem.IconSource>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Tag="notification" Content="通知提醒">
                    <ui:NavigationViewItem.IconSource><ui:FontIconSource FontFamily="avares://ClassNex/Assets/Fonts/#lucide" Glyph="&#xE059;"/></ui:NavigationViewItem.IconSource>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Tag="appearance" Content="外观与主题">
                    <ui:NavigationViewItem.IconSource><ui:FontIconSource FontFamily="avares://ClassNex/Assets/Fonts/#lucide" Glyph="&#xE1DD;"/></ui:NavigationViewItem.IconSource>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Tag="account" Content="账户与登录">
                    <ui:NavigationViewItem.IconSource><ui:FontIconSource FontFamily="avares://ClassNex/Assets/Fonts/#lucide" Glyph="&#xE462;"/></ui:NavigationViewItem.IconSource>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Tag="central" Content="集控管理">
                    <ui:NavigationViewItem.IconSource><ui:FontIconSource FontFamily="avares://ClassNex/Assets/Fonts/#lucide" Glyph="&#xE125;"/></ui:NavigationViewItem.IconSource>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Tag="plugins" Content="插件与扩展">
                    <ui:NavigationViewItem.IconSource><ui:FontIconSource FontFamily="avares://ClassNex/Assets/Fonts/#lucide" Glyph="&#xE29C;"/></ui:NavigationViewItem.IconSource>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Tag="nex" Content="NEX Intelligence">
                    <ui:NavigationViewItem.IconSource><ui:FontIconSource FontFamily="avares://ClassNex/Assets/Fonts/#lucide" Glyph="&#xE412;"/></ui:NavigationViewItem.IconSource>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Tag="basic" Content="系统与启动">
                    <ui:NavigationViewItem.IconSource><ui:FontIconSource FontFamily="avares://ClassNex/Assets/Fonts/#lucide" Glyph="&#xE154;"/></ui:NavigationViewItem.IconSource>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Tag="debug" Content="开发者选项" x:Name="DebugNavItem" IsVisible="False">
                    <ui:NavigationViewItem.IconSource><ui:FontIconSource FontFamily="avares://ClassNex/Assets/Fonts/#lucide" Glyph="&#xE20C;"/></ui:NavigationViewItem.IconSource>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Tag="about" Content="关于 ClassNEX">
                    <ui:NavigationViewItem.IconSource><ui:FontIconSource FontFamily="avares://ClassNex/Assets/Fonts/#lucide" Glyph="&#xE0F9;"/></ui:NavigationViewItem.IconSource>
                </ui:NavigationViewItem>
            </ui:NavigationView.MenuItems>

            <Grid RowDefinitions="Auto,*" Background="{DynamicResource ClassNexCanvasBrush}" ClipToBounds="True">
                <StackPanel Grid.Row="0" Margin="24,18,24,8" Spacing="3">
                    <TextBlock x:Name="PageTitleText" FontSize="26"/>
                    <TextBlock x:Name="PageSubtitleText" Classes="muted" TextWrapping="Wrap"/>
                </StackPanel>
                <ScrollViewer x:Name="PageScroll" Grid.Row="1"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <Grid x:Name="PageHost" Margin="24,6,24,24" MaxWidth="1200"
                          RenderOptions.TextRenderingMode="Antialias"
                          RenderOptions.BitmapInterpolationMode="LowQuality"
                          HorizontalAlignment="Stretch" VerticalAlignment="Top">
                        <Grid.Styles>
                            <Style Selector="Grid#PageHost > StackPanel">
                                <Setter Property="VerticalAlignment" Value="Top"/>
                                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                            </Style>
                            <Style Selector="ui|SettingsExpander">
                                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                            </Style>
                            <Style Selector="ui|InfoBar">
                                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                            </Style>
                        </Grid.Styles>

                        
                        <StackPanel x:Name="PageHome" Spacing="16">
                            <StackPanel Spacing="3">
                                <TextBlock x:Name="HomeSubText" Classes="muted"/>
                                <TextBlock x:Name="HomeGreetingText" FontSize="26" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Border Classes="sectionSurface">
                                <StackPanel Spacing="13">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <ui:FontIcon Glyph="&#xE2B9;" FontSize="18" VerticalAlignment="Center"/><TextBlock Text="今日课程" VerticalAlignment="Center" FontSize="16"/>
                                        <Border x:Name="HomeStatusDot" Width="6" Height="6" CornerRadius="3" Margin="6,0,-4,0" Background="{DynamicResource AccentFillColorDefaultBrush}" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="HomeCourseStatusText" Classes="muted" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="18">
                                        <StackPanel Spacing="4"><TextBlock x:Name="HomeCourseNameText" FontSize="27" TextWrapping="Wrap"/><TextBlock x:Name="HomeCourseTimeText" Classes="muted" TextWrapping="Wrap"/></StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center"><TextBlock Text="下一节" Classes="muted"/><TextBlock x:Name="HomeNextText" FontSize="17" TextWrapping="Wrap"/></StackPanel>
                                    </Grid>
                                    <Border Height="1" Background="{DynamicResource ClassNexOutlineBrush}"/>
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                        <TextBlock Text="今日进度" Classes="muted" VerticalAlignment="Center"/>
                                        <ProgressBar x:Name="HomeDayProgress" Grid.Column="1" Height="4" VerticalAlignment="Center" AutomationProperties.Name="今日课程进度"/>
                                        <TextBlock Grid.Column="2" x:Name="HomeTodaySummaryText" Classes="muted" VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <StackPanel Spacing="8">
                                <TextBlock Text="常用设置" Classes="sectionLabel"/>
                                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                                    <Button Classes="homeLink" Grid.Row="0" Grid.Column="0" Tag="schedule" Click="OnPageLink">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10"><ui:FontIcon Glyph="&#xE2B9;" FontSize="17" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="课表与课程" VerticalAlignment="Center"/><ui:FontIcon Grid.Column="2" Glyph="&#xE06F;" FontSize="13" Opacity="0.6"/></Grid>
                                    </Button>
                                    <Button Classes="homeLink" Grid.Row="0" Grid.Column="1" Tag="widgets" Click="OnPageLink">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10"><ui:FontIcon Glyph="&#xE0FF;" FontSize="17" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="桌面组件" VerticalAlignment="Center"/><ui:FontIcon Grid.Column="2" Glyph="&#xE06F;" FontSize="13" Opacity="0.6"/></Grid>
                                    </Button>
                                    <Button Classes="homeLink" Grid.Row="1" Grid.Column="0" Tag="notification" Click="OnPageLink">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10"><ui:FontIcon Glyph="&#xE059;" FontSize="17" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="通知提醒" VerticalAlignment="Center"/><ui:FontIcon Grid.Column="2" Glyph="&#xE06F;" FontSize="13" Opacity="0.6"/></Grid>
                                    </Button>
                                    <Button Classes="homeLink" Grid.Row="1" Grid.Column="1" Tag="account" Click="OnPageLink">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10"><ui:FontIcon Glyph="&#xE462;" FontSize="17" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="账户与登录" VerticalAlignment="Center"/><ui:FontIcon Grid.Column="2" Glyph="&#xE06F;" FontSize="13" Opacity="0.6"/></Grid>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel x:Name="PageNex" Spacing="12" IsVisible="False">
                            <ui:InfoBar Severity="Informational" IsOpen="True" IsClosable="False"
                                        Message="NEX 是内置的 AI 助手：能查课表、看应用状态，也能按你选的权限读写文件。对话内容会发送到接口服务商。"/>

                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Button x:Name="NexOpenChatButton" Content="打开 NEX 对话框" Classes="Primary" MinWidth="150"/>
                                <Button x:Name="NexGlowEntryButton" Content="预览跑马灯"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,2">
                                <ui:FontIcon FontFamily="avares://ClassNex/Assets/Fonts/#lucide"
                                             Glyph="&#xE1F9;" FontSize="16" Opacity="0.82"/>
                                <TextBlock Text="助手设置" FontSize="15" VerticalAlignment="Center"/>
                            </StackPanel>

                            <ui:SettingsExpander x:Name="NexApiStateItem" Header="模型服务配置" Description="尚未配置">
                                <ui:SettingsExpander.IconSource>
                                    <ui:FontIconSource FontFamily="avares://ClassNex/Assets/Fonts/#lucide" Glyph="&#xE37F;"/>
                                </ui:SettingsExpander.IconSource>
                                <ui:SettingsExpander.Footer>
                                    <TextBlock x:Name="NexApiStateText" Classes="muted" VerticalAlignment="Center"/>
                                </ui:SettingsExpander.Footer>
                                <ui:SettingsExpanderItem Content="服务地址" Description="留空使用默认服务地址">
                                    <ui:SettingsExpanderItem.Footer>
                                        <TextBox x:Name="NexBaseUrlBox" Width="210" Watermark="默认服务地址"/>
                                    </ui:SettingsExpanderItem.Footer>
                                </ui:SettingsExpanderItem>
                                <ui:SettingsExpanderItem Content="接口密钥" Description="默认服务可以读取本机环境凭据；自定义地址须单独填写密钥。">
                                    <ui:SettingsExpanderItem.Footer>
                                        <TextBox x:Name="NexApiKeyBox" Width="210" PasswordChar="•" Watermark="输入你的密钥"/>
                                    </ui:SettingsExpanderItem.Footer>
                                </ui:SettingsExpanderItem>
                                <ui:SettingsExpanderItem Content="模型" Description="输入模型名称，或从已配置的服务获取列表。">
                                    <ui:SettingsExpanderItem.Footer>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <ComboBox x:Name="NexModelCombo" Width="160" IsEditable="True"/>
                                            <Button x:Name="NexFetchModelsButton" Content="拉取模型"/>
                                        </StackPanel>
                                    </ui:SettingsExpanderItem.Footer>
                                </ui:SettingsExpanderItem>
                                <ui:SettingsExpanderItem Content="测试与重置" Description="重置会清空本机自定义的接口和密钥。">
                                    <ui:SettingsExpanderItem.Footer>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button x:Name="NexTestButton" Content="测试连接"/>
                                            <Button x:Name="NexResetButton" Content="恢复默认配置"/>
                                            <TextBlock x:Name="NexStatusText" VerticalAlignment="Center" FontSize="13"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                    </ui:SettingsExpanderItem.Footer>
                                </ui:SettingsExpanderItem>
                            </ui:SettingsExpander>

                            <ui:SettingsExpander Header="默认权限"
                                                 Description="打开对话框时的默认档位（对话框顶部随时可改）。仅可查看=只读；工作区内修改=可改应用数据目录里的文件；完全权限=任意路径 + 执行命令。">
                                <ui:SettingsExpander.IconSource>
                                    <ui:FontIconSource FontFamily="avares://ClassNex/Assets/Fonts/#lucide" Glyph="&#xE1FF;"/>
                                </ui:SettingsExpander.IconSource>
                                <ui:SettingsExpander.Footer>
                                    <ComboBox x:Name="NexPermissionCombo" Width="180">
                                        <ComboBoxItem Content="仅可查看"/>
                                        <ComboBoxItem Content="工作区内修改"/>
                                        <ComboBoxItem Content="完全权限"/>
                                    </ComboBox>
                                </ui:SettingsExpander.Footer>
                            </ui:SettingsExpander>

                            <ui:SettingsExpander Header="系统提示词"
                                                 Description="可选。留空用内置提示词（会带上应用状态、工作区与当前权限说明）。">
                                <ui:SettingsExpander.IconSource>
                                    <ui:FontIconSource FontFamily="avares://ClassNex/Assets/Fonts/#lucide" Glyph="&#xE1F9;"/>
                                </ui:SettingsExpander.IconSource>
                                <ui:SettingsExpanderItem Content="自定义提示词">
                                    <ui:SettingsExpanderItem.Footer>
                                        <TextBox x:Name="NexSystemPromptBox" Width="320" AcceptsReturn="True"
                                                 MinHeight="64" MaxHeight="140" TextWrapping="Wrap"
                                                 Watermark="留空使用内置提示词"/>
                                    </ui:SettingsExpanderItem.Footer>
                                </ui:SettingsExpanderItem>
                            </ui:SettingsExpander>

                            <ui:SettingsExpander Header="语音唤醒"
                                                 Description="对着麦克风说「嘿 NEX」或「NEX」即可唤醒：响起提示音、屏幕四周亮起跑马灯，浮窗课表向上翻页变成对话。">
                                <ui:SettingsExpander.IconSource>
                                    <ui:FontIconSource FontFamily="avares://ClassNex/Assets/Fonts/#lucide" Glyph="&#xE118;"/>
                                </ui:SettingsExpander.IconSource>
                                <ui:SettingsExpander.Footer>
                                    <ToggleSwitch x:Name="NexVoiceWakeCheck"/>
                                </ui:SettingsExpander.Footer>
                                <ui:SettingsExpanderItem Content="唤醒条" Description="屏幕左右侧贴一条半透明小白条，点一下等于喊「嘿 NEX」">
                                    <ui:SettingsExpanderItem.Footer>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <ToggleSwitch x:Name="NexEdgeBarCheck"/>
                                            <ComboBox x:Name="NexEdgeBarSideCombo" Width="110">
                                                <ComboBoxItem Content="右侧"/>
                                                <ComboBoxItem Content="左侧"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </ui:SettingsExpanderItem.Footer>
                                </ui:SettingsExpanderItem>
                                <ui:SettingsExpanderItem Content="状态" Description="识别在本机离线进行，不上传麦克风音频">
                                    <ui:SettingsExpanderItem.Footer>
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <TextBlock x:Name="NexVoiceStatusText" VerticalAlignment="Center" FontSize="13"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            <Button x:Name="NexGlowTestButton" Content="测试跑马灯"/>
                                            <Button x:Name="NexMicTestButton" Content="测试麦克风"/>
                                            <Button x:Name="NexSpeechSettingsButton" Content="打开系统语音设置"/>
                                            <Button x:Name="NexSoundSettingsButton" Content="打开声音设置"/>
                                        </StackPanel>
                                    </ui:SettingsExpanderItem.Footer>
                                </ui:SettingsExpanderItem>
                            </ui:SettingsExpander>
                        </StackPanel>

                        
                        <StackPanel x:Name="PageNotification" Spacing="12" IsVisible="False">
                            <ui:InfoBar Message="此处的设置可以在档案设置中被附加设置覆盖。"
                                        IsOpen="True" IsClosable="False"/>

                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
                                <ui:FontIcon FontFamily="avares://ClassNex/Assets/Fonts/#lucide"
                                             Glyph="&#xE059;" FontSize="16" Opacity="0.82"/>
                                <TextBlock Text="提醒规则" FontSize="15" VerticalAlignment="Center"/>
                            </StackPanel>

                            <ui:SettingsExpander Header="在下课前发出准备提醒" IsExpanded="True"
                                                 Description="下课时间还剩指定分钟时，提醒下一节课做好上课准备。">
                                <ui:SettingsExpander.IconSource>
                                    <ui:FontIconSource FontFamily="avares://ClassNex/Assets/Fonts/#lucide" Glyph="&#xE224;"/>
                                </ui:SettingsExpander.IconSource>
                                <ui:SettingsExpander.Footer>
                                    <ToggleSwitch x:Name="PreparingEnabledCheck"/>
                                </ui:SettingsExpander.Footer>
                                <ui:SettingsExpanderItem Content="室内课程下课剩余时间"
                                                         Description="默认在下课时间还剩 3 分钟时提醒下一节室内课程。">
                                    <ui:SettingsExpanderItem.Footer>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <ui:NumberBox x:Name="IndoorPreparingBox" Maximum="60" Minimum="1"
                                                          Width="150" SpinButtonPlacementMode="Inline"/>
                                            <TextBlock Text="分钟" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </ui:SettingsExpanderItem.Footer>
                                </ui:SettingsExpanderItem>
                                <ui:SettingsExpanderItem Content="室外课程课前提醒时间"
                                                         Description="在室外课程的上课前指定时间进行上课提醒。">
                                    <ui:SettingsExpanderItem.Footer>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <ui:NumberBox x:Name="OutdoorPreparingBox" Maximum="3600" Minimum="0"
                                                          Width="150" SpinButtonPlacementMode="Inline"/>
                                            <TextBlock Text="秒" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </ui:SettingsExpanderItem.Footer>
                                </ui:SettingsExpanderItem>
                                <ui:SettingsExpanderItem Content="室内课程准备上课提醒文字">
                                    <ui:SettingsExpanderItem.Footer>
                                        <TextBox x:Name="PreparingText" MinWidth="150"/>
                                    </ui:SettingsExpanderItem.Footer>
                                </ui:SettingsExpanderItem>
                                <ui:SettingsExpanderItem Content="室内课程准备上课遮罩文字">
                                    <ui:SettingsExpanderItem.Footer>
                                        <TextBox x:Name="PreparingMaskText" MinWidth="150"/>
                                    </ui:SettingsExpanderItem.Footer>
                                </ui:SettingsExpanderItem>
                                <ui:SettingsExpanderItem Content="户外课程准备上课提醒文字">
                                    <ui:SettingsExpanderItem.Footer>
                                        <TextBox x:Name="OutdoorPreparingText" MinWidth="150"/>
                                    </ui:SettingsExpanderItem.Footer>
                                </ui:SettingsExpanderItem>
                                <ui:SettingsExpanderItem Content="户外课程准备上课遮罩文字">
                                    <ui:SettingsExpanderItem.Footer>
                                        <TextBox x:Name="OutdoorPreparingMaskText"/>
                                    </ui:SettingsExpanderItem.Footer>
                                </ui:SettingsExpanderItem>
                            </ui:SettingsExpander>

                            <ui:SettingsExpander Header="在上课时发出提醒"
                                                 Description="在上课时发出醒目提醒，提示已经上课。">
                                <ui:SettingsExpander.IconSource>
                                    <ui:FontIconSource FontFamily="avares://ClassNex/Assets/Fonts/#lucide" Glyph="&#xE059;"/>
                                </ui:SettingsExpander.IconSource>
                                <ui:SettingsExpander.Footer>
                                    <ToggleSwitch x:Name="ClassOnEnabledCheck"/>
                                </ui:SettingsExpander.Footer>
                                <ui:SettingsExpanderItem Content="上课遮罩文字">
                                    <ui:SettingsExpanderItem.Footer>
                                        <TextBox x:Name="ClassOnMaskBox" MinWidth="150"/>
                                    </ui:SettingsExpanderItem.Footer>
                                </ui:SettingsExpanderItem>
                            </ui:SettingsExpander>

                            <ui:SettingsExpander Header="在下课时发出提醒"
                                                 Description="在下课时发出醒目提醒，提示已经下课。">
                                <ui:SettingsExpander.IconSource>
                                    <ui:FontIconSource FontFamily="avares://ClassNex/Assets/Fonts/#lucide" Glyph="&#xE05A;"/>
                                </ui:SettingsExpander.IconSource>
                                <ui:SettingsExpander.Footer>
                                    <ToggleSwitch x:Name="ClassOffEnabledCheck"/>
                                </ui:SettingsExpander.Footer>
                                <ui:SettingsExpanderItem Content="下课提醒文字">
                                    <ui:SettingsExpanderItem.Footer>
                                        <TextBox x:Name="ClassOffOverlayBox" MinWidth="150" Watermark="（禁用）"/>
                                    </ui:SettingsExpanderItem.Footer>
                                </ui:SettingsExpanderItem>
                            </ui:SettingsExpander>

                            <ui:SettingsExpander Header="显示科任老师名字"
                                                 Description="在显示课程相关的提醒时同时展示并播报对应科任老师的名字">
                                <ui:SettingsExpander.IconSource>
                                    <ui:FontIconSource FontFamily="avares://ClassNex/Assets/Fonts/#lucide" Glyph="&#xE19F;"/>
                                </ui:SettingsExpander.IconSource>
                                <ui:SettingsExpander.Footer>
                                    <ToggleSwitch x:Name="ShowTeacherCheck"/>
                                </ui:SettingsExpander.Footer>
                            </ui:SettingsExpander>
                        </StackPanel>

                        
                        <StackPanel x:Name="PageGeneral" Spacing="10" IsVisible="False">
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,2">
                                <ui:FontIcon FontFamily="avares://ClassNex/Assets/Fonts/#lucide" Glyph="&#xE29A;" FontSize="16" VerticalAlignment="Center" Opacity="0.85"/>
                                <TextBlock Text="通用行为" FontSize="15" VerticalAlignment="Center"/>
                            </StackPanel>

                            <ui:SettingsExpander Header="开机自启"
                                                 Description="在您的系统启动时自动运行本应用。">
                                <ui:SettingsExpander.IconSource>
                                    
                                    <ui:FontIconSource FontFamily="avares://ClassNex/Assets/Fonts/#lucide" Glyph="&#xE140;"/>
                                </ui:SettingsExpander.IconSource>
                                <ui:SettingsExpander.Footer>
                                    <Border x:Name="StartupToggleHost"><ToggleSwitch/></Border>
                                </ui:SettingsExpander.Footer>
                            </ui:SettingsExpander>

                            <ui:SettingsExpander Header="注册 Url 协议"
                                                 Description="允许第三方应用或网页通过 Url 协议 classnex:// 调用本应用的部分功能。">
                                <ui:SettingsExpander.IconSource>
                                    
                                    <ui:FontIconSource FontFamily="avares://ClassNex/Assets/Fonts/#lucide" Glyph="&#xE102;"/>
                                </ui:SettingsExpander.IconSource>
                                <ui:SettingsExpander.Footer>
                                    <Border x:Name="UrlProtocolToggleHost"><ToggleSwitch/></Border>
                                </ui:SettingsExpander.Footer>
                            </ui:SettingsExpander>

                            <ui:SettingsExpander Header="学期开始时间"
                                                 Description="设置学期首日，该日期将作为多周轮换课表的计算起点和每周的第一天。">
                                <ui:SettingsExpander.IconSource>
                                    
                                    <ui:FontIconSource FontFamily="avares://ClassNex/Assets/Fonts/#lucide" Glyph="&#xE2B9;"/>
                                </ui:SettingsExpander.IconSource>
                                
                                <ui:SettingsExpander.Footer>
                                    <CalendarDatePicker x:Name="SingleWeekStartPicker" Width="120"/>
                                </ui:SettingsExpander.Footer>
                            </ui:SettingsExpander>

                            <ui:SettingsExpander Header="点击托盘图标行为"
                                                 Description="鼠标左键点击本应用托盘图标时进行的操作。无论此设置处于何种选项，鼠标右键点击托盘图标总是会打开主菜单。">
                                <ui:SettingsExpander.IconSource>
                                    
                                    <ui:FontIconSource FontFamily="avares://ClassNex/Assets/Fonts/#lucide" Glyph="&#xE120;"/>
                                </ui:SettingsExpander.IconSource>
                                <ui:SettingsExpander.Footer>
                                    <ComboBox x:Name="TrayBehaviorCombo" HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="显示 / 隐藏主界面"/>
                                        <ComboBoxItem Content="打开应用设置"/>
                                        <ComboBoxItem Content="打开档案编辑器"/>
                                    </ComboBox>
                                </ui:SettingsExpander.Footer>
                            </ui:SettingsExpander>

                            <ui:SettingsExpander Header="教学安全模式"
                                                 Description="启用后，如果应用发生意外崩溃，将自动按照右侧选择的方法处理崩溃，以确保教学不受到影响。如果发生的是不可忽略的异常，应用将自动退出。您可以在日志记录中查看崩溃详情。">
                                <ui:SettingsExpander.IconSource>
                                    
                                    <ui:FontIconSource FontFamily="avares://ClassNex/Assets/Fonts/#lucide" Glyph="&#xE158;"/>
                                </ui:SettingsExpander.IconSource>
                                <ui:SettingsExpander.Footer>
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <ComboBox x:Name="SafeModeCombo" Width="160" SelectedIndex="0">
                                            <ComboBoxItem Content="显示崩溃报告"/>
                                            <ComboBoxItem Content="忽略并继续"/>
                                            <ComboBoxItem Content="重新启动应用"/>
                                        </ComboBox>
                                        <Border x:Name="SafeModeToggleHost" VerticalAlignment="Center"><ToggleSwitch/></Border>
                                    </StackPanel>
                                </ui:SettingsExpander.Footer>
                            </ui:SettingsExpander>

                        </StackPanel>

                        <StackPanel x:Name="PageCentral" IsVisible="False" Spacing="10">

                            <ui:SettingsExpander Header="启用集控"
                                                 Description="从集控中心接收完整的应用设置和课程表，并将本机状态报告给管理员。">
                                <ui:SettingsExpander.IconSource>
                                    <ui:FontIconSource FontFamily="avares://ClassNex/Assets/Fonts/#lucide" Glyph="&#xE0EF;"/>
                                </ui:SettingsExpander.IconSource>
                                <ui:SettingsExpander.Footer>
                                    <Border x:Name="CentralManagementToggleHost"><ToggleSwitch/></Border>
                                </ui:SettingsExpander.Footer>
                            </ui:SettingsExpander>

                            <ui:SettingsExpander Header="集控服务地址"
                                                 Description="例如 https://central.example.com">
                                <ui:SettingsExpander.IconSource>
                                    <ui:FontIconSource FontFamily="avares://ClassNex/Assets/Fonts/#lucide" Glyph="&#xE0D3;"/>
                                </ui:SettingsExpander.IconSource>
                                <ui:SettingsExpander.Footer>
                                    <TextBox x:Name="CentralServerBox" Width="280"
                                             Watermark="https://central.example.com"/>
                                </ui:SettingsExpander.Footer>
                            </ui:SettingsExpander>

                            <ui:SettingsExpander Header="ClassNEX ID"
                                                 Description="集控中心和客户端必须登录同一个 ClassNEX 账户。">
                                <ui:SettingsExpander.IconSource>
                                    <ui:FontIconSource FontFamily="avares://ClassNex/Assets/Fonts/#lucide" Glyph="&#xE13D;"/>
                                </ui:SettingsExpander.IconSource>
                                <ui:SettingsExpander.Footer>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock x:Name="CentralAccountText" VerticalAlignment="Center" MaxWidth="220"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <Button x:Name="CentralAccountLoginButton" Content="登录 ClassNEX ID"/>
                                    </StackPanel>
                                </ui:SettingsExpander.Footer>
                            </ui:SettingsExpander>

                            <ui:SettingsExpander Header="设备身份"
                                                 Description="登录后自动登记本机，由集控端选择设备并分配班级。">
                                <ui:SettingsExpander.IconSource>
                                    <ui:FontIconSource FontFamily="avares://ClassNex/Assets/Fonts/#lucide" Glyph="&#xE1F9;"/>
                                </ui:SettingsExpander.IconSource>
                                <ui:SettingsExpander.Footer>
                                    <TextBlock x:Name="CentralDeviceText" MaxWidth="280"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                </ui:SettingsExpander.Footer>
                            </ui:SettingsExpander>

                            <ui:SettingsExpander Header="同步状态"
                                                 Description="集控保存后自动下发更改。可在这里查看连接状态或手动重连。">
                                <ui:SettingsExpander.IconSource>
                                    <ui:FontIconSource FontFamily="avares://ClassNex/Assets/Fonts/#lucide" Glyph="&#xE154;"/>
                                </ui:SettingsExpander.IconSource>
                                <ui:SettingsExpander.Footer>
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <TextBlock x:Name="CentralStatusText" FontSize="12"
                                                   MaxWidth="250" TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"/>
                                        <Button x:Name="CentralConnectButton" Content="连接集控"/>
                                        <Button x:Name="CentralDisconnectButton" Content="断开"/>
                                    </StackPanel>
                                </ui:SettingsExpander.Footer>
                            </ui:SettingsExpander>

                            
                        </StackPanel>

                        
                        <StackPanel x:Name="PageInterface" Spacing="10" IsVisible="False">
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,2">
                                <ui:FontIcon FontFamily="avares://ClassNex/Assets/Fonts/#lucide" Glyph="&#xE1DD;" FontSize="16" VerticalAlignment="Center" Opacity="0.85"/>
                                <TextBlock Text="显示与缩放" FontSize="15" VerticalAlignment="Center"/>
                            </StackPanel>

                            <ui:SettingsExpander Header="主题" Description="跟随系统 / 浅色 / 深色">
                                <ui:SettingsExpander.IconSource>
                                    <ui:FontIconSource FontFamily="avares://ClassNex/Assets/Fonts/#lucide" Glyph="&#xE178;"/>
                                </ui:SettingsExpander.IconSource>
                                <ui:SettingsExpander.Footer>
                                    
                                    <ComboBox x:Name="ThemeCombo" MinWidth="140">
                                        <ComboBoxItem Content="跟随系统"/>
                                        <ComboBoxItem Content="浅色"/>
                                        <ComboBoxItem Content="深色"/>
                                    </ComboBox>
                                </ui:SettingsExpander.Footer>
                            </ui:SettingsExpander>

                            <ui:SettingsExpander Header="主界面背景不透明度">
                                <ui:SettingsExpander.IconSource>
                                    <ui:FontIconSource FontFamily="avares://ClassNex/Assets/Fonts/#lucide" Glyph="&#xE09D;"/>
                                </ui:SettingsExpander.IconSource>
                                <ui:SettingsExpander.Footer>
                                    <Grid Width="258" ColumnDefinitions="28,*,48,28" ColumnSpacing="6">
                                        <Button Content="−" Classes="stepButton" Padding="0" AutomationProperties.Name="减小不透明度" Click="OnOpacityDecrease"/>
                                        <Slider Grid.Column="1" x:Name="OpacitySlider" Minimum="0.1" Maximum="1"
                                                TickFrequency="0.05" IsSnapToTickEnabled="True"/>
                                        <TextBlock Grid.Column="2" x:Name="OpacityValueText"
                                                   TextAlignment="Right" VerticalAlignment="Center"
                                                   Opacity="0.7"/>
                                        <Button Grid.Column="3" Content="+" Classes="stepButton" Padding="0" AutomationProperties.Name="增大不透明度" Click="OnOpacityIncrease"/>
                                    </Grid>
                                </ui:SettingsExpander.Footer>
                            </ui:SettingsExpander>

                            <ui:SettingsExpander Header="全局字号缩放">
                                <ui:SettingsExpander.IconSource>
                                    <ui:FontIconSource FontFamily="avares://ClassNex/Assets/Fonts/#lucide" Glyph="&#xE198;"/>
                                </ui:SettingsExpander.IconSource>
                                <ui:SettingsExpander.Footer>
                                    <Grid Width="258" ColumnDefinitions="28,*,48,28" ColumnSpacing="6">
                                        <Button Content="−" Classes="stepButton" Padding="0" AutomationProperties.Name="减小字号" Click="OnFontScaleDecrease"/>
                                        <Slider Grid.Column="1" x:Name="FontScaleSlider" Minimum="0.8" Maximum="2.4"
                                                TickFrequency="0.05" IsSnapToTickEnabled="True"/>
                                        <TextBlock Grid.Column="2" x:Name="FontScaleValueText"
                                                   TextAlignment="Right" VerticalAlignment="Center"
                                                   Opacity="0.7"/>
                                        <Button Grid.Column="3" Content="+" Classes="stepButton" Padding="0" AutomationProperties.Name="增大字号" Click="OnFontScaleIncrease"/>
                                    </Grid>
                                </ui:SettingsExpander.Footer>
                            </ui:SettingsExpander>

                            <ui:SettingsExpander Header="主界面缩放"
                                                 Description="整体放大悬浮主界面，默认 1.9 倍">
                                <ui:SettingsExpander.IconSource>
                                    <ui:FontIconSource FontFamily="avares://ClassNex/Assets/Fonts/#lucide" Glyph="&#xE1B6;"/>
                                </ui:SettingsExpander.IconSource>
                                <ui:SettingsExpander.Footer>
                                    <Grid Width="258" ColumnDefinitions="28,*,48,28" ColumnSpacing="6">
                                        <Button Content="−" Classes="stepButton" Padding="0" AutomationProperties.Name="减小浮窗缩放" Click="OnMainScaleDecrease"/>
                                        <Slider Grid.Column="1" x:Name="MainWindowScaleSlider" Minimum="0.5" Maximum="4.0"
                                                TickFrequency="0.05" IsSnapToTickEnabled="True"/>
                                        <TextBlock Grid.Column="2" x:Name="MainWindowScaleValueText"
                                                   TextAlignment="Right" VerticalAlignment="Center"
                                                   Opacity="0.7"/>
                                        <Button Grid.Column="3" Content="+" Classes="stepButton" Padding="0" AutomationProperties.Name="增大浮窗缩放" Click="OnMainScaleIncrease"/>
                                    </Grid>
                                </ui:SettingsExpander.Footer>
                            </ui:SettingsExpander>

                            <ui:SettingsExpander Header="大屏快速预设"
                                                 Description="教室后方观看时可直接放大文字和整体尺寸。">
                                <ui:SettingsExpander.IconSource>
                                    <ui:FontIconSource FontFamily="avares://ClassNex/Assets/Fonts/#lucide" Glyph="&#xE1B6;"/>
                                </ui:SettingsExpander.IconSource>
                                <ui:SettingsExpander.Footer>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="标准" Click="OnScalePresetStandard"/>
                                        <Button Content="教室远距离" Click="OnScalePresetClassroom"/>
                                    </StackPanel>
                                </ui:SettingsExpander.Footer>
                            </ui:SettingsExpander>
                        </StackPanel>

                        
                        <StackPanel x:Name="PageWindow" Spacing="10" IsVisible="False">
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,2">
                                <ui:FontIcon FontFamily="avares://ClassNex/Assets/Fonts/#lucide" Glyph="&#xE426;" FontSize="16" VerticalAlignment="Center" Opacity="0.85"/>
                                <TextBlock Text="布局与交互" FontSize="15" VerticalAlignment="Center"/>
                            </StackPanel>

                            <ui:SettingsExpander Header="组件排列方向">
                                <ui:SettingsExpander.IconSource>
                                    <ui:FontIconSource FontFamily="avares://ClassNex/Assets/Fonts/#lucide" Glyph="&#xE1C6;"/>
                                </ui:SettingsExpander.IconSource>
                                <ui:SettingsExpander.Footer>
                                    <ComboBox x:Name="OrientationCombo" HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="横向"/>
                                        <ComboBoxItem Content="纵向"/>
                                    </ComboBox>
                                </ui:SettingsExpander.Footer>
                            </ui:SettingsExpander>

                            <ui:SettingsExpander Header="鼠标穿透"
                                                 Description="开启后鼠标点击会直接落到主界面后方的窗口；鼠标移入主界面自动淡化">
                                <ui:SettingsExpander.IconSource>
                                    <ui:FontIconSource FontFamily="avares://ClassNex/Assets/Fonts/#lucide" Glyph="&#xE11F;"/>
                                </ui:SettingsExpander.IconSource>
                                <ui:SettingsExpander.Footer>
                                    <ToggleSwitch x:Name="ClickThroughSwitch"/>
                                </ui:SettingsExpander.Footer>
                            </ui:SettingsExpander>
                        </StackPanel>

                        
                        <StackPanel x:Name="PageWidgets" Spacing="10" IsVisible="False">
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,2">
                                <ui:FontIcon FontFamily="avares://ClassNex/Assets/Fonts/#lucide"
                                             Glyph="&#xE0FF;" FontSize="16" Opacity="0.82"/>
                                <TextBlock Text="组件布局" FontSize="15" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="以下组件将显示在主界面上。点击组件库卡片添加；点组件右侧「⋯」上移/下移/删除。"
                                       Opacity="0.65" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,2"/>

                            <Border CornerRadius="6" Padding="4"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <ListBox x:Name="WidgetList" BorderThickness="0" Background="Transparent"
                                         MinHeight="44" SelectionMode="Single">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="2"/>
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <ui:FontIcon FontFamily="avares://ClassNex/Assets/Fonts/#lucide"
                                                             Glyph="{Binding Glyph}" FontSize="14" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                                <Button Content="⋯" Padding="6,0" ToolTip.Tip="更多选项" Click="OnWidgetItemMore">
                                                    <Button.Flyout>
                                                        <MenuFlyout>
                                                            <MenuItem Header="上移" Click="OnWidgetItemMoveUp"/>
                                                            <MenuItem Header="下移" Click="OnWidgetItemMoveDown"/>
                                                            <Separator/>
                                                            <MenuItem Header="删除" Click="OnWidgetItemDelete"/>
                                                        </MenuFlyout>
                                                    </Button.Flyout>
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>

                            <TabControl x:Name="WidgetTabs" HorizontalContentAlignment="Stretch" Padding="0">
                                <TabItem Header="组件库">
                                    <StackPanel x:Name="WidgetLibraryPage" Spacing="10" Margin="0,10,0,0">
                                        <TextBlock Text="内置组件" FontSize="14" Margin="0,4,0,0"/>
                                        <WrapPanel x:Name="WidgetLibraryPanel" Orientation="Horizontal"/>
                                        <Button x:Name="ResetWidgetButton" Content="恢复默认布局"/>
                                    </StackPanel>
                                </TabItem>
                                <TabItem Header="组件设置">
                                    <ScrollViewer Margin="0,10,0,0">
                                        <StackPanel x:Name="WidgetEditor" Spacing="8" IsEnabled="False">
                                            <TextBlock x:Name="WidgetTypeText" FontSize="12" Opacity="0.7" TextWrapping="Wrap"/>

                                            <ui:SettingsExpander Header="启用该组件">
                                                <ui:SettingsExpander.Footer>
                                                    <ToggleSwitch x:Name="WidgetEnabledCheck"/>
                                                </ui:SettingsExpander.Footer>
                                            </ui:SettingsExpander>

                                            <ui:SettingsExpander Header="字号缩放">
                                                <ui:SettingsExpander.Footer>
                                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                                        <Slider x:Name="WidgetFontSlider" Minimum="0.6" Maximum="2.0"
                                                                Width="200" TickFrequency="0.05" IsSnapToTickEnabled="True"/>
                                                        <TextBlock x:Name="WidgetFontValueText" VerticalAlignment="Center" Opacity="0.7"/>
                                                    </StackPanel>
                                                </ui:SettingsExpander.Footer>
                                            </ui:SettingsExpander>

                                            
                                            <StackPanel x:Name="WidgetSettingsPanel" Spacing="8"/>
                                            <TextBlock x:Name="WidgetNoSettingsText"
                                                       Text="该组件没有专属设置。"
                                                       FontSize="12" Opacity="0.7" Margin="4,2,0,0"
                                                       IsVisible="False"/>
                                        </StackPanel>
                                    </ScrollViewer>
                                </TabItem>
                            </TabControl>
                        </StackPanel>

                        
                        <StackPanel x:Name="PageAbout" Spacing="10" IsVisible="False">
                            <ui:SettingsExpander x:Name="AboutExpander" Header="ClassNEX" IsExpanded="True">
                                <ui:SettingsExpander.IconSource>
                                    <ui:ImageIconSource Source="/Assets/icon.ico"/>
                                </ui:SettingsExpander.IconSource>
                                <ui:SettingsExpander.Items>
                                    <StackPanel Spacing="12" Margin="0,4,0,0">
                                        
                                        <TextBlock x:Name="AboutVersionText" FontSize="14"
                                                   PointerPressed="OnVersionPointerPressed"
                                                   ToolTip.Tip="连点 10 次解锁调试菜单"/>
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="Copyright (c) 2026 ClassNEX"/>
                                                <TextBlock Text="本项目基于 GNU General Public License v3.0 获得许可。"
                                                           FontSize="12" Opacity="0.7" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16"
                                                        VerticalAlignment="Center">
                                                <Button Content="开放源代码许可" Click="OnOpenLicense"/>
                                                <Button Content="隐私政策" Click="OnOpenPrivacyPolicy"/>
                                            </StackPanel>
                                        </Grid>
                                        <Separator/>
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="常用链接" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16"
                                                        VerticalAlignment="Center">
                                                <Button Content="项目主页" Click="OnOpenHomePage"/>
                                                <Button Content="GitHub" Click="OnOpenHomePage"/>
                                                <Button Content="反馈问题" Click="OnOpenIssues"/>
                                            </StackPanel>
                                        </Grid>
                                        <Separator/>
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="首次启动向导"/>
                                                <TextBlock Text="预览 OOBE 的翻页动画和步骤提示，不会修改当前设置。"
                                                           FontSize="12" Opacity="0.7" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="预览 OOBE"
                                                    VerticalAlignment="Center" Click="OnPreviewOobe"/>
                                        </Grid>
                                    </StackPanel>
                                </ui:SettingsExpander.Items>
                            </ui:SettingsExpander>
                        </StackPanel>

                        
                        <StackPanel x:Name="PageDebug" Spacing="10" IsVisible="False">
                            <ui:InfoBar Severity="Error" Title="仅供调试"
                                        Message="除非你知道自己在做什么，否则请不要使用下面的按钮。"
                                        IsOpen="True" IsClosable="False"/>
                            <ui:SettingsExpander Header="通知测试" Description="直接触发各类提醒，用于检查效果（不依赖当前课表状态）">
                                <ui:SettingsExpander.IconSource>
                                    <ui:FontIconSource FontFamily="avares://ClassNex/Assets/Fonts/#lucide" Glyph="&#xE059;"/>
                                </ui:SettingsExpander.IconSource>
                                <ui:SettingsExpanderItem x:Name="DebugTriggerTestNotificationItem" Content="拉起测试提醒" IsClickEnabled="True"/>
                                <ui:SettingsExpanderItem x:Name="DebugTriggerClassPreparingItem" Content="触发课前准备提醒" IsClickEnabled="True"/>
                                <ui:SettingsExpanderItem x:Name="DebugTriggerClassOnItem" Content="触发上课提醒" IsClickEnabled="True"/>
                                <ui:SettingsExpanderItem x:Name="DebugTriggerClassOffItem" Content="触发下课提醒" IsClickEnabled="True"/>
                            </ui:SettingsExpander>
                            <ui:SettingsExpander Header="调试菜单">
                                <ui:SettingsExpander.IconSource>
                                    <ui:FontIconSource FontFamily="avares://ClassNex/Assets/Fonts/#lucide" Glyph="&#xE20C;"/>
                                </ui:SettingsExpander.IconSource>
                                <ui:SettingsExpanderItem x:Name="DebugCloseItem" Content="关闭调试菜单（隐藏本页）" IsClickEnabled="True"/>
                            </ui:SettingsExpander>

                            

                        </StackPanel>

                        
                        <StackPanel x:Name="PageSchedule" Spacing="12" IsVisible="False">
                            <TextBlock x:Name="ScheduleSummaryText" Classes="sectionLabel" TextWrapping="Wrap"/>
                            <Border Classes="sectionSurface">
                                <Grid>
                                    <TextBlock x:Name="ScheduleEmptyText" Classes="muted" Text="今天还没有安排课程。可在周课表中添加课程。" TextWrapping="Wrap"/>
                                    <ItemsControl x:Name="ScheduleDayList">
                                        <ItemsControl.ItemTemplate><DataTemplate>
                                            <Grid ColumnDefinitions="116,*,Auto" ColumnSpacing="12" Margin="0,7">
                                                <TextBlock Text="{Binding TimeRange}" Classes="muted" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Subject}" TextWrapping="Wrap"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Detail}" Classes="muted" TextTrimming="CharacterEllipsis" MaxWidth="140"/>
                                            </Grid>
                                        </DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Border>
                            <WrapPanel><Button Classes="sectionLink" Tag="0" Click="OnEditorLink" Content="编辑周课表"/><Button Classes="sectionLink" Tag="1" Click="OnEditorLink" Content="编辑时间表"/><Button Classes="sectionLink" Tag="2" Click="OnEditorLink" Content="管理科目"/><Button Classes="sectionLink" Tag="3" Click="OnEditorLink" Content="临时调课"/></WrapPanel>
                        </StackPanel>
                        <StackPanel x:Name="PageProfile" Spacing="12" IsVisible="False">
                            <Border Classes="sectionSurface"><StackPanel Spacing="8">
                                <TextBlock Text="当前档案" Classes="muted"/>
                                <TextBlock x:Name="ProfileNameText" FontSize="22" TextWrapping="Wrap"/>
                                <TextBlock x:Name="ProfileStatsText" TextWrapping="Wrap"/>
                                <SelectableTextBlock x:Name="ProfilePathText" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel></Border>
                            <WrapPanel>
                                <Button Classes="sectionLink" Tag="-1" Click="OnEditorLink" Content="管理档案"/>
                                <Button Classes="sectionLink" Click="OnOpenTimetable" Content="打开课表文件…"/>
                                <Button Classes="sectionLink" Click="OnOpenDataFolder" Content="打开数据目录"/>
                            </WrapPanel>
                        </StackPanel>
                        <StackPanel x:Name="PagePlugins" Spacing="12" IsVisible="False">
                            <WrapPanel>
                                <Button x:Name="PluginRefreshButton" Classes="sectionLink" Click="OnReloadPlugins" Content="重新扫描"/>
                                <Button Classes="sectionLink" Click="OnOpenPluginsFolder" Content="打开插件目录"/>
                            </WrapPanel>
                            <TextBlock x:Name="PluginStatusText" Classes="muted" TextWrapping="Wrap"/>
                            <StackPanel x:Name="PluginRows" Spacing="6"/>
                        </StackPanel>
                        <StackPanel x:Name="PageAccount" Spacing="12" IsVisible="False">
                            <Border Classes="sectionSurface"><Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                                <Border x:Name="AccountPageAvatarRing" Width="60" Height="60" CornerRadius="30" BorderThickness="1" ClipToBounds="True" VerticalAlignment="Top"/>
                                <StackPanel Grid.Column="1" Spacing="5">
                                    <TextBlock x:Name="AccountPageStatusText" Classes="muted"/>
                                    <TextBlock x:Name="AccountPageNameText" FontSize="22" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="AccountPageEmailText" Classes="muted" TextWrapping="Wrap"/>
                                    <WrapPanel Margin="0,8,0,0">
                                        <Button x:Name="AccountLoginButton" Classes="sectionLink" Content="浏览器登录" Click="OnAccountLogin"/>
                                        <Button x:Name="AccountLogoutButton" Classes="sectionLink" Content="退出登录" Click="OnAccountLogout"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Grid></Border>
                            <TextBlock Text="头像、用户名和邮箱来自账户服务。登录和注册在默认浏览器完成，应用不会接触账户密码。" Classes="muted" TextWrapping="Wrap"/>
                        </StackPanel>

                    </Grid>
                </ScrollViewer>
            </Grid>
        </ui:NavigationView>

        
        <Border x:Name="SearchResultsPanel" Grid.Row="1" IsVisible="False" MaxHeight="300"
                Width="420" HorizontalAlignment="Center" VerticalAlignment="Top"
                Margin="0,4,0,0"
                CornerRadius="8" BorderThickness="1"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Background="{DynamicResource LayerFillColorDefaultBrush}">
            <ListBox x:Name="SearchResults" BorderThickness="0" Background="Transparent">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Spacing="1">
                            <TextBlock Text="{Binding Title}" FontSize="13"/>
                            <TextBlock Text="{Binding PageName}" FontSize="11" Opacity="0.6"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </Grid>
</wd:AppWindow>
