<wd:AppWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="using:AvaloniaFluentUI.Controls"
        xmlns:wd="using:AvaloniaFluentUI.Windowing"
        xmlns:styles="using:ClassNex.Styles"
        xmlns:local="using:ClassNex.Views"
        mc:Ignorable="d" d:DesignWidth="1240" d:DesignHeight="620"
        x:Class="ClassNex.Views.SettingsWindow"
        Title="应用设置"
        Icon="/Assets/icon.ico"
        TitleBarHeight="48"
        IsTitleBarContentVisible="False"
        Width="1240" Height="620"
        MinWidth="520" MinHeight="460"
        Background="Transparent"
        TransparencyBackgroundFallback="{DynamicResource SolidBackgroundFillColorBaseBrush}"
        WindowStartupLocation="CenterScreen">

    
    <wd:AppWindow.Resources>
        <ResourceDictionary>
            <FontFamily x:Key="SettingsSymbolFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
            <x:Double x:Key="NavigationViewItemOnLeftIconBoxHeight">24</x:Double>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="SettingsIconBrush" Color="{x:Static styles:CiPalette.SettingsIconLight}"/>
                    <SolidColorBrush x:Key="SettingsShellBrush" Color="{x:Static styles:CiPalette.SettingsShellLight}"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="SettingsIconBrush" Color="{x:Static styles:CiPalette.SettingsIconDark}"/>
                    <SolidColorBrush x:Key="SettingsShellBrush" Color="{x:Static styles:CiPalette.SettingsShellDark}"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </wd:AppWindow.Resources>
    <wd:AppWindow.Styles>
        <StyleInclude Source="avares://ClassNex/Views/SettingsWindow.SectionStyles.axaml"/>
        <Style Selector="ui|NavigationView.settings-shell /template/ SplitView Border#ContentGridBorder">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.TitleAction">
            <Setter Property="Theme" Value="{StaticResource TransparentButton}"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="wd:AppWindow.AllowInteractionInTitleBar" Value="True"/>
        </Style>
        <Style Selector="Button.widget-tile">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
        </Style>
        <Style Selector="ui|FontIcon.settings-glyph">
            <Setter Property="Foreground" Value="{DynamicResource SettingsIconBrush}"/>
        </Style>
    </wd:AppWindow.Styles>
    <Grid x:Name="SettingsRoot" RowDefinitions="48,*" Background="{DynamicResource SettingsShellBrush}">
        <Grid Grid.Row="0" Margin="8,0,144,0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="2">
                <Button x:Name="BackButton" Classes="TitleAction" IsVisible="False" Click="OnNavigateBack"
                        AutomationProperties.Name="返回上一页" ToolTip.Tip="返回上一页">
                    <ui:FontIcon FontFamily="{StaticResource SettingsSymbolFont}" Glyph="&#xE72B;" FontSize="16"/>
                </Button>
                <Button x:Name="PaneToggle" Classes="TitleAction" Click="OnTogglePane"
                        AutomationProperties.Name="展开或收起导航" ToolTip.Tip="展开或收起导航">
                    <ui:FontIcon FontFamily="{StaticResource SettingsSymbolFont}" Glyph="&#xE700;" FontSize="16"/>
                </Button>
                <Image Source="/Assets/icon.ico" Width="18" Height="18" Margin="6,0" IsHitTestVisible="False"/>
                <TextBlock x:Name="ShellBrandTitle" Text="ClassNEX" FontSize="14" VerticalAlignment="Center" IsHitTestVisible="False"/>
            </StackPanel>
            <Grid x:Name="TitleSearchArea" Grid.Column="1">
                <TextBox x:Name="SearchBox" Watermark="搜索设置、功能…" CornerRadius="4" HorizontalAlignment="Left"
                         Width="{Binding #TitleSearchArea.Bounds.Width}" MaxWidth="320"
                         MinWidth="0" Height="32" Padding="10,2,4,2" VerticalAlignment="Center" VerticalContentAlignment="Center"
                         AutomationProperties.Name="搜索设置" wd:AppWindow.AllowInteractionInTitleBar="True">
                    <TextBox.InnerRightContent>
                        <ui:FontIcon FontFamily="{StaticResource SettingsSymbolFont}" Glyph="&#xE721;" FontSize="14" Margin="4,0,8,0" IsHitTestVisible="False"/>
                    </TextBox.InnerRightContent>
                </TextBox>
                <Popup x:Name="SearchPopup" PlacementTarget="{Binding #SearchBox}" Placement="Bottom" IsLightDismissEnabled="True" VerticalOffset="2">
                    <Border Width="{Binding #SearchBox.Bounds.Width}" MaxHeight="400" Padding="4" CornerRadius="8" BorderThickness="1"
                            Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                        <ListBox x:Name="SearchResults" BorderThickness="0" Background="Transparent" AutomationProperties.Name="搜索结果">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="32,*,Auto" ColumnSpacing="12" Margin="4,3">
                                        <Image Source="{Binding Icon}" Width="24" Height="24" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Spacing="1">
                                            <TextBlock Text="{Binding Title}" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding PageName}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Popup>
            </Grid>
            <StackPanel x:Name="TitleActions" Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Button Classes="TitleAction" Click="OnPreviewOobe" ToolTip.Tip="新手引导" AutomationProperties.Name="新手引导">
                    <ui:FontIcon FontFamily="{StaticResource SettingsSymbolFont}" Glyph="&#xE7BE;" FontSize="14"/>
                </Button>
                <Button x:Name="MoreOptionsButton" Classes="TitleAction" ToolTip.Tip="更多选项" AutomationProperties.Name="更多选项">
                    <ui:FontIcon FontFamily="{StaticResource SettingsSymbolFont}" Glyph="&#xE712;" FontSize="14"/>
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuItem Header="创建快捷方式…">
                                <MenuItem.Icon><ui:FontIcon FontFamily="{StaticResource SettingsSymbolFont}" Glyph="&#xE71B;"/></MenuItem.Icon>
                                <MenuItem Header="创建桌面快捷方式" Click="OnCreateDesktopShortcut">
                                    <MenuItem.Icon><ui:FontIcon FontFamily="{StaticResource SettingsSymbolFont}" Glyph="&#xE7F4;"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="创建开始菜单快捷方式" Click="OnCreateStartMenuShortcut">
                                    <MenuItem.Icon><ui:FontIcon FontFamily="{StaticResource SettingsSymbolFont}" Glyph="&#xE71D;"/></MenuItem.Icon>
                                </MenuItem>
                            </MenuItem>
                            <Separator/>
                            <MenuItem Header="NEX Intelligence…" Click="OnOpenNexChat"/>
                            <MenuItem Header="日志…" Click="OnOpenLogFile">
                                <MenuItem.Icon><ui:FontIcon FontFamily="{StaticResource SettingsSymbolFont}" Glyph="&#xE8A5;"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="导出诊断数据…" Click="OnExportDiagnostics">
                                <MenuItem.Icon><ui:FontIcon FontFamily="{StaticResource SettingsSymbolFont}" Glyph="&#xEDE1;"/></MenuItem.Icon>
                            </MenuItem>
                            <Separator/>
                            <MenuItem Header="打开日志目录…" Click="OnOpenLogsFolder">
                                <MenuItem.Icon><ui:FontIcon FontFamily="{StaticResource SettingsSymbolFont}" Glyph="&#xE838;"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="打开数据目录…" Click="OnOpenDataFolder">
                                <MenuItem.Icon><ui:FontIcon FontFamily="{StaticResource SettingsSymbolFont}" Glyph="&#xE838;"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="打开应用目录…" Click="OnOpenAppFolder">
                                <MenuItem.Icon><ui:FontIcon FontFamily="{StaticResource SettingsSymbolFont}" Glyph="&#xE838;"/></MenuItem.Icon>
                            </MenuItem>
                            <Separator/>
                            <MenuItem Header="重启 ClassNEX" Click="OnRestartApp">
                                <MenuItem.Icon><ui:FontIcon FontFamily="{StaticResource SettingsSymbolFont}" Glyph="&#xE72C;"/></MenuItem.Icon>
                            </MenuItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>
        <ui:NavigationView Grid.Row="1" x:Name="NavView" Classes="settings-shell" Background="Transparent"
                           PaneDisplayMode="Auto" OpenPaneLength="200" CompactPaneLength="48"
                           CompactModeThresholdWidth="0" ExpandedModeThresholdWidth="600"
                           IsBackButtonVisible="False" IsSettingsVisible="False" AlwaysShowHeader="False"
                           IsPaneToggleButtonVisible="False">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Tag="home" Content="主页"/>
                <ui:NavigationViewItem Tag="basic" Content="基本"/>
                <ui:NavigationViewItem Tag="appearance" Content="外观"/>
                <ui:NavigationViewItem Tag="window" Content="窗口"/>
                <ui:NavigationViewItem Tag="widgets" Content="组件"/>
                <ui:NavigationViewItem Tag="nex" Content="NEX Intelligence"/>
                <ui:NavigationViewItem Tag="notification" Content="提醒"/>
                <ui:NavigationViewItem Tag="account" Content="账户"/>
                <ui:NavigationViewItem Tag="about" Content="关于 ClassNEX"/>
                <ui:NavigationViewItem x:Name="DebugNavItem" IsVisible="False" Tag="debug" Content="调试"/>
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Tag="settings" Content="设置"/>
            </ui:NavigationView.FooterMenuItems>
            <ScrollViewer x:Name="PageScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Grid x:Name="PageHeaderHost" ColumnDefinitions="*,Auto" ColumnSpacing="16" Margin="32,24,32,24" IsVisible="False">
                        <TextBlock x:Name="PageTitleText" FontSize="28" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        <ComboBox x:Name="SectionPicker" Grid.Column="1" Width="172" VerticalAlignment="Center" PlaceholderText="跳转到分类" AutomationProperties.Name="跳转到分类"/>
                    </Grid>
                    <Grid x:Name="SettingsIdentity" ColumnDefinitions="72,*" ColumnSpacing="20" Margin="32,0,32,28" IsVisible="False">
                        <Image Source="/Assets/icon.ico" Width="72" Height="72" VerticalAlignment="Center" Stretch="Uniform"/>
                        <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center">
                            <TextBlock Text="ClassNEX" FontSize="18"/>
                            <TextBlock Text="课程表、课堂提醒和桌面组件" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <TextBlock x:Name="VersionText" PointerPressed="OnVersionPointerPressed" ToolTip.Tip="连点 10 次可解锁调试菜单"
                                       FontSize="12" HorizontalAlignment="Left" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <WrapPanel Margin="-10,4,0,0" Orientation="Horizontal">
                                <HyperlinkButton Content="项目主页" Padding="12,4" Click="OnOpenHomePage"/>
                                <HyperlinkButton Content="反馈与建议" Padding="12,4" Click="OnOpenIssues"/>
                            </WrapPanel>
                        </StackPanel>
                    </Grid>
                    <StackPanel x:Name="PageHost" Spacing="28" RenderOptions.TextRenderingMode="Antialias" HorizontalAlignment="Stretch">
                        <Grid x:Name="PageHome" IsVisible="False" RowDefinitions="168,Auto,Auto"
                              SizeChanged="OnDashboardSizeChanged">
                            <Grid.Resources>
                                <ResourceDictionary>
                                    <ResourceDictionary.ThemeDictionaries>
                                        <ResourceDictionary x:Key="Light">
                                            <SolidColorBrush x:Key="HomeHeroSurface" Color="{x:Static styles:CiPalette.DashboardHeroLight}"/>
                                            <SolidColorBrush x:Key="HomeHeroInk" Color="{x:Static styles:CiPalette.DashboardInkLight}"/>
                                            <SolidColorBrush x:Key="HomeFeatureSurface" Color="{x:Static styles:CiPalette.DashboardTileLight}"/>
                                        </ResourceDictionary>
                                        <ResourceDictionary x:Key="Dark">
                                            <SolidColorBrush x:Key="HomeHeroSurface" Color="{x:Static styles:CiPalette.DashboardHeroDark}"/>
                                            <SolidColorBrush x:Key="HomeHeroInk" Color="{x:Static styles:CiPalette.DashboardInkDark}"/>
                                            <SolidColorBrush x:Key="HomeFeatureSurface" Color="{x:Static styles:CiPalette.DashboardTileDark}"/>
                                        </ResourceDictionary>
                                    </ResourceDictionary.ThemeDictionaries>
                                    <DataTemplate x:Key="HomeFeatureTemplate">
                                        <Button Classes="home-feature" Width="{Binding $parent[ItemsControl].Tag}" Click="OnDashboardFeatureClick"
                                                AutomationProperties.Name="{Binding FeatureTitle}" AutomationProperties.HelpText="{Binding FeatureAction}">
                                            <Grid RowDefinitions="*,Auto">
                                                <StackPanel Margin="20,16,20,16" Spacing="6">
                                                    <Grid ColumnDefinitions="28,*" ColumnSpacing="8" Margin="0,0,0,4">
                                                        <Grid Width="28" Height="28" VerticalAlignment="Center">
                                                            <Image Source="{Binding Icon}" IsVisible="{Binding !ShowAvatar}" RenderOptions.BitmapInterpolationMode="HighQuality"/>
                                                            <Border IsVisible="{Binding ShowAvatar}" CornerRadius="14" ClipToBounds="True" Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                                                <Panel>
                                                                    <TextBlock Text="{Binding Initial}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"/>
                                                                    <Image Source="{Binding Avatar}" Stretch="UniformToFill"/>
                                                                </Panel>
                                                            </Border>
                                                        </Grid>
                                                        <TextBlock Classes="home-kicker" Grid.Column="1" Text="{Binding FeatureKicker}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    </Grid>
                                                    <TextBlock Classes="home-state-title" Text="{Binding FeatureTitle}" ToolTip.Tip="{Binding FeatureTitle}"/>
                                                    <TextBlock Classes="home-detail home-card-detail" Text="{Binding FeatureDescription}" MaxLines="3"/>
                                                </StackPanel>
                                                <Border Classes="home-feature-footer" Grid.Row="1" MinHeight="44" Padding="20,0" BorderThickness="0,1,0,0"
                                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding FeatureAction}" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                                        <ui:FontIcon Classes="home-symbol home-chevron" Grid.Column="1" Glyph="&#xE76C;"/>
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                    <DataTemplate x:Key="HomeEntryTemplate">
                                        <Border Classes="home-group-row" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                            <Grid ColumnDefinitions="*,48">
                                                <Button Classes="home-entry" Theme="{StaticResource TransparentButton}" Click="OnDashboardEntryClick"
                                                        AutomationProperties.Name="{Binding Title}" AutomationProperties.HelpText="{Binding Description}">
                                                    <Grid ColumnDefinitions="28,*,Auto" ColumnSpacing="12">
                                                        <Image Source="{Binding Icon}" Width="28" Height="28" VerticalAlignment="Center" RenderOptions.BitmapInterpolationMode="HighQuality"/>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                                            <TextBlock Text="{Binding Title}" FontSize="14" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Classes="home-detail home-card-detail" Text="{Binding Description}" MaxLines="2"/>
                                                        </StackPanel>
                                                        <ui:FontIcon Classes="home-symbol home-chevron" Grid.Column="2" Glyph="&#xE76C;"/>
                                                    </Grid>
                                                </Button>
                                                <Button Classes="home-star" Grid.Column="1" Theme="{StaticResource TransparentButton}" Click="OnDashboardFavoriteClick"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="{Binding FavoriteAction}" ToolTip.Tip="{Binding FavoriteAction}">
                                                    <ui:FontIcon Classes="home-symbol" FontSize="16" Glyph="{Binding FavoriteGlyph}"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                    <DataTemplate x:Key="HomeGroupTemplate">
                                        <Border Classes="home-group" AutomationProperties.Name="{Binding Title}">
                                            <StackPanel>
                                                <StackPanel Margin="20,16,20,16" Spacing="4">
                                                    <TextBlock Text="{Binding Title}" FontSize="20" TextWrapping="Wrap" AutomationProperties.HeadingLevel="2"/>
                                                    <TextBlock Classes="home-detail home-card-detail" Text="{Binding Description}" MaxLines="2"/>
                                                </StackPanel>
                                                <ItemsControl Classes="home-group-entries" ItemsSource="{Binding Entries}" ItemTemplate="{StaticResource HomeEntryTemplate}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ResourceDictionary>
                            </Grid.Resources>
                            <Grid.Styles>
                                <Style Selector="ui|FontIcon.home-symbol">
                                    <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
                                </Style>
                                <Style Selector="ui|FontIcon.home-chevron">
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </Style>
                                <Style Selector="TextBlock.home-kicker">
                                    <Setter Property="FontSize" Value="13"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </Style>
                                <Style Selector="TextBlock.home-state-title">
                                    <Setter Property="FontSize" Value="20"/>
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    <Setter Property="MaxLines" Value="2"/>
                                </Style>
                                <Style Selector="TextBlock.home-detail">
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                </Style>
                                <Style Selector="TextBlock.home-card-detail">
                                    <Setter Property="FontSize" Value="13"/>
                                </Style>
                                <Style Selector="Button.home-feature, Button.home-entry">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                                    <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                    <Setter Property="VerticalAlignment" Value="Stretch"/>
                                </Style>
                                <Style Selector="Button.home-feature">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="MinHeight" Value="180"/>
                                    <Setter Property="CornerRadius" Value="8"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
                                    <Setter Property="Background" Value="{DynamicResource HomeFeatureSurface}"/>
                                </Style>
                                <Style Selector="Border.home-group">
                                    <Setter Property="CornerRadius" Value="8"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
                                    <Setter Property="Background" Value="{DynamicResource HomeFeatureSurface}"/>
                                    <Setter Property="ClipToBounds" Value="True"/>
                                    <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                    <Setter Property="VerticalAlignment" Value="Top"/>
                                </Style>
                                <Style Selector="Button.home-entry">
                                    <Setter Property="MinHeight" Value="64"/>
                                    <Setter Property="Padding" Value="18,9,4,9"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="CornerRadius" Value="0"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                </Style>
                                <Style Selector="Button.home-star">
                                    <Setter Property="Width" Value="36"/>
                                    <Setter Property="Height" Value="36"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                                <Style Selector="RadioButton.home-tab">
                                    <Setter Property="Template">
                                        <ControlTemplate>
                                            <Border Name="Pill" CornerRadius="18" BorderThickness="1" Padding="17,6" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                                                <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter>
                                </Style>
                                <Style Selector="RadioButton.home-tab:pointerover /template/ Border#Pill">
                                    <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                                </Style>
                                <Style Selector="RadioButton.home-tab:checked /template/ Border#Pill">
                                    <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                                </Style>
                                <Style Selector="RadioButton.home-tab:checked">
                                    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                                </Style>
                            </Grid.Styles>
                            <Grid Grid.RowSpan="2" Height="280" VerticalAlignment="Top" IsHitTestVisible="False" ClipToBounds="True" Background="{DynamicResource HomeHeroSurface}">
                                <Grid.OpacityMask>
                                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%"><GradientStop Color="Black" Offset="0.35"/><GradientStop Color="Transparent" Offset="1"/></LinearGradientBrush>
                                </Grid.OpacityMask>
                                <local:SettingsDashboardArt x:Name="DashboardArtwork" HorizontalAlignment="Right" VerticalAlignment="Stretch"/>
                            </Grid>
                            <Grid x:Name="DashboardTitleBar" Margin="36,28,36,24" ColumnDefinitions="*,Auto" ColumnSpacing="16" VerticalAlignment="Top">
                                <StackPanel Spacing="6">
                                    <TextBlock x:Name="HomeGreetingText" FontSize="20" Foreground="{DynamicResource HomeHeroInk}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="ClassNEX" FontSize="40" Foreground="{DynamicResource HomeHeroInk}"/>
                                </StackPanel>
                                <Button x:Name="DashboardEditFeatures" Grid.Column="1" Content="编辑大卡片" VerticalAlignment="Top" Click="OnDashboardEditFeatures"/>
                            </Grid>
                            <Grid x:Name="DashboardFeatureStrip" Grid.Row="1" Margin="0,0,0,12">
                                <ScrollViewer x:Name="DashboardFeatureScroll" Margin="36,0" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                                              ScrollChanged="OnDashboardScrollChanged">
                                    <ItemsControl x:Name="DashboardFeatures" ItemTemplate="{StaticResource HomeFeatureTemplate}">
                                        <ItemsControl.Tag><x:Double>300</x:Double></ItemsControl.Tag>
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="12"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </ScrollViewer>
                                <Button x:Name="DashboardPrevious" Margin="3,0" Width="30" Height="32" Padding="0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                        Click="OnDashboardPrevious" ToolTip.Tip="上一张" AutomationProperties.Name="上一张大卡片">
                                    <ui:FontIcon Classes="home-symbol" Glyph="&#xE76B;" FontSize="12"/>
                                </Button>
                                <Button x:Name="DashboardNext" Margin="3,0" Width="30" Height="32" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Click="OnDashboardNext" ToolTip.Tip="下一张" AutomationProperties.Name="下一张大卡片">
                                    <ui:FontIcon Classes="home-symbol" Glyph="&#xE76C;" FontSize="12"/>
                                </Button>
                            </Grid>
                            <StackPanel Grid.Row="2" x:Name="DashboardLibrary" Margin="36,20,36,28">
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,0,0,20">
                                    <RadioButton x:Name="DashboardAllTab" Classes="home-tab" GroupName="DashboardFilter" IsChecked="True" IsCheckedChanged="OnDashboardFilterChanged">
                                        <StackPanel Orientation="Horizontal" Spacing="8"><ui:FontIcon Classes="home-symbol" Glyph="&#xE8A9;" FontSize="14"/><TextBlock Text="全部设置"/></StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="DashboardFavoritesTab" Classes="home-tab" GroupName="DashboardFilter" IsCheckedChanged="OnDashboardFilterChanged">
                                        <StackPanel Orientation="Horizontal" Spacing="8"><ui:FontIcon Classes="home-symbol" Glyph="&#xE734;" FontSize="14"/><TextBlock Text="收藏"/></StackPanel>
                                    </RadioButton>
                                </StackPanel>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,0,0,12">
                                    <TextBlock x:Name="DashboardCount" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <TextBox x:Name="DashboardQuery" Grid.Column="1" Width="240" Watermark="搜索设置入口" AutomationProperties.Name="搜索主页设置入口" TextChanged="OnDashboardQueryChanged"/>
                                </Grid>
                                <ItemsControl x:Name="DashboardEntries" Tag="1" ItemTemplate="{StaticResource HomeGroupTemplate}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="{Binding $parent[ItemsControl].Tag}" RowSpacing="12" ColumnSpacing="12"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                </ItemsControl>
                                <TextBlock x:Name="DashboardEmpty" Classes="home-detail" IsVisible="False" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Grid>

                        
                        <StackPanel x:Name="PageNex" Classes="settings-section" IsVisible="False">
                            <TextBlock Classes="settings-group-title" Text="NEX Intelligence"/>
                            <ui:InfoBar Severity="Informational" IsOpen="True" IsClosable="False"
                                        Message="NEX 是内置的 AI 助手：能查课表、看应用状态，也能按你选的权限读写文件。对话内容会发送到接口服务商。"/>

                            <WrapPanel Classes="settings-actions" Margin="0,4,0,0">
                                <Button x:Name="NexOpenChatButton" Content="打开 NEX 对话框" Classes="Primary" MinWidth="150"/>
                                <Button x:Name="NexGlowEntryButton" Content="预览跑马灯"/>
                            </WrapPanel>

                            <TextBlock Classes="settings-group-title subsequent" Text="助手设置"/>

                            <ui:SettingsExpander Header="接口"
                                                 Description="应用已内置可用的接口，开箱即可对话，无需配置。想换成你自己的接口/密钥，请到「调试」页设置（版本号连点 10 次解锁）。">
                                <ui:SettingsExpander.IconSource>
                                    <ui:FontIconSource FontFamily="{StaticResource SettingsSymbolFont}" Glyph="&#xE703;" Foreground="{DynamicResource SettingsIconBrush}" FontSize="18"/>
                                </ui:SettingsExpander.IconSource>
                                <ui:SettingsExpanderItem x:Name="NexApiStateItem" Content="当前接口" Description="正在使用内置接口">
                                    <ui:SettingsExpanderItem.Footer>
                                        <TextBlock x:Name="NexApiStateText" VerticalAlignment="Center" FontSize="13"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </ui:SettingsExpanderItem.Footer>
                                </ui:SettingsExpanderItem>
                            </ui:SettingsExpander>

                            <ui:SettingsExpander Header="默认权限"
                                                 Description="打开对话框时的默认档位（对话框顶部随时可改）。仅可查看=只读；工作区内修改=可改应用数据目录里的文件；完全权限=任意路径 + 执行命令。">
                                <ui:SettingsExpander.IconSource>
                                    <ui:FontIconSource FontFamily="{StaticResource SettingsSymbolFont}" Glyph="&#xE8D7;" Foreground="{DynamicResource SettingsIconBrush}" FontSize="18"/>
                                </ui:SettingsExpander.IconSource>
                                <ui:SettingsExpander.Footer>
                                    <ComboBox x:Name="NexPermissionCombo" Width="180">
                                        <ComboBoxItem Content="仅可查看"/>
                                        <ComboBoxItem Content="工作区内修改"/>
                                        <ComboBoxItem Content="完全权限"/>
                                    </ComboBox>
                                </ui:SettingsExpander.Footer>
                            </ui:SettingsExpander>

                            <ui:SettingsExpander Header="系统提示词"
                                                 Description="可选。留空用内置提示词（会带上应用状态、工作区与当前权限说明）。">
                                <ui:SettingsExpander.IconSource>
                                    <ui:FontIconSource FontFamily="{StaticResource SettingsSymbolFont}" Glyph="&#xE70F;" Foreground="{DynamicResource SettingsIconBrush}" FontSize="18"/>
                                </ui:SettingsExpander.IconSource>
                                <ui:SettingsExpanderItem Content="自定义提示词">
                                    <ui:SettingsExpanderItem.Footer>
                                        <TextBox x:Name="NexSystemPromptBox" Classes="settings-wide-field" AcceptsReturn="True"
                                                 MinHeight="64" MaxHeight="140" TextWrapping="Wrap"
                                                 Watermark="留空使用内置提示词"/>
                                    </ui:SettingsExpanderItem.Footer>
                                </ui:SettingsExpanderItem>
                            </ui:SettingsExpander>

                            <ui:SettingsExpander Header="语音唤醒"
                                                 Description="对着麦克风说「嘿 NEX」或「NEX」即可唤醒：响起提示音、屏幕四周亮起跑马灯，浮窗课表向上翻页变成对话。">
                                <ui:SettingsExpander.IconSource>
                                    <ui:FontIconSource FontFamily="{StaticResource SettingsSymbolFont}" Glyph="&#xE720;" Foreground="{DynamicResource SettingsIconBrush}" FontSize="18"/>
                                </ui:SettingsExpander.IconSource>
                                <ui:SettingsExpander.Footer>
                                    <ToggleSwitch x:Name="NexVoiceWakeCheck"/>
                                </ui:SettingsExpander.Footer>
                                <ui:SettingsExpanderItem Content="唤醒条" Description="屏幕左右侧贴一条半透明小白条，点一下等于喊「嘿 NEX」">
                                    <ui:SettingsExpanderItem.Footer>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <ToggleSwitch x:Name="NexEdgeBarCheck"/>
                                            <ComboBox x:Name="NexEdgeBarSideCombo" Width="110">
                                                <ComboBoxItem Content="右侧"/>
                                                <ComboBoxItem Content="左侧"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </ui:SettingsExpanderItem.Footer>
                                </ui:SettingsExpanderItem>
                                <ui:SettingsExpanderItem Content="状态" Description="识别在本机离线进行，不上传麦克风音频">
                                    <ui:SettingsExpanderItem.Footer>
                                        <TextBlock x:Name="NexVoiceStatusText" Classes="settings-caption" MaxWidth="248"/>
                                    </ui:SettingsExpanderItem.Footer>
                                </ui:SettingsExpanderItem>
                                <ui:SettingsExpanderItem Content="检查语音唤醒">
                                    <ui:SettingsExpanderItem.Footer>
                                        <WrapPanel Classes="settings-actions">
                                            <Button x:Name="NexGlowTestButton" Content="测试跑马灯"/>
                                            <Button x:Name="NexMicTestButton" Content="测试麦克风"/>
                                        </WrapPanel>
                                    </ui:SettingsExpanderItem.Footer>
                                </ui:SettingsExpanderItem>
                                <ui:SettingsExpanderItem Content="Windows 设置">
                                    <ui:SettingsExpanderItem.Footer>
                                        <WrapPanel Classes="settings-actions">
                                            <Button x:Name="NexSpeechSettingsButton" Content="打开系统语音设置"/>
                                            <Button x:Name="NexSoundSettingsButton" Content="打开声音设置"/>
                                        </WrapPanel>
                                    </ui:SettingsExpanderItem.Footer>
                                </ui:SettingsExpanderItem>
                            </ui:SettingsExpander>
                        </StackPanel>

                        
                        <StackPanel x:Name="PageNotification" Classes="settings-section" IsVisible="False">
                            <TextBlock Classes="settings-group-title" Text="课堂提醒"/>
                            <ui:InfoBar Message="此处的设置可以在档案设置中被附加设置覆盖。"
                                        IsOpen="True" IsClosable="False"/>

                            <ui:SettingsExpander Header="在下课前发出准备提醒" IsExpanded="True"
                                                 Description="下课时间还剩指定分钟时，提醒下一节课做好上课准备。">
                                <ui:SettingsExpander.IconSource>
                                    <ui:FontIconSource FontFamily="{StaticResource SettingsSymbolFont}" Glyph="&#xE916;" Foreground="{DynamicResource SettingsIconBrush}" FontSize="18"/>
                                </ui:SettingsExpander.IconSource>
                                <ui:SettingsExpander.Footer>
                                    <ToggleSwitch x:Name="PreparingEnabledCheck"/>
                                </ui:SettingsExpander.Footer>
                                <ui:SettingsExpanderItem Content="室内课程下课剩余时间"
                                                         Description="默认在下课时间还剩 3 分钟时提醒下一节室内课程。">
                                    <ui:SettingsExpanderItem.Footer>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <ui:NumberBox x:Name="IndoorPreparingBox" Maximum="60" Minimum="1"
                                                          Width="150" SpinButtonPlacementMode="Inline"/>
                                            <TextBlock Text="分钟" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </ui:SettingsExpanderItem.Footer>
                                </ui:SettingsExpanderItem>
                                <ui:SettingsExpanderItem Content="室外课程课前提醒时间"
                                                         Description="在室外课程的上课前指定时间进行上课提醒。">
                                    <ui:SettingsExpanderItem.Footer>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <ui:NumberBox x:Name="OutdoorPreparingBox" Maximum="3600" Minimum="0"
                                                          Width="150" SpinButtonPlacementMode="Inline"/>
                                            <TextBlock Text="秒" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </ui:SettingsExpanderItem.Footer>
                                </ui:SettingsExpanderItem>
                                <ui:SettingsExpanderItem Content="室内课程准备上课提醒文字">
                                    <ui:SettingsExpanderItem.Footer>
                                        <TextBox x:Name="PreparingText" MinWidth="150"/>
                                    </ui:SettingsExpanderItem.Footer>
                                </ui:SettingsExpanderItem>
                                <ui:SettingsExpanderItem Content="室内课程准备上课遮罩文字">
                                    <ui:SettingsExpanderItem.Footer>
                                        <TextBox x:Name="PreparingMaskText" MinWidth="150"/>
                                    </ui:SettingsExpanderItem.Footer>
                                </ui:SettingsExpanderItem>
                                <ui:SettingsExpanderItem Content="户外课程准备上课提醒文字">
                                    <ui:SettingsExpanderItem.Footer>
                                        <TextBox x:Name="OutdoorPreparingText" MinWidth="150"/>
                                    </ui:SettingsExpanderItem.Footer>
                                </ui:SettingsExpanderItem>
                                <ui:SettingsExpanderItem Content="户外课程准备上课遮罩文字">
                                    <ui:SettingsExpanderItem.Footer>
                                        <TextBox x:Name="OutdoorPreparingMaskText"/>
                                    </ui:SettingsExpanderItem.Footer>
                                </ui:SettingsExpanderItem>
                            </ui:SettingsExpander>

                            <ui:SettingsExpander Header="在上课时发出提醒"
                                                 Description="在上课时发出醒目提醒，提示已经上课。">
                                <ui:SettingsExpander.IconSource>
                                    <ui:FontIconSource FontFamily="{StaticResource SettingsSymbolFont}" Glyph="&#xEA8F;" Foreground="{DynamicResource SettingsIconBrush}" FontSize="18"/>
                                </ui:SettingsExpander.IconSource>
                                <ui:SettingsExpander.Footer>
                                    <ToggleSwitch x:Name="ClassOnEnabledCheck"/>
                                </ui:SettingsExpander.Footer>
                                <ui:SettingsExpanderItem Content="上课遮罩文字">
                                    <ui:SettingsExpanderItem.Footer>
                                        <TextBox x:Name="ClassOnMaskBox" MinWidth="150"/>
                                    </ui:SettingsExpanderItem.Footer>
                                </ui:SettingsExpanderItem>
                            </ui:SettingsExpander>

                            <ui:SettingsExpander Header="在下课时发出提醒"
                                                 Description="在下课时发出醒目提醒，提示已经下课。">
                                <ui:SettingsExpander.IconSource>
                                    <ui:FontIconSource FontFamily="{StaticResource SettingsSymbolFont}" Glyph="&#xE7ED;" Foreground="{DynamicResource SettingsIconBrush}" FontSize="18"/>
                                </ui:SettingsExpander.IconSource>
                                <ui:SettingsExpander.Footer>
                                    <ToggleSwitch x:Name="ClassOffEnabledCheck"/>
                                </ui:SettingsExpander.Footer>
                                <ui:SettingsExpanderItem Content="下课提醒文字">
                                    <ui:SettingsExpanderItem.Footer>
                                        <TextBox x:Name="ClassOffOverlayBox" MinWidth="150" Watermark="（禁用）"/>
                                    </ui:SettingsExpanderItem.Footer>
                                </ui:SettingsExpanderItem>
                            </ui:SettingsExpander>

                            <ui:SettingsExpander Header="显示科任老师名字"
                                                 Description="在课程提醒中同时显示对应科任老师的名字。">
                                <ui:SettingsExpander.IconSource>
                                    <ui:FontIconSource FontFamily="{StaticResource SettingsSymbolFont}" Glyph="&#xE77B;" Foreground="{DynamicResource SettingsIconBrush}" FontSize="18"/>
                                </ui:SettingsExpander.IconSource>
                                <ui:SettingsExpander.Footer>
                                    <ToggleSwitch x:Name="ShowTeacherCheck"/>
                                </ui:SettingsExpander.Footer>
                            </ui:SettingsExpander>
                        </StackPanel>

                        
                        <StackPanel x:Name="PageGeneral" Classes="settings-section" IsVisible="False">
                            <TextBlock Classes="settings-group-title" Text="启动和行为"/>

                            <ui:SettingsExpander Header="开机自启"
                                                 Description="在您的系统启动时自动运行本应用。">
                                <ui:SettingsExpander.IconSource>
                                    
                                    <ui:FontIconSource FontFamily="{StaticResource SettingsSymbolFont}" Glyph="&#xE7E8;" Foreground="{DynamicResource SettingsIconBrush}" FontSize="18"/>
                                </ui:SettingsExpander.IconSource>
                                <ui:SettingsExpander.Footer>
                                    <Border x:Name="StartupToggleHost"><ToggleSwitch/></Border>
                                </ui:SettingsExpander.Footer>
                            </ui:SettingsExpander>

                            <ui:SettingsExpander Header="注册 Url 协议"
                                                 Description="允许第三方应用或网页通过 Url 协议 classnex:// 调用本应用的部分功能。">
                                <ui:SettingsExpander.IconSource>
                                    
                                    <ui:FontIconSource FontFamily="{StaticResource SettingsSymbolFont}" Glyph="&#xE71B;" Foreground="{DynamicResource SettingsIconBrush}" FontSize="18"/>
                                </ui:SettingsExpander.IconSource>
                                <ui:SettingsExpander.Footer>
                                    <Border x:Name="UrlProtocolToggleHost"><ToggleSwitch/></Border>
                                </ui:SettingsExpander.Footer>
                            </ui:SettingsExpander>

                            <ui:SettingsExpander Header="学期开始时间"
                                                 Description="设置学期首日，该日期将作为多周轮换课表的计算起点和每周的第一天。">
                                <ui:SettingsExpander.IconSource>
                                    
                                    <ui:FontIconSource FontFamily="{StaticResource SettingsSymbolFont}" Glyph="&#xE787;" Foreground="{DynamicResource SettingsIconBrush}" FontSize="18"/>
                                </ui:SettingsExpander.IconSource>
                                
                                <ui:SettingsExpander.Footer>
                                    <CalendarDatePicker x:Name="SingleWeekStartPicker" Width="120"/>
                                </ui:SettingsExpander.Footer>
                            </ui:SettingsExpander>

                            <ui:SettingsExpander Header="点击托盘图标行为"
                                                 Description="鼠标左键点击本应用托盘图标时进行的操作。无论此设置处于何种选项，鼠标右键点击托盘图标总是会打开主菜单。">
                                <ui:SettingsExpander.IconSource>
                                    
                                    <ui:FontIconSource FontFamily="{StaticResource SettingsSymbolFont}" Glyph="&#xE962;" Foreground="{DynamicResource SettingsIconBrush}" FontSize="18"/>
                                </ui:SettingsExpander.IconSource>
                                <ui:SettingsExpander.Footer>
                                    <ComboBox x:Name="TrayBehaviorCombo" HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="显示 / 隐藏主界面"/>
                                        <ComboBoxItem Content="打开应用设置"/>
                                        <ComboBoxItem Content="打开档案编辑器"/>
                                    </ComboBox>
                                </ui:SettingsExpander.Footer>
                            </ui:SettingsExpander>

                            <ui:SettingsExpander Header="教学安全模式"
                                                 Description="启用后，如果应用发生意外崩溃，将自动按照右侧选择的方法处理崩溃，以确保教学不受到影响。如果发生的是不可忽略的异常，应用将自动退出。您可以在日志记录中查看崩溃详情。">
                                <ui:SettingsExpander.IconSource>
                                    
                                    <ui:FontIconSource FontFamily="{StaticResource SettingsSymbolFont}" Glyph="&#xEA18;" Foreground="{DynamicResource SettingsIconBrush}" FontSize="18"/>
                                </ui:SettingsExpander.IconSource>
                                <ui:SettingsExpander.Footer>
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <ComboBox x:Name="SafeModeCombo" Width="160" SelectedIndex="0">
                                            <ComboBoxItem Content="显示崩溃报告"/>
                                            <ComboBoxItem Content="忽略并继续"/>
                                            <ComboBoxItem Content="重新启动应用"/>
                                        </ComboBox>
                                        <Border x:Name="SafeModeToggleHost" VerticalAlignment="Center"><ToggleSwitch/></Border>
                                    </StackPanel>
                                </ui:SettingsExpander.Footer>
                            </ui:SettingsExpander>

                            <TextBlock Classes="settings-group-title subsequent" Text="集中管理"/>

                            <ui:SettingsExpander Header="启用集控"
                                                 Description="从集控中心接收完整的应用设置和课程表，并将本机状态报告给管理员。">
                                <ui:SettingsExpander.IconSource>
                                    <ui:FontIconSource FontFamily="{StaticResource SettingsSymbolFont}" Glyph="&#xE968;" Foreground="{DynamicResource SettingsIconBrush}" FontSize="18"/>
                                </ui:SettingsExpander.IconSource>
                                <ui:SettingsExpander.Footer>
                                    <Border x:Name="CentralManagementToggleHost"><ToggleSwitch/></Border>
                                </ui:SettingsExpander.Footer>
                            </ui:SettingsExpander>

                            <ui:SettingsExpander Header="集控服务地址"
                                                 Description="例如 https://central.example.com">
                                <ui:SettingsExpander.IconSource>
                                    <ui:FontIconSource FontFamily="{StaticResource SettingsSymbolFont}" Glyph="&#xE774;" Foreground="{DynamicResource SettingsIconBrush}" FontSize="18"/>
                                </ui:SettingsExpander.IconSource>
                                <ui:SettingsExpander.Footer>
                                    <TextBox x:Name="CentralServerBox" Width="280"
                                             Watermark="https://central.example.com"/>
                                </ui:SettingsExpander.Footer>
                            </ui:SettingsExpander>

                            <ui:SettingsExpander Header="ClassNEX ID"
                                                 Description="集控中心和客户端必须登录同一个 ClassNEX 账户。">
                                <ui:SettingsExpander.IconSource>
                                    <ui:FontIconSource FontFamily="{StaticResource SettingsSymbolFont}" Glyph="&#xE77B;" Foreground="{DynamicResource SettingsIconBrush}" FontSize="18"/>
                                </ui:SettingsExpander.IconSource>
                                <ui:SettingsExpander.Footer>
                                    <WrapPanel Classes="settings-actions">
                                        <TextBlock x:Name="CentralAccountText" VerticalAlignment="Center" MaxWidth="188"
                                                   ToolTip.Tip="{Binding Text, RelativeSource={RelativeSource Self}}" TextTrimming="CharacterEllipsis"/>
                                        <Button x:Name="CentralAccountLoginButton" Content="登录 ClassNEX ID"/>
                                    </WrapPanel>
                                </ui:SettingsExpander.Footer>
                            </ui:SettingsExpander>

                            <ui:SettingsExpander Header="设备身份"
                                                 Description="登录后自动登记本机，由集控端选择设备并分配班级。">
                                <ui:SettingsExpander.IconSource>
                                    <ui:FontIconSource FontFamily="{StaticResource SettingsSymbolFont}" Glyph="&#xE772;" Foreground="{DynamicResource SettingsIconBrush}" FontSize="18"/>
                                </ui:SettingsExpander.IconSource>
                                <ui:SettingsExpander.Footer>
                                    <TextBlock x:Name="CentralDeviceText" MaxWidth="248" ToolTip.Tip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                </ui:SettingsExpander.Footer>
                            </ui:SettingsExpander>

                            <ui:SettingsExpander Header="同步状态"
                                                 Description="客户端在后台每 2 秒检查一次新版本，集控端保存后会自动应用。">
                                <ui:SettingsExpander.IconSource>
                                    <ui:FontIconSource FontFamily="{StaticResource SettingsSymbolFont}" Glyph="&#xE895;" Foreground="{DynamicResource SettingsIconBrush}" FontSize="18"/>
                                </ui:SettingsExpander.IconSource>
                                <ui:SettingsExpander.Footer>
                                    <WrapPanel Classes="settings-actions">
                                        <TextBlock x:Name="CentralStatusText" Classes="settings-caption" MaxWidth="160"
                                                   VerticalAlignment="Center"/>
                                        <Button x:Name="CentralConnectButton" Content="连接集控"/>
                                        <Button x:Name="CentralDisconnectButton" Content="断开"/>
                                    </WrapPanel>
                                </ui:SettingsExpander.Footer>
                            </ui:SettingsExpander>

                            
                        </StackPanel>

                        
                        <StackPanel x:Name="PageInterface" Classes="settings-section" IsVisible="False">
                            <TextBlock Classes="settings-group-title" Text="外观和缩放"/>

                            <ui:SettingsExpander Header="主题" Description="跟随系统 / 浅色 / 深色">
                                <ui:SettingsExpander.IconSource>
                                    <ui:FontIconSource FontFamily="{StaticResource SettingsSymbolFont}" Glyph="&#xE790;" Foreground="{DynamicResource SettingsIconBrush}" FontSize="18"/>
                                </ui:SettingsExpander.IconSource>
                                <ui:SettingsExpander.Footer>
                                    
                                    <ComboBox x:Name="ThemeCombo" MinWidth="140">
                                        <ComboBoxItem Content="跟随系统"/>
                                        <ComboBoxItem Content="浅色"/>
                                        <ComboBoxItem Content="深色"/>
                                    </ComboBox>
                                </ui:SettingsExpander.Footer>
                            </ui:SettingsExpander>

                            <ui:SettingsExpander Header="主界面背景不透明度">
                                <ui:SettingsExpander.IconSource>
                                    <ui:FontIconSource FontFamily="{StaticResource SettingsSymbolFont}" Glyph="&#xE706;" Foreground="{DynamicResource SettingsIconBrush}" FontSize="18"/>
                                </ui:SettingsExpander.IconSource>
                                <ui:SettingsExpander.Footer>
                                    <Grid Classes="settings-slider" ColumnDefinitions="32,*,56,32">
                                        <Button Content="−" Padding="0" Click="OnOpacityDecrease" AutomationProperties.Name="降低背景不透明度"/>
                                        <Slider Grid.Column="1" x:Name="OpacitySlider" Minimum="0.1" Maximum="1"
                                                TickFrequency="0.05" IsSnapToTickEnabled="True"/>
                                        <TextBlock Grid.Column="2" x:Name="OpacityValueText"
                                                   TextAlignment="Right" VerticalAlignment="Center"
                                                   Opacity="0.7"/>
                                        <Button Grid.Column="3" Content="+" Padding="0" Click="OnOpacityIncrease" AutomationProperties.Name="提高背景不透明度"/>
                                    </Grid>
                                </ui:SettingsExpander.Footer>
                            </ui:SettingsExpander>

                            <ui:SettingsExpander Header="全局字号缩放">
                                <ui:SettingsExpander.IconSource>
                                    <ui:FontIconSource FontFamily="{StaticResource SettingsSymbolFont}" Glyph="&#xE8E9;" Foreground="{DynamicResource SettingsIconBrush}" FontSize="18"/>
                                </ui:SettingsExpander.IconSource>
                                <ui:SettingsExpander.Footer>
                                    <Grid Classes="settings-slider" ColumnDefinitions="32,*,56,32">
                                        <Button Content="−" Padding="0" Click="OnFontScaleDecrease" AutomationProperties.Name="减小字号"/>
                                        <Slider Grid.Column="1" x:Name="FontScaleSlider" Minimum="0.8" Maximum="2.4"
                                                TickFrequency="0.05" IsSnapToTickEnabled="True"/>
                                        <TextBlock Grid.Column="2" x:Name="FontScaleValueText"
                                                   TextAlignment="Right" VerticalAlignment="Center"
                                                   Opacity="0.7"/>
                                        <Button Grid.Column="3" Content="+" Padding="0" Click="OnFontScaleIncrease" AutomationProperties.Name="增大字号"/>
                                    </Grid>
                                </ui:SettingsExpander.Footer>
                            </ui:SettingsExpander>

                            <ui:SettingsExpander Header="主界面缩放"
                                                 Description="整体放大悬浮主界面，默认 1.9 倍">
                                <ui:SettingsExpander.IconSource>
                                    <ui:FontIconSource FontFamily="{StaticResource SettingsSymbolFont}" Glyph="&#xE8A3;" Foreground="{DynamicResource SettingsIconBrush}" FontSize="18"/>
                                </ui:SettingsExpander.IconSource>
                                <ui:SettingsExpander.Footer>
                                    <Grid Classes="settings-slider" ColumnDefinitions="32,*,56,32">
                                        <Button Content="−" Padding="0" Click="OnMainScaleDecrease" AutomationProperties.Name="缩小主界面"/>
                                        <Slider Grid.Column="1" x:Name="MainWindowScaleSlider" Minimum="0.5" Maximum="4.0"
                                                TickFrequency="0.05" IsSnapToTickEnabled="True"/>
                                        <TextBlock Grid.Column="2" x:Name="MainWindowScaleValueText"
                                                   TextAlignment="Right" VerticalAlignment="Center"
                                                   Opacity="0.7"/>
                                        <Button Grid.Column="3" Content="+" Padding="0" Click="OnMainScaleIncrease" AutomationProperties.Name="放大主界面"/>
                                    </Grid>
                                </ui:SettingsExpander.Footer>
                            </ui:SettingsExpander>

                            <ui:SettingsExpander Header="标准缩放"
                                                 Description="将字号和主界面缩放恢复为标准大小。">
                                <ui:SettingsExpander.IconSource>
                                    <ui:FontIconSource FontFamily="{StaticResource SettingsSymbolFont}" Glyph="&#xE8A3;" Foreground="{DynamicResource SettingsIconBrush}" FontSize="18"/>
                                </ui:SettingsExpander.IconSource>
                                <ui:SettingsExpander.Footer>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="标准" Click="OnScalePresetStandard"/>
                                    </StackPanel>
                                </ui:SettingsExpander.Footer>
                            </ui:SettingsExpander>
                        </StackPanel>

                        
                        <StackPanel x:Name="PageWindow" Classes="settings-section" IsVisible="False">
                            <TextBlock Classes="settings-group-title" Text="窗口和布局"/>

                            <ui:SettingsExpander Header="组件排列方向">
                                <ui:SettingsExpander.IconSource>
                                    <ui:FontIconSource FontFamily="{StaticResource SettingsSymbolFont}" Glyph="&#xE8AB;" Foreground="{DynamicResource SettingsIconBrush}" FontSize="18"/>
                                </ui:SettingsExpander.IconSource>
                                <ui:SettingsExpander.Footer>
                                    <ComboBox x:Name="OrientationCombo" HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="横向"/>
                                        <ComboBoxItem Content="纵向"/>
                                    </ComboBox>
                                </ui:SettingsExpander.Footer>
                            </ui:SettingsExpander>

                            <ui:SettingsExpander Header="鼠标穿透"
                                                 Description="开启后鼠标点击会直接落到主界面后方的窗口；鼠标移入主界面自动淡化">
                                <ui:SettingsExpander.IconSource>
                                    <ui:FontIconSource FontFamily="{StaticResource SettingsSymbolFont}" Glyph="&#xE962;" Foreground="{DynamicResource SettingsIconBrush}" FontSize="18"/>
                                </ui:SettingsExpander.IconSource>
                                <ui:SettingsExpander.Footer>
                                    <ToggleSwitch x:Name="ClickThroughSwitch"/>
                                </ui:SettingsExpander.Footer>
                            </ui:SettingsExpander>
                        </StackPanel>

                        
                        <StackPanel x:Name="PageWidgets" Classes="settings-section" IsVisible="False">
                            <TextBlock Classes="settings-group-title" Text="主界面组件"/>
                            <TextBlock Text="以下组件将显示在主界面上。点击组件库卡片添加；点组件右侧「⋯」上移/下移/删除。"
                                       Classes="settings-caption" Margin="0,0,0,6"/>

                            <Border CornerRadius="8" Padding="8"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <ListBox x:Name="WidgetList" BorderThickness="0" Background="Transparent"
                                         MinHeight="44" SelectionMode="Single">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="2"/>
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <ui:FontIcon FontFamily="{StaticResource SettingsSymbolFont}" Classes="settings-glyph"
                                                             Glyph="{Binding Glyph}" FontSize="14" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                                <Button Content="⋯" Padding="6,0" ToolTip.Tip="更多选项" Click="OnWidgetItemMore">
                                                    <Button.Flyout>
                                                        <MenuFlyout>
                                                            <MenuItem Header="上移" Click="OnWidgetItemMoveUp"/>
                                                            <MenuItem Header="下移" Click="OnWidgetItemMoveDown"/>
                                                            <Separator/>
                                                            <MenuItem Header="删除" Click="OnWidgetItemDelete"/>
                                                        </MenuFlyout>
                                                    </Button.Flyout>
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>

                            <TabControl x:Name="WidgetTabs" HorizontalContentAlignment="Stretch" Padding="0">
                                <TabItem Header="组件库">
                                    <StackPanel x:Name="WidgetLibraryPage" Spacing="10" Margin="0,10,0,0">
                                        <TextBlock Text="内置组件" FontSize="14" Margin="0,4,0,0"/>
                                        <WrapPanel x:Name="WidgetLibraryPanel" Orientation="Horizontal"/>
                                        <Button x:Name="ResetWidgetButton" Content="恢复默认布局"/>
                                    </StackPanel>
                                </TabItem>
                                <TabItem Header="组件设置">
                                    <StackPanel x:Name="WidgetEditor" Spacing="4" IsEnabled="False" Margin="0,10,0,0">
                                        <TextBlock x:Name="WidgetTypeText" Classes="settings-caption"/>
                                        <ui:SettingsExpander Header="启用该组件">
                                            <ui:SettingsExpander.IconSource>
                                                <ui:FontIconSource FontFamily="{StaticResource SettingsSymbolFont}" Glyph="&#xE8A9;" Foreground="{DynamicResource SettingsIconBrush}"/>
                                            </ui:SettingsExpander.IconSource>
                                            <ui:SettingsExpander.Footer>
                                                <ToggleSwitch x:Name="WidgetEnabledCheck"/>
                                            </ui:SettingsExpander.Footer>
                                        </ui:SettingsExpander>
                                        <ui:SettingsExpander Header="字号缩放">
                                            <ui:SettingsExpander.IconSource>
                                                <ui:FontIconSource FontFamily="{StaticResource SettingsSymbolFont}" Glyph="&#xE8D3;" Foreground="{DynamicResource SettingsIconBrush}"/>
                                            </ui:SettingsExpander.IconSource>
                                            <ui:SettingsExpander.Footer>
                                                <StackPanel Orientation="Horizontal" Spacing="12">
                                                    <Slider x:Name="WidgetFontSlider" Minimum="0.6" Maximum="2.0"
                                                            Width="180" TickFrequency="0.05" IsSnapToTickEnabled="True"/>
                                                    <TextBlock x:Name="WidgetFontValueText" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </ui:SettingsExpander.Footer>
                                        </ui:SettingsExpander>
                                        <StackPanel x:Name="WidgetSettingsPanel" Spacing="4"/>
                                        <TextBlock x:Name="WidgetNoSettingsText" Text="该组件没有专属设置。"
                                                   Classes="settings-caption" Margin="4,2,0,0" IsVisible="False"/>
                                    </StackPanel>
                                </TabItem>
                            </TabControl>
                        </StackPanel>

                        
                        <StackPanel x:Name="PageAbout" Classes="settings-section" IsVisible="False">
                            <TextBlock Classes="settings-group-title" Text="关于 ClassNEX"/>
                            <ui:SettingsExpander x:Name="AboutExpander" Header="当前版本" Description="ClassNEX 桌面客户端">
                                <ui:SettingsExpander.IconSource>
                                    <ui:FontIconSource FontFamily="{StaticResource SettingsSymbolFont}" Glyph="&#xE946;" Foreground="{DynamicResource SettingsIconBrush}"/>
                                </ui:SettingsExpander.IconSource>
                                <ui:SettingsExpander.Footer>
                                    <TextBlock x:Name="AboutVersionText" Classes="settings-caption"
                                               PointerPressed="OnVersionPointerPressed" ToolTip.Tip="连点 10 次解锁调试菜单"/>
                                </ui:SettingsExpander.Footer>
                            </ui:SettingsExpander>
                            <ui:SettingsExpander Header="开源许可与隐私" Description="Copyright © 2026 ClassNEX · GNU General Public License v3.0">
                                <ui:SettingsExpander.IconSource>
                                    <ui:FontIconSource FontFamily="{StaticResource SettingsSymbolFont}" Glyph="&#xE8A5;" Foreground="{DynamicResource SettingsIconBrush}"/>
                                </ui:SettingsExpander.IconSource>
                                <ui:SettingsExpander.Footer>
                                    <WrapPanel Classes="settings-actions">
                                        <Button Content="开放源代码许可" Click="OnOpenLicense"/>
                                        <Button Content="隐私政策" Click="OnOpenPrivacyPolicy"/>
                                    </WrapPanel>
                                </ui:SettingsExpander.Footer>
                            </ui:SettingsExpander>
                            <ui:SettingsExpander Header="项目和反馈" Description="查看项目源代码，或向开发者报告问题。">
                                <ui:SettingsExpander.IconSource>
                                    <ui:FontIconSource FontFamily="{StaticResource SettingsSymbolFont}" Glyph="&#xE774;" Foreground="{DynamicResource SettingsIconBrush}"/>
                                </ui:SettingsExpander.IconSource>
                                <ui:SettingsExpander.Footer>
                                    <WrapPanel Classes="settings-actions">
                                        <Button Content="GitHub" Click="OnOpenHomePage"/>
                                        <Button Content="反馈问题" Click="OnOpenIssues"/>
                                    </WrapPanel>
                                </ui:SettingsExpander.Footer>
                            </ui:SettingsExpander>
                            <ui:SettingsExpander Header="首次启动向导" Description="在不修改当前设置的情况下预览首次启动流程。">
                                <ui:SettingsExpander.IconSource>
                                    <ui:FontIconSource FontFamily="{StaticResource SettingsSymbolFont}" Glyph="&#xE768;" Foreground="{DynamicResource SettingsIconBrush}"/>
                                </ui:SettingsExpander.IconSource>
                                <ui:SettingsExpander.Footer>
                                    <Button Content="预览 OOBE" Click="OnPreviewOobe"/>
                                </ui:SettingsExpander.Footer>
                            </ui:SettingsExpander>
                        </StackPanel>

                        
                        <StackPanel x:Name="PageDebug" Classes="settings-section" IsVisible="False">
                            <TextBlock Classes="settings-group-title" Text="诊断与调试"/>
                            <ui:InfoBar Severity="Error" Title="仅供调试"
                                        Message="除非你知道自己在做什么，否则请不要使用下面的按钮。"
                                        IsOpen="True" IsClosable="False"/>
                            <ui:SettingsExpander Header="通知测试" Description="直接触发各类提醒，用于检查效果（不依赖当前课表状态）">
                                <ui:SettingsExpander.IconSource>
                                    <ui:FontIconSource FontFamily="{StaticResource SettingsSymbolFont}" Glyph="&#xEA8F;" Foreground="{DynamicResource SettingsIconBrush}" FontSize="18"/>
                                </ui:SettingsExpander.IconSource>
                                <ui:SettingsExpanderItem x:Name="DebugTriggerTestNotificationItem" Content="拉起测试提醒" IsClickEnabled="True"/>
                                <ui:SettingsExpanderItem x:Name="DebugTriggerClassPreparingItem" Content="触发课前准备提醒" IsClickEnabled="True"/>
                                <ui:SettingsExpanderItem x:Name="DebugTriggerClassOnItem" Content="触发上课提醒" IsClickEnabled="True"/>
                                <ui:SettingsExpanderItem x:Name="DebugTriggerClassOffItem" Content="触发下课提醒" IsClickEnabled="True"/>
                            </ui:SettingsExpander>
                            <ui:SettingsExpander Header="调试菜单">
                                <ui:SettingsExpander.IconSource>
                                    <ui:FontIconSource FontFamily="{StaticResource SettingsSymbolFont}" Glyph="&#xEBE8;" Foreground="{DynamicResource SettingsIconBrush}" FontSize="18"/>
                                </ui:SettingsExpander.IconSource>
                                <ui:SettingsExpanderItem x:Name="DebugCloseItem" Content="关闭调试菜单（隐藏本页）" IsClickEnabled="True"/>
                            </ui:SettingsExpander>

                            
                            <ui:SettingsExpander Header="NEX Intelligence 接口"
                                                 Description="留空则使用内置接口（开箱可用）。填入你自己的地址/密钥就会覆盖内置的；密钥框不会回显内置密钥明文。">
                                <ui:SettingsExpander.IconSource>
                                    <ui:FontIconSource FontFamily="{StaticResource SettingsSymbolFont}" Glyph="&#xE703;" Foreground="{DynamicResource SettingsIconBrush}" FontSize="18"/>
                                </ui:SettingsExpander.IconSource>
                                <ui:SettingsExpanderItem Content="服务地址" Description="留空 = 内置地址">
                                    <ui:SettingsExpanderItem.Footer>
                                        <TextBox x:Name="NexBaseUrlBox" Classes="settings-wide-field" Watermark="留空使用内置接口"/>
                                    </ui:SettingsExpanderItem.Footer>
                                </ui:SettingsExpanderItem>
                                <ui:SettingsExpanderItem Content="接口密钥" Description="留空 = 使用内置密钥；填写后只保存你自己的密钥">
                                    <ui:SettingsExpanderItem.Footer>
                                        <TextBox x:Name="NexApiKeyBox" Classes="settings-wide-field" PasswordChar="•" Watermark="留空使用内置密钥"/>
                                    </ui:SettingsExpanderItem.Footer>
                                </ui:SettingsExpanderItem>
                                <ui:SettingsExpanderItem Content="模型" Description="留空 = 内置模型；点「拉取模型」从接口读取可用列表">
                                    <ui:SettingsExpanderItem.Footer>
                                        <WrapPanel Classes="settings-actions">
                                            <ComboBox x:Name="NexModelCombo" Width="200" IsEditable="True"/>
                                            <Button x:Name="NexFetchModelsButton" Content="拉取模型"/>
                                        </WrapPanel>
                                    </ui:SettingsExpanderItem.Footer>
                                </ui:SettingsExpanderItem>
                                <ui:SettingsExpanderItem Content="测试与重置" Description="测试当前配置能否连通；重置会清掉自定义配置、回到内置接口">
                                    <ui:SettingsExpanderItem.Footer>
                                        <WrapPanel Classes="settings-actions">
                                            <Button x:Name="NexTestButton" Content="测试连接"/>
                                            <Button x:Name="NexResetButton" Content="恢复内置接口"/>
                                            <TextBlock x:Name="NexStatusText" VerticalAlignment="Center" MaxWidth="180" Classes="settings-caption"/>
                                        </WrapPanel>
                                    </ui:SettingsExpanderItem.Footer>
                                </ui:SettingsExpanderItem>
                            </ui:SettingsExpander>
                        </StackPanel>

                        
                        <StackPanel x:Name="PageAccount" Classes="settings-section" IsVisible="False">
                            <TextBlock Classes="settings-group-title" Text="ClassNEX ID"/>
                            <Border x:Name="AccountPageHero">
                                <ui:SettingsExpander>
                                    <ui:SettingsExpander.Header>
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                                            <Border x:Name="AccountPageAvatarRing" Width="72" Height="72" CornerRadius="36"
                                                    BorderThickness="1" ClipToBounds="True" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                                <WrapPanel Classes="settings-actions">
                                                    <TextBlock x:Name="AccountPageNameText" FontSize="20" VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <Border x:Name="AccountPageStatusBadge" Padding="8,2" CornerRadius="8" BorderThickness="1"
                                                            VerticalAlignment="Center">
                                                        <TextBlock x:Name="AccountPageStatusText" FontSize="12"/>
                                                    </Border>
                                                </WrapPanel>
                                                <TextBlock x:Name="AccountPageEmailText" FontSize="14" TextWrapping="Wrap"/>
                                                <TextBlock x:Name="AccountPageSyncText" Classes="settings-caption"/>
                                            </StackPanel>
                                        </Grid>
                                    </ui:SettingsExpander.Header>
                                    <ui:SettingsExpander.Footer>
                                        <WrapPanel Classes="settings-actions">
                                            <Button x:Name="AccountLoginButton" Content="浏览器登录" Click="OnAccountLogin"/>
                                            <Button x:Name="AccountLogoutButton" Content="退出登录" Click="OnAccountLogout"/>
                                        </WrapPanel>
                                    </ui:SettingsExpander.Footer>
                                </ui:SettingsExpander>
                            </Border>
                            <ui:SettingsExpander Header="账户资料" Description="头像、用户名和邮箱由账户服务同步。需要修改时，请前往账户服务中心。">
                                <ui:SettingsExpander.IconSource>
                                    <ui:FontIconSource FontFamily="{StaticResource SettingsSymbolFont}" Glyph="&#xE77B;" Foreground="{DynamicResource SettingsIconBrush}"/>
                                </ui:SettingsExpander.IconSource>
                            </ui:SettingsExpander>
                            <ui:SettingsExpander Header="浏览器安全授权" Description="登录和注册在默认浏览器完成。ClassNEX 不读取或保存账户密码。">
                                <ui:SettingsExpander.IconSource>
                                    <ui:FontIconSource FontFamily="{StaticResource SettingsSymbolFont}" Glyph="&#xE72E;" Foreground="{DynamicResource SettingsIconBrush}"/>
                                </ui:SettingsExpander.IconSource>
                            </ui:SettingsExpander>
                        </StackPanel>

                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </ui:NavigationView>
    </Grid>
</wd:AppWindow>
