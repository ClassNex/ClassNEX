<wd:AppWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="using:AvaloniaFluentUI.Controls"
        xmlns:wd="using:AvaloniaFluentUI.Windowing"
        mc:Ignorable="d" d:DesignWidth="1240" d:DesignHeight="620"
        x:Class="ClassNex.Views.SettingsWindow"
        Title="应用设置"
        Icon="/Assets/icon.ico"
        TitleBarHeight="48"
        IsTitleBarContentVisible="False"
        Width="1240" Height="620"
        MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen">

    <!-- 结构 1:1 对照 CI 的 Views/SettingsWindowNew.axaml + SettingPages/*：
         顶栏(48) + NavigationView(PaneHeader 账户块 + MenuItems 图标) + 页面标题行 + 页面。
         每个设置项 = SettingsExpander(IconSource + Header + Description + Footer 常显控件)。 -->
    <Grid RowDefinitions="48,*">
        <!-- 页面入场动画：照 Fluent 的页面导航规范 —— SlideNavigationTransition（只滑不淡）。
             ⚠️ 两条硬约束（都实测踩过）：
               ① 关键帧里不能动 RenderTransform（Avalonia 无该属性动画器，直接抛异常把窗口搞崩）；
               ② 不能对整页做 Opacity 动画（大子树每帧离屏合成，非常卡）。
             所以：用 TranslateTransform + DoubleTransition 做纯位移（合成器层面，不重排不重绘）。 -->
        <Grid.Styles>
            <Style Selector="ScrollViewer.anim">
                <Style.Animations>
                    <Animation Duration="0:0:0.32" FillMode="Both" Easing="0.1,0.9,0.2,1">
                        <KeyFrame Cue="0%">
                            <Setter Property="Opacity" Value="1"/>
                        </KeyFrame>
                        <KeyFrame Cue="100%">
                            <Setter Property="Opacity" Value="1"/>
                        </KeyFrame>
                    </Animation>
                </Style.Animations>
            </Style>
        </Grid.Styles>
        <!-- ============ 顶栏（CI：Border Height=48；不要下面那条浅线） ============ -->
        <Border Grid.Row="0" Height="48" BorderThickness="0">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="14,0,0,0">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <!-- 左上角返回箭头（照 Gallery 标题栏那个 ←） -->
                    <Button x:Name="BackButton" Theme="{StaticResource TransparentButton}"
                            Padding="6,4" VerticalAlignment="Center" ToolTip.Tip="返回上一页"
                            Click="OnNavigateBack">
                        <ui:FontIcon Glyph="&#xE72B;" FontSize="14"/>
                    </Button>
                    <Image Source="/Assets/icon.ico" Width="18" Height="18"
                           IsHitTestVisible="False" RenderOptions.BitmapInterpolationMode="HighQuality"/>
                    <TextBlock Text="应用设置" FontSize="12" VerticalAlignment="Center" IsHitTestVisible="False"/>
                </StackPanel>

                <!-- Win11 设置同款：搜索框在顶栏居中偏右（用户要求再往右一点） -->
                <Border Grid.Column="1" Width="420" Height="32" CornerRadius="8" BorderThickness="1"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Margin="110,0,0,0"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        Background="{DynamicResource ControlFillColorDefaultBrush}">
                    <TextBox x:Name="SearchBox"
                             BorderThickness="0" Background="Transparent"
                             Watermark="查找设置"
                             VerticalAlignment="Center" VerticalContentAlignment="Center"
                             Margin="2,0,2,0">
                        <TextBox.InnerLeftContent>
                            <ui:FontIcon Glyph="&#xE721;" FontSize="12" Margin="8,0,6,0"
                                         VerticalAlignment="Center" Opacity="0.7"/>
                        </TextBox.InnerLeftContent>
                    </TextBox>
                </Border>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock x:Name="VersionText" FontSize="12" VerticalAlignment="Center"
                               ToolTip.Tip="连点 10 次可解锁调试菜单"
                               PointerPressed="OnVersionPointerPressed"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <Button x:Name="MoreOptionsButton" Theme="{StaticResource TransparentButton}"
                            VerticalAlignment="Center" ToolTip.Tip="更多选项…">
                        <ui:FontIcon Glyph="&#xE946;" FontSize="14"/>
                        <Button.Flyout>
                            <!-- 照 CI SettingsWindowNew 的「更多选项」菜单（去掉集控/管理等 CI 专有项） -->
                            <MenuFlyout>
                                <MenuItem Header="创建快捷方式…">
                                    <MenuItem.Icon><ui:FontIcon Glyph="&#xE71C;"/></MenuItem.Icon>
                                    <MenuItem Header="创建桌面快捷方式" Click="OnCreateDesktopShortcut">
                                        <MenuItem.Icon><ui:FontIcon Glyph="&#xE8AB;"/></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="创建开始菜单快捷方式" Click="OnCreateStartMenuShortcut">
                                        <MenuItem.Icon><ui:FontIcon Glyph="&#xE8AB;"/></MenuItem.Icon>
                                    </MenuItem>
                                </MenuItem>
                                <Separator/>
                                <MenuItem Header="NEX Intelligence…" Click="OnOpenNexChat"/>
                        <MenuItem Header="日志…" Click="OnOpenLogFile">
                                    <MenuItem.Icon><ui:FontIcon Glyph="&#xE9D9;"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="导出诊断数据…" Click="OnExportDiagnostics">
                                    <MenuItem.Icon><ui:FontIcon Glyph="&#xE74D;"/></MenuItem.Icon>
                                </MenuItem>
                                <Separator/>
                                <MenuItem Header="打开日志目录…" Click="OnOpenLogsFolder">
                                    <MenuItem.Icon><ui:FontIcon Glyph="&#xE838;"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="打开数据目录…" Click="OnOpenDataFolder">
                                    <MenuItem.Icon><ui:FontIcon Glyph="&#xE838;"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="打开应用目录…" Click="OnOpenAppFolder">
                                    <MenuItem.Icon><ui:FontIcon Glyph="&#xE838;"/></MenuItem.Icon>
                                </MenuItem>
                                <Separator/>
                                <MenuItem Header="重启 ClassNEX" Click="OnRestartApp">
                                    <MenuItem.Icon><ui:FontIcon Glyph="&#xE72C;"/></MenuItem.Icon>
                                </MenuItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>

                <!-- 系统最小化/最大化/关闭按钮占位（沉浸式标题栏里它们画在右上角，实测 3×58≈174 逻辑，留 152 间距避免贴住） -->
                <Border Grid.Column="3" Width="152"/>
            </Grid>
        </Border>

        <!-- ============ 主体导航 ============
             Background 必须显式置空：NavigationView 自带不透明底色，会把窗口的 Mica 云母盖掉，
             只有顶栏能透出云母（这就是「内容区没做到云母」的原因）。 -->
        <ui:NavigationView Grid.Row="1" x:Name="NavView"
                           Background="Transparent"
                           PaneDisplayMode="Left" OpenPaneLength="283"
                           IsBackButtonVisible="False" IsSettingsVisible="False"
                           IsPaneToggleButtonVisible="True">

            <!-- 账户卡放 PaneCustomContent（WinUI 里专门给「面板顶部自定义内容」的槽位）。
                 不用 PaneHeader 的原因：模板会把 PaneHeader 推到 ☰ 按钮那一列右侧（内缩 ~48 DIP）
                 且有裁剪边界 —— 负边距调回来就会把头像左缘切掉，怎么调都不对。
                 PaneCustomContent 从面板左缘开始排：无负边距、不会被裁、能和 ☰ 对齐。 -->
            <ui:NavigationView.PaneCustomContent>
                <!-- 负左边距：a11y 实测 ☰=185 / 导航项=184 / 账户卡=204（物理），
                     左移 15 DIP 让账户卡与 ☰、导航项左缘对齐；再多会被面板裁掉头像 -->
                <!-- 说明：账户卡在 NavigationView 的 PaneHeader 里，而 PaneHeader 自身有一条内边距 + 裁剪边界
                     （a11y 实测：☰=185 / 导航项=184 / 账户卡默认=242，物理像素）。
                     实测 -24 不裁、-30 会把头像左缘切掉 → 取 -12 并把卡内 left padding 归零（8→0），
                     头像左缘落在 ~218px ≈ 27 DIP：**不裁切**，且比默认位置左移约 24px。 -->
                <StackPanel x:Name="AccountPanel" Spacing="8" Margin="14,6,6,10">
                    <!-- 折叠态需要把整块往左补偿（展开态用户要的是偏右一点），
                         用 RenderTransform 位移：只重绘、有过渡、蒙版跟着走，不触发重新布局 -->
                    <StackPanel.RenderTransform>
                        <TranslateTransform>
                            <TranslateTransform.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="X" Duration="0:0:0.15">
                                        <DoubleTransition.Easing><CubicEaseOut/></DoubleTransition.Easing>
                                    </DoubleTransition>
                                </Transitions>
                            </TranslateTransform.Transitions>
                        </TranslateTransform>
                    </StackPanel.RenderTransform>
                    <!-- 账户卡：照 FluentUI Gallery 的账户卡（IzumiPL/Avalonia-Fluent-UI samples/Gallery）
                         圆角卡片 + 带描环的 50 圆头像 + 名字 15 SemiBold + 邮箱 12.5/65% -->
                    <StackPanel.Styles>
                        <Style Selector="Button.AccountCard">
                            <Setter Property="Transitions">
                                <Transitions>
                                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                                </Transitions>
                            </Setter>
                        </Style>
                        <Style Selector="Button.AccountCard:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}"/>
                        </Style>
                        <Style Selector="Button.AccountCard:pressed /template/ ContentPresenter">
                            <Setter Property="Opacity" Value="0.85"/>
                        </Style>
                    </StackPanel.Styles>

                    <!-- 账户区（照 Gallery）：**默认无底色**，鼠标移入才出现高亮蒙版；
                         Padding 归零 —— 让头像贴住卡片左缘，整体能再往左靠一点 -->
                    <Button x:Name="AccountButton" Classes="AccountCard"
                            Padding="0" CornerRadius="8"
                            Background="Transparent" BorderThickness="0"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Click="OnAccountClick" ToolTip.Tip="账户">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <!-- 头像：用 Border 的 Background 画图片 —— Background 一定会被圆角裁剪，
                                 子元素 Image 则不一定（之前就出现了「四个角」的问题）。
                                 图片/描环颜色都在代码里设置（图片可在账户页自己上传）。
                                 52↔36 走过渡动画（左边栏折叠时缩进侧边栏） -->
                            <Border x:Name="AccountAvatarRing" Width="52" Height="52" CornerRadius="26"
                                    BorderThickness="3">
                                <Border.Transitions>
                                    <Transitions>
                                        <DoubleTransition Property="Width" Duration="0:0:0.18">
                                            <DoubleTransition.Easing><CubicEaseOut/></DoubleTransition.Easing>
                                        </DoubleTransition>
                                        <DoubleTransition Property="Height" Duration="0:0:0.18">
                                            <DoubleTransition.Easing><CubicEaseOut/></DoubleTransition.Easing>
                                        </DoubleTransition>
                                    </Transitions>
                                </Border.Transitions>
                            </Border>
                            <StackPanel x:Name="AccountTextHost" VerticalAlignment="Center" Spacing="3">
                                <StackPanel.Transitions>
                                    <Transitions>
                                        <DoubleTransition Property="Opacity" Duration="0:0:0.14"/>
                                    </Transitions>
                                </StackPanel.Transitions>
                                <TextBlock x:Name="AccountNameText" FontSize="17"/>
                                <TextBlock x:Name="AccountEmailText" FontSize="13" Opacity="0.7"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </ui:NavigationView.PaneCustomContent>

            <ui:NavigationView.MenuItems>
                <!-- 主页（CW2 风格仪表盘）；主页与基本之间加轻分割（用户要求：有分割但不要太大） -->
                <ui:NavigationViewItem Content="主页">
                    <ui:NavigationViewItem.IconSource>
                        <ui:FontIconSource FontFamily="Segoe MDL2 Assets" Glyph="&#xE80F;" FontSize="16"/>
                    </ui:NavigationViewItem.IconSource>
                </ui:NavigationViewItem>
                <ui:NavigationViewItemSeparator/>
                <!-- 1:1 照 CI 的页序与页名（Internal 组）：基本 / 外观 / 窗口 / 组件；底部 = 关于 ClassNEX -->
                <ui:NavigationViewItem Content="基本">
                    <ui:NavigationViewItem.IconSource>
                        <ui:FontIconSource FontFamily="Segoe MDL2 Assets" Glyph="&#xE713;" FontSize="16"/>
                    </ui:NavigationViewItem.IconSource>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="外观">
                    <ui:NavigationViewItem.IconSource>
                        <ui:FontIconSource FontFamily="Segoe MDL2 Assets" Glyph="&#xE790;" FontSize="16"/>
                    </ui:NavigationViewItem.IconSource>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="窗口">
                    <ui:NavigationViewItem.IconSource>
                        <ui:FontIconSource FontFamily="Segoe MDL2 Assets" Glyph="&#xE740;" FontSize="16"/>
                    </ui:NavigationViewItem.IconSource>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="组件">
                    <ui:NavigationViewItem.IconSource>
                        <ui:FontIconSource FontFamily="Segoe MDL2 Assets" Glyph="&#xE71D;" FontSize="16"/>
                    </ui:NavigationViewItem.IconSource>
                </ui:NavigationViewItem>
                <!-- NEX：标准结构（Content + IconSource，和上下项完全一致），对齐由模板保证。
                     图标 = Fluent UI 图标库官方 Sparkle（U+F0F7，avares 引用内嵌字体）。
                     之前「小」是因为裸族名命不中内嵌字体、回退成了别的符号（已修）；
                     Content 方案的 -8px 边距 hack 对齐不可靠，弃用。 -->
                <ui:NavigationViewItem Content="NEX Intelligence">
                    <ui:NavigationViewItem.IconSource>
                        <ui:FontIconSource FontFamily="avares://ClassNex/Assets/Fonts/#FluentSystemIcons-Resizable"
                                           Glyph="&#xF0F7;" FontSize="18"/>
                    </ui:NavigationViewItem.IconSource>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="提醒">
                    <ui:NavigationViewItem.IconSource>
                        <ui:FontIconSource FontFamily="Segoe MDL2 Assets" Glyph="&#xE838;" FontSize="16"/>
                    </ui:NavigationViewItem.IconSource>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="关于 ClassNEX">
                    <ui:NavigationViewItem.IconSource>
                        <ui:FontIconSource FontFamily="Segoe MDL2 Assets" Glyph="&#xE946;" FontSize="16"/>
                    </ui:NavigationViewItem.IconSource>
                </ui:NavigationViewItem>
                <!-- 调试页：默认隐藏，在「关于」页连点版本号 10 次解锁（对照 CI AboutSettingsPage 的 DebugBorder） -->
                <ui:NavigationViewItem x:Name="DebugNavItem" Content="调试" IsVisible="False">
                    <ui:NavigationViewItem.IconSource>
                        <ui:FontIconSource FontFamily="Segoe MDL2 Assets" Glyph="&#xE7C4;" FontSize="16"/>
                    </ui:NavigationViewItem.IconSource>
                </ui:NavigationViewItem>
            </ui:NavigationView.MenuItems>

            <Grid RowDefinitions="Auto,*">
                <TextBlock x:Name="PageTitleText" Grid.Row="0" FontSize="28"
                           Margin="32,24,32,0" HorizontalAlignment="Left"/>
                <ScrollViewer x:Name="PageScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <!-- 页面滑动入场（Fluent 的 SlideNavigationTransition / FromBottom）：
                         ★ 补间必须挂在 TranslateTransform 自己身上、属性写 Y —— 挂在 ScrollViewer 上写
                           "TranslateTransform.Y" 是无效的（Avalonia 只认该对象自己的属性），实测动画完全不播。 -->
                    <ScrollViewer.RenderTransform>
                        <TranslateTransform>
                            <TranslateTransform.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Y" Duration="0:0:0.32">
                                        <DoubleTransition.Easing>
                                            <CubicEaseOut/>
                                        </DoubleTransition.Easing>
                                    </DoubleTransition>
                                </Transitions>
                            </TranslateTransform.Transitions>
                        </TranslateTransform>
                    </ScrollViewer.RenderTransform>
                    <StackPanel Margin="32,12,32,24" Spacing="12" MaxWidth="880" HorizontalAlignment="Left">

                        <!-- ==================== 主页 ====================
                             按需求精简：横幅已删、底下三组小卡片（今天/快捷操作/状态）已全部删除，
                             只保留问候语（英文，随系统时间变化）+ 一行副标题。 -->
                        <StackPanel x:Name="PageHome" Spacing="6">
                            <TextBlock x:Name="HomeGreetingText"
                                       FontSize="34"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="HomeSubText"
                                       FontSize="14"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>

                        <!-- ==================== NEX Intelligence（AI Agent） ==================== -->
                        <StackPanel x:Name="PageNex" Spacing="12" IsVisible="False">
                            <ui:InfoBar Severity="Informational" IsOpen="True" IsClosable="False"
                                        Message="NEX 是内置的 AI 助手：能查课表、看应用状态，也能按你选的权限读写文件。对话内容会发送到接口服务商。"/>

                            <ui:SettingsExpander Header="接口"
                                                 Description="应用已内置可用的接口，开箱即可对话，无需配置。想换成你自己的接口/密钥，请到「调试」页设置（版本号连点 10 次解锁）。">
                                <ui:SettingsExpander.IconSource>
                                    <ui:FontIconSource FontFamily="Segoe MDL2 Assets" Glyph="&#xE968;"/>
                                </ui:SettingsExpander.IconSource>
                                <ui:SettingsExpanderItem x:Name="NexApiStateItem" Content="当前接口" Description="正在使用内置接口">
                                    <ui:SettingsExpanderItem.Footer>
                                        <TextBlock x:Name="NexApiStateText" VerticalAlignment="Center" FontSize="13"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </ui:SettingsExpanderItem.Footer>
                                </ui:SettingsExpanderItem>
                            </ui:SettingsExpander>

                            <ui:SettingsExpander Header="默认权限"
                                                 Description="打开对话框时的默认档位（对话框顶部随时可改）。仅可查看=只读；工作区内修改=可改应用数据目录里的文件；完全权限=任意路径 + 执行命令。">
                                <ui:SettingsExpander.IconSource>
                                    <ui:FontIconSource FontFamily="Segoe MDL2 Assets" Glyph="&#xE72E;"/>
                                </ui:SettingsExpander.IconSource>
                                <ui:SettingsExpander.Footer>
                                    <ComboBox x:Name="NexPermissionCombo" Width="180">
                                        <ComboBoxItem Content="仅可查看"/>
                                        <ComboBoxItem Content="工作区内修改"/>
                                        <ComboBoxItem Content="完全权限"/>
                                    </ComboBox>
                                </ui:SettingsExpander.Footer>
                            </ui:SettingsExpander>

                            <ui:SettingsExpander Header="系统提示词"
                                                 Description="可选。留空用内置提示词（会带上应用状态、工作区与当前权限说明）。">
                                <ui:SettingsExpander.IconSource>
                                    <ui:FontIconSource FontFamily="Segoe MDL2 Assets" Glyph="&#xE70F;"/>
                                </ui:SettingsExpander.IconSource>
                                <ui:SettingsExpanderItem Content="自定义提示词">
                                    <ui:SettingsExpanderItem.Footer>
                                        <TextBox x:Name="NexSystemPromptBox" Width="320" AcceptsReturn="True"
                                                 MinHeight="64" MaxHeight="140" TextWrapping="Wrap"
                                                 Watermark="留空使用内置提示词"/>
                                    </ui:SettingsExpanderItem.Footer>
                                </ui:SettingsExpanderItem>
                            </ui:SettingsExpander>

                            <ui:SettingsExpander Header="语音唤醒"
                                                 Description="对着麦克风说「嘿 NEX」或「NEX」即可唤醒：响起提示音、屏幕四周亮起跑马灯，浮窗课表向上翻页变成对话。">
                                <ui:SettingsExpander.IconSource>
                                    <ui:FontIconSource FontFamily="Segoe MDL2 Assets" Glyph="&#xE720;"/>
                                </ui:SettingsExpander.IconSource>
                                <ui:SettingsExpander.Footer>
                                    <CheckBox x:Name="NexVoiceWakeCheck" Content="启用"/>
                                </ui:SettingsExpander.Footer>
                                <ui:SettingsExpanderItem Content="唤醒条" Description="屏幕左右侧贴一条半透明小白条，点一下等于喊「嘿 NEX」">
                                    <ui:SettingsExpanderItem.Footer>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <CheckBox x:Name="NexEdgeBarCheck" Content="显示"/>
                                            <ComboBox x:Name="NexEdgeBarSideCombo" Width="110">
                                                <ComboBoxItem Content="右侧"/>
                                                <ComboBoxItem Content="左侧"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </ui:SettingsExpanderItem.Footer>
                                </ui:SettingsExpanderItem>
                                <ui:SettingsExpanderItem Content="状态" Description="识别在本机离线进行，不上传麦克风音频">
                                    <ui:SettingsExpanderItem.Footer>
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <TextBlock x:Name="NexVoiceStatusText" VerticalAlignment="Center" FontSize="13"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            <Button x:Name="NexGlowTestButton" Content="测试跑马灯"/>
                                            <Button x:Name="NexMicTestButton" Content="测试麦克风"/>
                                            <Button x:Name="NexSpeechSettingsButton" Content="打开系统语音设置"/>
                                            <Button x:Name="NexSoundSettingsButton" Content="打开声音设置"/>
                                        </StackPanel>
                                    </ui:SettingsExpanderItem.Footer>
                                </ui:SettingsExpanderItem>
                            </ui:SettingsExpander>

                            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4,0,0">
                                <Button x:Name="NexOpenChatButton" Content="打开 NEX 对话框" Classes="Primary" MinWidth="150"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- ==================== 提醒（1:1 照 CI ClassNotificationProviderSettingsControl.axaml） ==================== -->
                        <StackPanel x:Name="PageNotification" Spacing="12" IsVisible="False">
                            <ui:InfoBar Message="此处的设置可以在档案设置中被附加设置覆盖。"
                                        IsOpen="True" IsClosable="False"/>

                            <ui:SettingsExpander Header="在课前准备时发出提醒"
                                                 Description="在上课前一段时间发出醒目提醒，提示做好上课准备。">
                                <ui:SettingsExpander.IconSource>
                                    <ui:FontIconSource FontFamily="Segoe MDL2 Assets" Glyph="&#xE916;"/>
                                </ui:SettingsExpander.IconSource>
                                <ui:SettingsExpander.Footer>
                                    <CheckBox x:Name="PreparingEnabledCheck"/>
                                </ui:SettingsExpander.Footer>
                                <ui:SettingsExpanderItem>
                                    <CheckBox Content="启用语音" x:Name="PreparingSpeechCheck"/>
                                </ui:SettingsExpanderItem>
                                <ui:SettingsExpanderItem Content="室内课程课前提醒时间"
                                                         Description="在室内课程的上课前指定时间进行上课提醒。">
                                    <ui:SettingsExpanderItem.Footer>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <ui:NumberBox x:Name="IndoorPreparingBox" Maximum="3600" Minimum="0"
                                                          Width="150" SpinButtonPlacementMode="Inline"/>
                                            <TextBlock Text="秒" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </ui:SettingsExpanderItem.Footer>
                                </ui:SettingsExpanderItem>
                                <ui:SettingsExpanderItem Content="室外课程课前提醒时间"
                                                         Description="在室外课程的上课前指定时间进行上课提醒。">
                                    <ui:SettingsExpanderItem.Footer>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <ui:NumberBox x:Name="OutdoorPreparingBox" Maximum="3600" Minimum="0"
                                                          Width="150" SpinButtonPlacementMode="Inline"/>
                                            <TextBlock Text="秒" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </ui:SettingsExpanderItem.Footer>
                                </ui:SettingsExpanderItem>
                                <ui:SettingsExpanderItem Content="室内课程准备上课提醒文字">
                                    <ui:SettingsExpanderItem.Footer>
                                        <TextBox x:Name="PreparingText" MinWidth="150"/>
                                    </ui:SettingsExpanderItem.Footer>
                                </ui:SettingsExpanderItem>
                                <ui:SettingsExpanderItem Content="室内课程准备上课遮罩文字">
                                    <ui:SettingsExpanderItem.Footer>
                                        <TextBox x:Name="PreparingMaskText" MinWidth="150"/>
                                    </ui:SettingsExpanderItem.Footer>
                                </ui:SettingsExpanderItem>
                                <ui:SettingsExpanderItem Content="户外课程准备上课提醒文字">
                                    <ui:SettingsExpanderItem.Footer>
                                        <TextBox x:Name="OutdoorPreparingText" MinWidth="150"/>
                                    </ui:SettingsExpanderItem.Footer>
                                </ui:SettingsExpanderItem>
                                <ui:SettingsExpanderItem Content="户外课程准备上课遮罩文字">
                                    <ui:SettingsExpanderItem.Footer>
                                        <TextBox x:Name="OutdoorPreparingMaskText"/>
                                    </ui:SettingsExpanderItem.Footer>
                                </ui:SettingsExpanderItem>
                            </ui:SettingsExpander>

                            <ui:SettingsExpander Header="在上课时发出提醒"
                                                 Description="在上课时发出醒目提醒，提示已经上课。">
                                <ui:SettingsExpander.IconSource>
                                    <ui:FontIconSource FontFamily="Segoe MDL2 Assets" Glyph="&#xE8AB;"/>
                                </ui:SettingsExpander.IconSource>
                                <ui:SettingsExpander.Footer>
                                    <CheckBox x:Name="ClassOnEnabledCheck"/>
                                </ui:SettingsExpander.Footer>
                                <ui:SettingsExpanderItem>
                                    <CheckBox Content="启用语音" x:Name="ClassOnSpeechCheck"/>
                                </ui:SettingsExpanderItem>
                                <ui:SettingsExpanderItem Content="上课遮罩文字">
                                    <ui:SettingsExpanderItem.Footer>
                                        <TextBox x:Name="ClassOnMaskBox" MinWidth="150"/>
                                    </ui:SettingsExpanderItem.Footer>
                                </ui:SettingsExpanderItem>
                            </ui:SettingsExpander>

                            <ui:SettingsExpander Header="在下课时发出提醒"
                                                 Description="在下课时发出醒目提醒，提示已经下课。">
                                <ui:SettingsExpander.IconSource>
                                    <ui:FontIconSource FontFamily="Segoe MDL2 Assets" Glyph="&#xE7C4;"/>
                                </ui:SettingsExpander.IconSource>
                                <ui:SettingsExpander.Footer>
                                    <CheckBox x:Name="ClassOffEnabledCheck"/>
                                </ui:SettingsExpander.Footer>
                                <ui:SettingsExpanderItem>
                                    <CheckBox Content="启用语音" x:Name="ClassOffSpeechCheck"/>
                                </ui:SettingsExpanderItem>
                                <ui:SettingsExpanderItem Content="下课提醒文字">
                                    <ui:SettingsExpanderItem.Footer>
                                        <TextBox x:Name="ClassOffOverlayBox" MinWidth="150" Watermark="（禁用）"/>
                                    </ui:SettingsExpanderItem.Footer>
                                </ui:SettingsExpanderItem>
                            </ui:SettingsExpander>

                            <ui:SettingsExpander Header="显示科任老师名字"
                                                 Description="在显示课程相关的提醒时同时展示并播报对应科任老师的名字">
                                <ui:SettingsExpander.IconSource>
                                    <ui:FontIconSource FontFamily="Segoe MDL2 Assets" Glyph="&#xE77B;"/>
                                </ui:SettingsExpander.IconSource>
                                <ui:SettingsExpander.Footer>
                                    <CheckBox x:Name="ShowTeacherCheck"/>
                                </ui:SettingsExpander.Footer>
                            </ui:SettingsExpander>
                        </StackPanel>

                        <!-- ==================== 通用 ==================== -->
                        <StackPanel x:Name="PageGeneral" Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,2">
                                <ui:FontIcon Glyph="&#xE945;" FontSize="16" VerticalAlignment="Center" Opacity="0.85"/>
                                <TextBlock Text="行为" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>

                            <ui:SettingsExpander Header="开机自启"
                                                 Description="在您的系统启动时自动运行本应用。">
                                <ui:SettingsExpander.IconSource>
                                    <!-- Fluent ApprovalsApp 16 Filled -->
                                    <ui:PathIconSource>
                                        <ui:PathIconSource.Data>
                                            <StreamGeometry>M8.314.256a.75.75 0 1 0-1.128.988l.687.786A6.5 6.5 0 1 0 15 8.5v-.25a.75.75 0 1 0-1.5 0v.25a5 5 0 1 1-5.695-4.952l-.62.708a.75.75 0 1 0 1.13.988l1.75-2a.75.75 0 0 0 0-.988zm3.491 5.99a.75.75 0 0 1-.05 1.059l-2.75 2.5A.75.75 0 0 1 7.97 9.78L6.72 8.53a.75.75 0 0 1 1.06-1.06l.745.744l2.22-2.019a.75.75 0 0 1 1.06.05</StreamGeometry>
                                        </ui:PathIconSource.Data>
                                    </ui:PathIconSource>
                                </ui:SettingsExpander.IconSource>
                                <ui:SettingsExpander.Footer>
                                    <Border x:Name="StartupToggleHost"><ToggleSwitch/></Border>
                                </ui:SettingsExpander.Footer>
                            </ui:SettingsExpander>

                            <ui:SettingsExpander Header="注册 Url 协议"
                                                 Description="允许第三方应用或网页通过 Url 协议 classnex:// 调用本应用的部分功能。">
                                <ui:SettingsExpander.IconSource>
                                    <!-- Fluent Apps 16 Filled -->
                                    <ui:PathIconSource>
                                        <ui:PathIconSource.Data>
                                            <StreamGeometry>M11.81 2.45a1.5 1.5 0 0 0-2.12 0L7.961 4.175A1.5 1.5 0 0 0 6.497 3h-3a1.5 1.5 0 0 0-1.5 1.5v8c0 .51.255.96.644 1.231c.243.17.54.27.859.27h8a1.5 1.5 0 0 0 1.5-1.5v-3a1.5 1.5 0 0 0-1.125-1.452L13.58 6.34a1.5 1.5 0 0 0 0-2.121zM7.997 6.42L9.577 8h-1.58zm-1 1.58h-4V4.5a.5.5 0 0 1 .5-.5h3a.5.5 0 0 1 .5.5zm-3.786 4.91A.5.5 0 0 1 3 12.5V9h3.997v4h-3.5a.5.5 0 0 1-.286-.09m4.786.09V9H11.5a.5.5 0 0 1 .5.5v3a.5.5 0 0 1-.5.5z</StreamGeometry>
                                        </ui:PathIconSource.Data>
                                    </ui:PathIconSource>
                                </ui:SettingsExpander.IconSource>
                                <ui:SettingsExpander.Footer>
                                    <Border x:Name="UrlProtocolToggleHost"><ToggleSwitch/></Border>
                                </ui:SettingsExpander.Footer>
                            </ui:SettingsExpander>

                            <ui:SettingsExpander Header="学期开始时间"
                                                 Description="设置学期首日，该日期将作为多周轮换课表的计算起点和每周的第一天。">
                                <ui:SettingsExpander.IconSource>
                                    <!-- Fluent Calendar 16 Filled -->
                                    <ui:PathIconSource>
                                        <ui:PathIconSource.Data>
                                            <StreamGeometry>M14 11.5V6H2v5.5A2.5 2.5 0 0 0 4.5 14h7a2.5 2.5 0 0 0 2.5-2.5M5.997 8.248a.748.748 0 1 1-1.497 0a.748.748 0 0 1 1.497 0m0 2.5a.748.748 0 1 1-1.497 0a.748.748 0 0 1 1.497 0m2.752-2.5a.748.748 0 1 1-1.497 0a.748.748 0 0 1 1.497 0m0 2.5a.748.748 0 1 1-1.497 0a.748.748 0 0 1 1.497 0m2.748-2.5a.748.748 0 1 1-1.497 0a.748.748 0 0 1 1.497 0M14 4.5A2.5 2.5 0 0 0 11.5 2h-7A2.5 2.5 0 0 0 2 4.5V5h12z</StreamGeometry>
                                        </ui:PathIconSource.Data>
                                    </ui:PathIconSource>
                                </ui:SettingsExpander.IconSource>
                                <!-- 多周轮换偏移（右侧按钮 + Flyout）已按需求删除，只留日期选择 -->
                                <ui:SettingsExpander.Footer>
                                    <CalendarDatePicker x:Name="SingleWeekStartPicker" Width="120"/>
                                </ui:SettingsExpander.Footer>
                            </ui:SettingsExpander>

                            <ui:SettingsExpander Header="点击托盘图标行为"
                                                 Description="鼠标左键点击本应用托盘图标时进行的操作。无论此设置处于何种选项，鼠标右键点击托盘图标总是会打开主菜单。">
                                <ui:SettingsExpander.IconSource>
                                    <!-- Fluent AppsList 20 Filled -->
                                    <ui:PathIconSource>
                                        <ui:PathIconSource.Data>
                                            <StreamGeometry>M8 4.5a.5.5 0 0 1 .5-.5h9a.5.5 0 0 1 0 1h-9a.5.5 0 0 1-.5-.5m0 6a.5.5 0 0 1 .5-.5h9a.5.5 0 0 1 0 1h-9a.5.5 0 0 1-.5-.5m0 6a.5.5 0 0 1 .5-.5h9a.5.5 0 0 1 0 1h-9a.5.5 0 0 1-.5-.5m-6-1A1.5 1.5 0 0 1 3.5 14h1A1.5 1.5 0 0 1 6 15.5v1A1.5 1.5 0 0 1 4.5 18h-1A1.5 1.5 0 0 1 2 16.5zm0-6A1.5 1.5 0 0 1 3.5 8h1A1.5 1.5 0 0 1 6 9.5v1A1.5 1.5 0 0 1 4.5 12h-1A1.5 1.5 0 0 1 2 10.5zm0-6A1.5 1.5 0 0 1 3.5 2h1A1.5 1.5 0 0 1 6 3.5v1A1.5 1.5 0 0 1 4.5 6h-1A1.5 1.5 0 0 1 2 4.5z</StreamGeometry>
                                        </ui:PathIconSource.Data>
                                    </ui:PathIconSource>
                                </ui:SettingsExpander.IconSource>
                                <ui:SettingsExpander.Footer>
                                    <ComboBox x:Name="TrayBehaviorCombo" HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="显示 / 隐藏主界面"/>
                                        <ComboBoxItem Content="打开应用设置"/>
                                        <ComboBoxItem Content="打开档案编辑器"/>
                                    </ComboBox>
                                </ui:SettingsExpander.Footer>
                            </ui:SettingsExpander>

                            <ui:SettingsExpander Header="教学安全模式"
                                                 Description="启用后，如果应用发生意外崩溃，将自动按照右侧选择的方法处理崩溃，以确保教学不受到影响。如果发生的是不可忽略的异常，应用将自动退出。您可以在日志记录中查看崩溃详情。">
                                <ui:SettingsExpander.IconSource>
                                    <!-- Fluent MalwareDetected 16 Filled -->
                                    <ui:PathIconSource>
                                        <ui:PathIconSource.Data>
                                            <StreamGeometry>M7.647 2.146a.5.5 0 0 1 .708 0C9.595 3.39 10.969 4 12.5 4a.5.5 0 0 1 .5.5v3.001c0 3.219-1.641 5.406-4.842 6.473a.5.5 0 0 1-.316 0C4.642 12.907 3 10.72 3 7.501V4.5a.5.5 0 0 1 .5-.5c1.53 0 2.904-.611 4.147-1.854zM6.534 5.84a.5.5 0 0 0-.638.057l-.057.07a.5.5 0 0 0 .057.638L7.293 8L5.896 9.396l-.057.07a.5.5 0 0 0 .057.638l.07.057a.5.5 0 0 0 .638-.057L8 8.707l1.396 1.397l.07.057a.5.5 0 0 0 .638-.057l.057-.07a.5.5 0 0 0-.057-.638L8.707 8l1.397-1.396l.057-.07a.5.5 0 0 0-.057-.638l-.07-.057a.5.5 0 0 0-.638.057L8 7.293L6.604 5.896z</StreamGeometry>
                                        </ui:PathIconSource.Data>
                                    </ui:PathIconSource>
                                </ui:SettingsExpander.IconSource>
                                <ui:SettingsExpander.Footer>
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <ComboBox x:Name="SafeModeCombo" Width="160" SelectedIndex="0">
                                            <ComboBoxItem Content="显示崩溃报告"/>
                                            <ComboBoxItem Content="忽略并继续"/>
                                            <ComboBoxItem Content="重新启动应用"/>
                                        </ComboBox>
                                        <Border x:Name="SafeModeToggleHost" VerticalAlignment="Center"><ToggleSwitch/></Border>
                                    </StackPanel>
                                </ui:SettingsExpander.Footer>
                            </ui:SettingsExpander>

                            <!-- 「显示启动加载界面」与底部消息条已按需求删除 -->
                        </StackPanel>

                        <!-- ==================== 界面 ==================== -->
                        <StackPanel x:Name="PageInterface" Spacing="10" IsVisible="False">
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,2">
                                <ui:FontIcon Glyph="&#xEC4A;" FontSize="16" VerticalAlignment="Center" Opacity="0.85"/>
                                <TextBlock Text="外观" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>

                            <ui:SettingsExpander Header="主题" Description="跟随系统 / 浅色 / 深色">
                                <ui:SettingsExpander.IconSource>
                                    <ui:FontIconSource FontFamily="Segoe MDL2 Assets" Glyph="&#xE790;"/>
                                </ui:SettingsExpander.IconSource>
                                <ui:SettingsExpander.Footer>
                                    <!-- 多选一的设置一律用下拉框（照 CI 的 SettingsExpander.Footer + ComboBox 写法） -->
                                    <ComboBox x:Name="ThemeCombo" MinWidth="140">
                                        <ComboBoxItem Content="跟随系统"/>
                                        <ComboBoxItem Content="浅色"/>
                                        <ComboBoxItem Content="深色"/>
                                    </ComboBox>
                                </ui:SettingsExpander.Footer>
                            </ui:SettingsExpander>

                            <ui:SettingsExpander Header="主界面背景不透明度">
                                <ui:SettingsExpander.IconSource>
                                    <ui:FontIconSource FontFamily="Segoe MDL2 Assets" Glyph="&#xE71C;"/>
                                </ui:SettingsExpander.IconSource>
                                <ui:SettingsExpander.Footer>
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Slider x:Name="OpacitySlider" Minimum="0.1" Maximum="1" Width="240"
                                                TickFrequency="0.05" IsSnapToTickEnabled="True"/>
                                        <TextBlock x:Name="OpacityValueText" VerticalAlignment="Center" Opacity="0.7"/>
                                    </StackPanel>
                                </ui:SettingsExpander.Footer>
                            </ui:SettingsExpander>

                            <ui:SettingsExpander Header="全局字号缩放">
                                <ui:SettingsExpander.IconSource>
                                    <ui:FontIconSource FontFamily="Segoe MDL2 Assets" Glyph="&#xE8D2;"/>
                                </ui:SettingsExpander.IconSource>
                                <ui:SettingsExpander.Footer>
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Slider x:Name="FontScaleSlider" Minimum="0.8" Maximum="1.6" Width="240"
                                                TickFrequency="0.05" IsSnapToTickEnabled="True"/>
                                        <TextBlock x:Name="FontScaleValueText" VerticalAlignment="Center" Opacity="0.7"/>
                                    </StackPanel>
                                </ui:SettingsExpander.Footer>
                            </ui:SettingsExpander>

                            <ui:SettingsExpander Header="主界面缩放"
                                                 Description="对应 CI 的「主界面缩放」（CI 默认 1.9），整体放大主界面">
                                <ui:SettingsExpander.IconSource>
                                    <ui:FontIconSource FontFamily="Segoe MDL2 Assets" Glyph="&#xE71E;"/>
                                </ui:SettingsExpander.IconSource>
                                <ui:SettingsExpander.Footer>
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Slider x:Name="MainWindowScaleSlider" Minimum="0.6" Maximum="3.0" Width="240"
                                                TickFrequency="0.05" IsSnapToTickEnabled="True"/>
                                        <TextBlock x:Name="MainWindowScaleValueText" VerticalAlignment="Center" Opacity="0.7"/>
                                    </StackPanel>
                                </ui:SettingsExpander.Footer>
                            </ui:SettingsExpander>
                        </StackPanel>

                        <!-- ==================== 窗口（对照 CI WindowSettingsPage） ==================== -->
                        <StackPanel x:Name="PageWindow" Spacing="10" IsVisible="False">
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,2">
                                <ui:FontIcon Glyph="&#xE740;" FontSize="16" VerticalAlignment="Center" Opacity="0.85"/>
                                <TextBlock Text="窗口" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>

                            <ui:SettingsExpander Header="组件排列方向">
                                <ui:SettingsExpander.IconSource>
                                    <ui:FontIconSource FontFamily="Segoe MDL2 Assets" Glyph="&#xE700;"/>
                                </ui:SettingsExpander.IconSource>
                                <ui:SettingsExpander.Footer>
                                    <ComboBox x:Name="OrientationCombo" HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="横向"/>
                                        <ComboBoxItem Content="纵向"/>
                                    </ComboBox>
                                </ui:SettingsExpander.Footer>
                            </ui:SettingsExpander>

                            <ui:SettingsExpander Header="鼠标穿透"
                                                 Description="开启后鼠标点击会直接落到主界面后方的窗口；鼠标移入主界面自动淡化">
                                <ui:SettingsExpander.IconSource>
                                    <ui:FontIconSource FontFamily="Segoe MDL2 Assets" Glyph="&#xE7C9;"/>
                                </ui:SettingsExpander.IconSource>
                                <ui:SettingsExpander.Footer>
                                    <CheckBox x:Name="ClickThroughSwitch"/>
                                </ui:SettingsExpander.Footer>
                            </ui:SettingsExpander>
                        </StackPanel>

                        <!-- ==================== 主界面组件 ==================== -->
                        <StackPanel x:Name="PageWidgets" Spacing="10" IsVisible="False">
                            <TextBlock Text="决定悬浮主界面上显示哪些内容。双击组件卡片添加；点组件右侧「⋯」上移/下移/删除。"
                                       Opacity="0.7" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,4"/>

                            <Border CornerRadius="6" Padding="4"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <ListBox x:Name="WidgetList" BorderThickness="0" Background="Transparent"
                                         MinHeight="44" SelectionMode="Single">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="2"/>
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <ui:FontIcon FontFamily="Segoe MDL2 Assets"
                                                             Glyph="{Binding Glyph}" FontSize="14" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                                <Button Content="⋯" Padding="6,0" ToolTip.Tip="更多选项" Click="OnWidgetItemMore">
                                                    <Button.Flyout>
                                                        <MenuFlyout>
                                                            <MenuItem Header="上移" Click="OnWidgetItemMoveUp"/>
                                                            <MenuItem Header="下移" Click="OnWidgetItemMoveDown"/>
                                                            <Separator/>
                                                            <MenuItem Header="删除" Click="OnWidgetItemDelete"/>
                                                        </MenuFlyout>
                                                    </Button.Flyout>
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>

                            <TabControl HorizontalContentAlignment="Stretch" Padding="0">
                                <TabItem Header="组件库">
                                    <StackPanel Spacing="10" Margin="0,10,0,0">
                                        <!-- 照 CI ComponentsSettingsPage 组件库：WrapPanel 的 ListBox，
                                             条目=图标+名称+描述，选中项左侧出现 Fluent 强调色小竖线 -->
                                        <ListBox x:Name="WidgetLibraryList" BorderThickness="0" Background="Transparent"
                                                 SelectionMode="Single" MinHeight="44">
                                            <ListBox.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ListBox.ItemsPanel>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid ColumnDefinitions="Auto,*" Height="54" Margin="0,2,16,8">
                                                        <ui:FontIcon FontFamily="Segoe MDL2 Assets" Glyph="{Binding Glyph}"
                                                                     FontSize="28" VerticalAlignment="Center" Margin="2,0,12,0"/>
                                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding DisplayName}" FontSize="14"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding Description}" FontSize="12" Opacity="0.7"
                                                                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <Button x:Name="ResetWidgetButton" Content="恢复默认布局"/>
                                    </StackPanel>
                                </TabItem>
                                <TabItem Header="组件设置">
                                    <ScrollViewer Margin="0,10,0,0">
                                        <StackPanel x:Name="WidgetEditor" Spacing="8" IsEnabled="False">
                                            <TextBlock x:Name="WidgetTypeText" FontSize="12" Opacity="0.7" TextWrapping="Wrap"/>

                                            <ui:SettingsExpander Header="启用该组件">
                                                <ui:SettingsExpander.Footer>
                                                    <CheckBox x:Name="WidgetEnabledCheck"/>
                                                </ui:SettingsExpander.Footer>
                                            </ui:SettingsExpander>

                                            <ui:SettingsExpander Header="字号缩放">
                                                <ui:SettingsExpander.Footer>
                                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                                        <Slider x:Name="WidgetFontSlider" Minimum="0.6" Maximum="2.0"
                                                                Width="200" TickFrequency="0.05" IsSnapToTickEnabled="True"/>
                                                        <TextBlock x:Name="WidgetFontValueText" VerticalAlignment="Center" Opacity="0.7"/>
                                                    </StackPanel>
                                                </ui:SettingsExpander.Footer>
                                            </ui:SettingsExpander>

                                            <!-- 组件**专属**设置：按选中组件的类型动态构建，
                                                 对照 CI 的 Controls/Components/XxxComponentSettingsControl.axaml
                                                 （CI 里 Date/Separator 等组件没有设置控件 → 这里也没有设置项） -->
                                            <StackPanel x:Name="WidgetSettingsPanel" Spacing="8"/>
                                            <TextBlock x:Name="WidgetNoSettingsText"
                                                       Text="该组件没有专属设置。"
                                                       FontSize="12" Opacity="0.7" Margin="4,2,0,0"
                                                       IsVisible="False"/>
                                        </StackPanel>
                                    </ScrollViewer>
                                </TabItem>
                            </TabControl>
                        </StackPanel>

                        <!-- ==================== 关于（对照 CI AboutSettingsPage） ==================== -->
                        <StackPanel x:Name="PageAbout" Spacing="10" IsVisible="False">
                            <ui:SettingsExpander x:Name="AboutExpander" Header="ClassNEX" IsExpanded="True">
                                <ui:SettingsExpander.IconSource>
                                    <ui:ImageIconSource Source="/Assets/icon.ico"/>
                                </ui:SettingsExpander.IconSource>
                                <ui:SettingsExpander.Items>
                                    <StackPanel Spacing="12" Margin="0,4,0,0">
                                        <!-- 版本号单独一行（用户要求：不要放在右上角的 Footer 里） -->
                                        <TextBlock x:Name="AboutVersionText" FontSize="14"
                                                   PointerPressed="OnVersionPointerPressed"
                                                   ToolTip.Tip="连点 10 次解锁调试菜单"/>
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="Copyright (c) 2026 ClassNEX"/>
                                                <TextBlock Text="本项目基于 GNU General Public License v3.0 获得许可。"
                                                           FontSize="12" Opacity="0.7" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16"
                                                        VerticalAlignment="Center">
                                                <Button Content="开放源代码许可" Click="OnOpenLicense"/>
                                                <Button Content="隐私政策" Click="OnOpenPrivacyPolicy"/>
                                            </StackPanel>
                                        </Grid>
                                        <Separator/>
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="常用链接" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16"
                                                        VerticalAlignment="Center">
                                                <Button Content="项目主页" Click="OnOpenHomePage"/>
                                                <Button Content="GitHub" Click="OnOpenHomePage"/>
                                                <Button Content="反馈问题" Click="OnOpenIssues"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </ui:SettingsExpander.Items>
                            </ui:SettingsExpander>
                        </StackPanel>

                        <!-- ==================== 调试（对照 CI DebugPage；默认隐藏，点关于页版本号 10 次解锁） ==================== -->
                        <StackPanel x:Name="PageDebug" Spacing="10" IsVisible="False">
                            <ui:InfoBar Severity="Error" Title="仅供调试"
                                        Message="除非你知道自己在做什么，否则请不要使用下面的按钮。"
                                        IsOpen="True" IsClosable="False"/>
                            <ui:SettingsExpander Header="通知测试" Description="直接触发各类提醒，用于检查效果（不依赖当前课表状态）">
                                <ui:SettingsExpander.IconSource>
                                    <ui:FontIconSource FontFamily="Segoe MDL2 Assets" Glyph="&#xE838;"/>
                                </ui:SettingsExpander.IconSource>
                                <ui:SettingsExpanderItem x:Name="DebugTriggerClassOnItem" Content="触发上课提醒" IsClickEnabled="True"/>
                                <ui:SettingsExpanderItem x:Name="DebugTriggerClassOffItem" Content="触发下课提醒" IsClickEnabled="True"/>
                            </ui:SettingsExpander>
                            <ui:SettingsExpander Header="调试菜单">
                                <ui:SettingsExpander.IconSource>
                                    <ui:FontIconSource FontFamily="Segoe MDL2 Assets" Glyph="&#xE7C4;"/>
                                </ui:SettingsExpander.IconSource>
                                <ui:SettingsExpanderItem x:Name="DebugCloseItem" Content="关闭调试菜单（隐藏本页）" IsClickEnabled="True"/>
                            </ui:SettingsExpander>

                            <!-- NEX 的接口配置只放在这里：普通界面不显示密钥，留空即自动使用内置接口 -->
                            <ui:SettingsExpander Header="NEX Intelligence 接口"
                                                 Description="留空则使用内置接口（开箱可用）。填入你自己的地址/密钥就会覆盖内置的；密钥框不会回显内置密钥明文。">
                                <ui:SettingsExpander.IconSource>
                                    <ui:FontIconSource FontFamily="Segoe MDL2 Assets" Glyph="&#xE968;"/>
                                </ui:SettingsExpander.IconSource>
                                <ui:SettingsExpanderItem Content="服务地址" Description="留空 = 内置地址">
                                    <ui:SettingsExpanderItem.Footer>
                                        <TextBox x:Name="NexBaseUrlBox" Width="320" Watermark="留空使用内置接口"/>
                                    </ui:SettingsExpanderItem.Footer>
                                </ui:SettingsExpanderItem>
                                <ui:SettingsExpanderItem Content="接口密钥" Description="留空 = 使用内置密钥；填写后只保存你自己的密钥">
                                    <ui:SettingsExpanderItem.Footer>
                                        <TextBox x:Name="NexApiKeyBox" Width="320" PasswordChar="•" Watermark="留空使用内置密钥"/>
                                    </ui:SettingsExpanderItem.Footer>
                                </ui:SettingsExpanderItem>
                                <ui:SettingsExpanderItem Content="模型" Description="留空 = 内置模型；点「拉取模型」从接口读取可用列表">
                                    <ui:SettingsExpanderItem.Footer>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <ComboBox x:Name="NexModelCombo" Width="240" IsEditable="True"/>
                                            <Button x:Name="NexFetchModelsButton" Content="拉取模型"/>
                                        </StackPanel>
                                    </ui:SettingsExpanderItem.Footer>
                                </ui:SettingsExpanderItem>
                                <ui:SettingsExpanderItem Content="测试与重置" Description="测试当前配置能否连通；重置会清掉自定义配置、回到内置接口">
                                    <ui:SettingsExpanderItem.Footer>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button x:Name="NexTestButton" Content="测试连接"/>
                                            <Button x:Name="NexResetButton" Content="恢复内置接口"/>
                                            <TextBlock x:Name="NexStatusText" VerticalAlignment="Center" FontSize="13"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                    </ui:SettingsExpanderItem.Footer>
                                </ui:SettingsExpanderItem>
                            </ui:SettingsExpander>
                        </StackPanel>

                        <!-- ==================== 账户 ==================== -->
                        <StackPanel x:Name="PageAccount" Spacing="10" IsVisible="False">
                            <!-- 账户卡：照 FluentUI-Gallery 账户页（Win11 默认头像 + 强调色圆环 + 名称 + 邮箱） -->
                            <Border CornerRadius="8" Padding="20" BorderThickness="1"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                                <StackPanel Orientation="Horizontal" Spacing="18">
                                    <!-- 同上：用 Background 画头像，保证是正圆而不是四个角 -->
                                    <Border x:Name="AccountPageAvatarRing" Width="88" Height="88" CornerRadius="44"
                                            BorderThickness="5"/>
                                    <StackPanel VerticalAlignment="Center" Spacing="4">
                                        <TextBlock x:Name="AccountPageNameText" FontSize="24" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="AccountPageEmailText" FontSize="14" Opacity="0.65"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <ui:SettingsExpander Header="头像" Description="支持 PNG / JPG / BMP / WebP，上传后会复制到应用数据目录">
                                <ui:SettingsExpander.IconSource>
                                    <ui:FontIconSource FontFamily="Segoe MDL2 Assets" Glyph="&#xE91B;"/>
                                </ui:SettingsExpander.IconSource>
                                <ui:SettingsExpander.Footer>
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Button x:Name="ChangeAvatarButton" Content="更换头像…" Click="OnChangeAvatar"/>
                                        <Button x:Name="ResetAvatarButton" Content="恢复默认" Click="OnResetAvatar"/>
                                    </StackPanel>
                                </ui:SettingsExpander.Footer>
                            </ui:SettingsExpander>

                            <ui:SettingsExpander Header="用户名" Description="显示在账户区的名称">
                                <ui:SettingsExpander.IconSource>
                                    <ui:FontIconSource FontFamily="Segoe MDL2 Assets" Glyph="&#xE77B;"/>
                                </ui:SettingsExpander.IconSource>
                                <ui:SettingsExpander.Footer>
                                    <TextBox x:Name="UserNameBox" Width="300" Watermark="输入用户名"/>
                                </ui:SettingsExpander.Footer>
                            </ui:SettingsExpander>

                            <ui:SettingsExpander Header="邮箱" Description="显示在账户区的邮箱地址">
                                <ui:SettingsExpander.IconSource>
                                    <ui:FontIconSource FontFamily="Segoe MDL2 Assets" Glyph="&#xE715;"/>
                                </ui:SettingsExpander.IconSource>
                                <ui:SettingsExpander.Footer>
                                    <TextBox x:Name="EmailBox" Width="300" Watermark="输入邮箱"/>
                                </ui:SettingsExpander.Footer>
                            </ui:SettingsExpander>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </ui:NavigationView>

        <!-- 搜索结果：挂在顶栏搜索框正下方（Win11 设置同款下拉；放在导航之后 = 绘制在最上层） -->
        <Border x:Name="SearchResultsPanel" Grid.Row="1" IsVisible="False" MaxHeight="300"
                Width="420" HorizontalAlignment="Center" VerticalAlignment="Top"
                Margin="0,4,0,0"
                CornerRadius="8" BorderThickness="1"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
            <ListBox x:Name="SearchResults" BorderThickness="0" Background="Transparent">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Spacing="1">
                            <TextBlock Text="{Binding Title}" FontSize="13"/>
                            <TextBlock Text="{Binding PageName}" FontSize="11" Opacity="0.6"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </Grid>
</wd:AppWindow>
