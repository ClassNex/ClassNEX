<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="using:AvaloniaFluentUI.Controls"
        mc:Ignorable="d" d:DesignWidth="1240" d:DesignHeight="620"
        x:Class="ClassNex.Views.SettingsWindow"
        Title="应用设置"
        Icon="/Assets/icon.ico"
        Width="1240" Height="620"
        MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen">

    <!-- 结构 1:1 对照 CI 的 Views/SettingsWindowNew.axaml + SettingPages/*：
         顶栏(48) + NavigationView(PaneHeader 账户块 + MenuItems 图标) + 页面标题行 + 页面。
         每个设置项 = SettingsExpander(IconSource + Header + Description + Footer 常显控件)。 -->
    <Grid RowDefinitions="48,*">
        <!-- ============ 顶栏（CI：Border Height=48） ============ -->
        <Border Grid.Row="0" Height="48"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="14,0,10,0">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Image Source="/Assets/icon.ico" Width="18" Height="18"
                           IsHitTestVisible="False" RenderOptions.BitmapInterpolationMode="HighQuality"/>
                    <TextBlock Text="应用设置" FontSize="12" VerticalAlignment="Center" IsHitTestVisible="False"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock x:Name="VersionText" FontSize="12" VerticalAlignment="Center"
                               ToolTip.Tip="应用版本"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <Button x:Name="MoreOptionsButton" Theme="{StaticResource TransparentButton}"
                            VerticalAlignment="Center" ToolTip.Tip="更多选项…">
                        <ui:FontIcon Glyph="&#xEBAC;" FontSize="14"/>
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuItem Header="打开数据目录…" Click="OnOpenDataFolder">
                                    <MenuItem.Icon><ui:FontIcon Glyph="&#xE838;"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="打开日志文件…" Click="OnOpenLogFile">
                                    <MenuItem.Icon><ui:FontIcon Glyph="&#xE9D9;"/></MenuItem.Icon>
                                </MenuItem>
                                <Separator/>
                                <MenuItem Header="关于 ClassNEX" Click="OnShowAbout">
                                    <MenuItem.Icon><ui:FontIcon Glyph="&#xE946;"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="重启 ClassNEX" Click="OnRestartApp">
                                    <MenuItem.Icon><ui:FontIcon Glyph="&#xE777;"/></MenuItem.Icon>
                                </MenuItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ 主体导航 ============ -->
        <ui:NavigationView Grid.Row="1" x:Name="NavView"
                           PaneDisplayMode="Left" OpenPaneLength="283"
                           IsBackButtonVisible="False" IsSettingsVisible="False"
                           IsPaneToggleButtonVisible="False">

            <ui:NavigationView.PaneHeader>
                <Button x:Name="AccountButton" Margin="6,10,6,4" Padding="8" CornerRadius="4"
                        Background="Transparent" BorderThickness="0"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Click="OnAccountClick" ToolTip.Tip="账户">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Width="40" Height="40" CornerRadius="20"
                                Background="{DynamicResource AccentFillColorDefaultBrush}">
                            <ui:FontIcon Glyph="&#xE77B;" FontSize="18"
                                         Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="1">
                            <TextBlock x:Name="AccountNameText" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="本地账户" FontSize="12" Opacity="0.6"/>
                        </StackPanel>
                    </StackPanel>
                </Button>
            </ui:NavigationView.PaneHeader>

            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="通用">
                    <ui:NavigationViewItem.IconSource>
                        <ui:FontIconSource FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xE713;" FontSize="16"/>
                    </ui:NavigationViewItem.IconSource>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="界面">
                    <ui:NavigationViewItem.IconSource>
                        <ui:FontIconSource FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xE51E;" FontSize="16"/>
                    </ui:NavigationViewItem.IconSource>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="主界面组件">
                    <ui:NavigationViewItem.IconSource>
                        <ui:FontIconSource FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xE06F;" FontSize="16"/>
                    </ui:NavigationViewItem.IconSource>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="课表">
                    <ui:NavigationViewItem.IconSource>
                        <ui:FontIconSource FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xE787;" FontSize="16"/>
                    </ui:NavigationViewItem.IconSource>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="关于">
                    <ui:NavigationViewItem.IconSource>
                        <ui:FontIconSource FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xE9E4;" FontSize="16"/>
                    </ui:NavigationViewItem.IconSource>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="账户">
                    <ui:NavigationViewItem.IconSource>
                        <ui:FontIconSource FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xE77B;" FontSize="16"/>
                    </ui:NavigationViewItem.IconSource>
                </ui:NavigationViewItem>
            </ui:NavigationView.MenuItems>

            <Grid RowDefinitions="Auto,*">
                <TextBlock x:Name="PageTitleText" Grid.Row="0" FontSize="28"
                           Margin="32,24,32,0" HorizontalAlignment="Left"/>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="32,12,32,24" Spacing="12" MaxWidth="880" HorizontalAlignment="Left">

                        <!-- ==================== 通用 ==================== -->
                        <StackPanel x:Name="PageGeneral" Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,2">
                                <ui:FontIcon Glyph="&#xE84F;" FontSize="16" VerticalAlignment="Center" Opacity="0.85"/>
                                <TextBlock Text="行为" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>

                            <ui:SettingsExpander Header="单周开始日期"
                                                 Description="该日期所在周视为单周，用于推算当前是单周还是双周">
                                <ui:SettingsExpander.IconSource>
                                    <ui:FontIconSource FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xE304;"/>
                                </ui:SettingsExpander.IconSource>
                                <ui:SettingsExpander.Footer>
                                    <DatePicker x:Name="SingleWeekStartPicker" HorizontalAlignment="Stretch"/>
                                </ui:SettingsExpander.Footer>
                            </ui:SettingsExpander>

                            <ui:SettingsExpander Header="点击托盘图标行为"
                                                 Description="单击托盘图标时执行的操作">
                                <ui:SettingsExpander.IconSource>
                                    <ui:FontIconSource FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xE713;"/>
                                </ui:SettingsExpander.IconSource>
                                <ui:SettingsExpander.Footer>
                                    <ComboBox x:Name="TrayBehaviorCombo" HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="显示 / 隐藏主界面"/>
                                        <ComboBoxItem Content="打开应用设置"/>
                                        <ComboBoxItem Content="打开档案编辑器"/>
                                    </ComboBox>
                                </ui:SettingsExpander.Footer>
                            </ui:SettingsExpander>
                        </StackPanel>

                        <!-- ==================== 界面 ==================== -->
                        <StackPanel x:Name="PageInterface" Spacing="10" IsVisible="False">
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,2">
                                <ui:FontIcon Glyph="&#xEC4A;" FontSize="16" VerticalAlignment="Center" Opacity="0.85"/>
                                <TextBlock Text="外观" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>

                            <ui:SettingsExpander Header="主题" Description="跟随系统 / 浅色 / 深色">
                                <ui:SettingsExpander.IconSource>
                                    <ui:FontIconSource FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xE5CB;"/>
                                </ui:SettingsExpander.IconSource>
                                <ui:SettingsExpander.Footer>
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <RadioButton x:Name="ThemeSystem" GroupName="Theme" Content="跟随系统"/>
                                        <RadioButton x:Name="ThemeLight" GroupName="Theme" Content="浅色"/>
                                        <RadioButton x:Name="ThemeDark" GroupName="Theme" Content="深色"/>
                                    </StackPanel>
                                </ui:SettingsExpander.Footer>
                            </ui:SettingsExpander>

                            <ui:SettingsExpander Header="主界面背景不透明度">
                                <ui:SettingsExpander.IconSource>
                                    <ui:FontIconSource FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xF37D;"/>
                                </ui:SettingsExpander.IconSource>
                                <ui:SettingsExpander.Footer>
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Slider x:Name="OpacitySlider" Minimum="0.1" Maximum="1" Width="240"
                                                TickFrequency="0.05" IsSnapToTickEnabled="True"/>
                                        <TextBlock x:Name="OpacityValueText" VerticalAlignment="Center" Opacity="0.7"/>
                                    </StackPanel>
                                </ui:SettingsExpander.Footer>
                            </ui:SettingsExpander>

                            <ui:SettingsExpander Header="全局字号缩放">
                                <ui:SettingsExpander.IconSource>
                                    <ui:FontIconSource FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xF273;"/>
                                </ui:SettingsExpander.IconSource>
                                <ui:SettingsExpander.Footer>
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Slider x:Name="FontScaleSlider" Minimum="0.8" Maximum="1.6" Width="240"
                                                TickFrequency="0.05" IsSnapToTickEnabled="True"/>
                                        <TextBlock x:Name="FontScaleValueText" VerticalAlignment="Center" Opacity="0.7"/>
                                    </StackPanel>
                                </ui:SettingsExpander.Footer>
                            </ui:SettingsExpander>

                            <ui:SettingsExpander Header="主界面缩放"
                                                 Description="对应 CI 的「主界面缩放」（CI 默认 1.9），整体放大主界面">
                                <ui:SettingsExpander.IconSource>
                                    <ui:FontIconSource FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xF4D1;"/>
                                </ui:SettingsExpander.IconSource>
                                <ui:SettingsExpander.Footer>
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Slider x:Name="MainWindowScaleSlider" Minimum="0.6" Maximum="3.0" Width="240"
                                                TickFrequency="0.05" IsSnapToTickEnabled="True"/>
                                        <TextBlock x:Name="MainWindowScaleValueText" VerticalAlignment="Center" Opacity="0.7"/>
                                    </StackPanel>
                                </ui:SettingsExpander.Footer>
                            </ui:SettingsExpander>

                            <ui:SettingsExpander Header="组件排列方向">
                                <ui:SettingsExpander.IconSource>
                                    <ui:FontIconSource FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xE6EF;"/>
                                </ui:SettingsExpander.IconSource>
                                <ui:SettingsExpander.Footer>
                                    <ComboBox x:Name="OrientationCombo" HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="横向"/>
                                        <ComboBoxItem Content="纵向"/>
                                    </ComboBox>
                                </ui:SettingsExpander.Footer>
                            </ui:SettingsExpander>

                            <ui:SettingsExpander Header="鼠标穿透"
                                                 Description="开启后鼠标点击会直接落到主界面后方的窗口；鼠标移入主界面自动淡化">
                                <ui:SettingsExpander.IconSource>
                                    <ui:FontIconSource FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xE962;"/>
                                </ui:SettingsExpander.IconSource>
                                <ui:SettingsExpander.Footer>
                                    <CheckBox x:Name="ClickThroughCheck" Content="启用鼠标穿透"/>
                                </ui:SettingsExpander.Footer>
                            </ui:SettingsExpander>
                        </StackPanel>

                        <!-- ==================== 主界面组件 ==================== -->
                        <StackPanel x:Name="PageWidgets" Spacing="10" IsVisible="False">
                            <TextBlock Text="决定悬浮主界面上显示哪些内容。双击组件卡片添加；点组件右侧「⋯」上移/下移/删除。"
                                       Opacity="0.7" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,4"/>

                            <Border CornerRadius="6" Padding="4"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <ListBox x:Name="WidgetList" BorderThickness="0" Background="Transparent"
                                         MinHeight="44" SelectionMode="Single">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="2"/>
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <ui:FontIcon FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                             Glyph="{Binding Glyph}" FontSize="14" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                                <Button Content="⋯" Padding="6,0" ToolTip.Tip="更多选项" Click="OnWidgetItemMore">
                                                    <Button.Flyout>
                                                        <MenuFlyout>
                                                            <MenuItem Header="上移" Click="OnWidgetItemMoveUp"/>
                                                            <MenuItem Header="下移" Click="OnWidgetItemMoveDown"/>
                                                            <Separator/>
                                                            <MenuItem Header="删除" Click="OnWidgetItemDelete"/>
                                                        </MenuFlyout>
                                                    </Button.Flyout>
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>

                            <TabControl HorizontalContentAlignment="Stretch" Padding="0">
                                <TabItem Header="组件库">
                                    <StackPanel Spacing="10" Margin="0,10,0,0">
                                        <WrapPanel x:Name="WidgetLibraryPanel"/>
                                        <Button x:Name="ResetWidgetButton" Content="恢复默认布局"/>
                                    </StackPanel>
                                </TabItem>
                                <TabItem Header="组件设置">
                                    <ScrollViewer Margin="0,10,0,0">
                                        <StackPanel x:Name="WidgetEditor" Spacing="8" IsEnabled="False">
                                            <TextBlock x:Name="WidgetTypeText" FontSize="12" Opacity="0.7" TextWrapping="Wrap"/>

                                            <ui:SettingsExpander Header="启用该组件">
                                                <ui:SettingsExpander.Footer>
                                                    <CheckBox x:Name="WidgetEnabledCheck"/>
                                                </ui:SettingsExpander.Footer>
                                            </ui:SettingsExpander>

                                            <ui:SettingsExpander Header="字号缩放">
                                                <ui:SettingsExpander.Footer>
                                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                                        <Slider x:Name="WidgetFontSlider" Minimum="0.6" Maximum="2.0"
                                                                Width="200" TickFrequency="0.05" IsSnapToTickEnabled="True"/>
                                                        <TextBlock x:Name="WidgetFontValueText" VerticalAlignment="Center" Opacity="0.7"/>
                                                    </StackPanel>
                                                </ui:SettingsExpander.Footer>
                                            </ui:SettingsExpander>

                                            <ui:SettingsExpander Header="时钟组件显示秒">
                                                <ui:SettingsExpander.Footer>
                                                    <CheckBox x:Name="WidgetSecondsCheck"/>
                                                </ui:SettingsExpander.Footer>
                                            </ui:SettingsExpander>

                                            <ui:SettingsExpander Header="自定义文本（仅「文本」组件）"
                                                                 Description="占位符：{date} {day} {time} {parity} {current} {next} {countdown}">
                                                <ui:SettingsExpander.Footer>
                                                    <TextBox x:Name="WidgetTextBox" Width="300" AcceptsReturn="True" TextWrapping="Wrap"/>
                                                </ui:SettingsExpander.Footer>
                                            </ui:SettingsExpander>
                                        </StackPanel>
                                    </ScrollViewer>
                                </TabItem>
                            </TabControl>
                        </StackPanel>

                        <!-- ==================== 课表 ==================== -->
                        <StackPanel x:Name="PageSchedule" Spacing="10" IsVisible="False">
                            <ui:SettingsExpander Header="当前课表文件" Description="支持 CSES 课程表交换格式（YAML）">
                                <ui:SettingsExpander.IconSource>
                                    <ui:FontIconSource FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xE8A5;"/>
                                </ui:SettingsExpander.IconSource>
                                <ui:SettingsExpander.Footer>
                                    <StackPanel Spacing="10">
                                        <TextBlock x:Name="TimetableFileText" TextWrapping="Wrap" FontSize="12" Opacity="0.75"/>
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <Button x:Name="OpenTimetableButton" Content="打开课表文件…"/>
                                            <Button x:Name="ReloadTimetableButton" Content="重新加载"/>
                                        </StackPanel>
                                    </StackPanel>
                                </ui:SettingsExpander.Footer>
                            </ui:SettingsExpander>

                            <ui:InfoBar IsOpen="True" Severity="Informational" IsClosable="False"
                                        Title="排课与节次编辑"
                                        Message="请在「档案编辑器」中编辑课表与时间表（托盘菜单 → 编辑档案…）。"/>
                        </StackPanel>

                        <!-- ==================== 关于 ==================== -->
                        <StackPanel x:Name="PageAbout" Spacing="10" IsVisible="False">
                            <ui:SettingsExpander x:Name="AboutExpander" Header="ClassNEX 桌面客户端" IsExpanded="True">
                                <ui:SettingsExpander.IconSource>
                                    <ui:ImageIconSource Source="/Assets/icon.ico"/>
                                </ui:SettingsExpander.IconSource>
                                <ui:SettingsExpander.Footer>
                                    <StackPanel Spacing="6">
                                        <TextBlock x:Name="AboutVersionText" TextWrapping="Wrap" FontWeight="SemiBold"/>
                                        <TextBlock TextWrapping="Wrap" Opacity="0.75"
                                                   Text="主界面（悬浮组件课表）、应用设置、档案编辑器、系统托盘。&#10;课表采用 CSES 课程表交换格式；界面使用 AvaloniaFluentUI（Fluent 控件）；配色与交互参照 CI（ClassIsland）。"/>
                                    </StackPanel>
                                </ui:SettingsExpander.Footer>
                            </ui:SettingsExpander>
                        </StackPanel>

                        <!-- ==================== 账户 ==================== -->
                        <StackPanel x:Name="PageAccount" Spacing="10" IsVisible="False">
                            <ui:SettingsExpander Header="用户名" Description="显示在设置窗口左侧账户块中的名称">
                                <ui:SettingsExpander.IconSource>
                                    <ui:FontIconSource FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xE77B;"/>
                                </ui:SettingsExpander.IconSource>
                                <ui:SettingsExpander.Footer>
                                    <TextBox x:Name="UserNameBox" Width="300" Watermark="输入用户名"/>
                                </ui:SettingsExpander.Footer>
                            </ui:SettingsExpander>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </ui:NavigationView>

        <!-- ============ 顶栏中央搜索 ============ -->
        <Grid Grid.Row="0" Grid.RowSpan="2"
              Width="440" HorizontalAlignment="Center" VerticalAlignment="Top"
              Margin="0,8,0,0" ZIndex="100">
            <Border Height="32" CornerRadius="4"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    Background="{DynamicResource ControlFillColorDefaultBrush}">
                <TextBox x:Name="SearchBox"
                         BorderThickness="0" Background="Transparent"
                         Watermark="查找设置"
                         VerticalAlignment="Center" VerticalContentAlignment="Center"
                         Margin="2,0,2,0">
                    <TextBox.InnerLeftContent>
                        <ui:FontIcon Glyph="&#xE721;" FontSize="12" Margin="8,0,6,0"
                                     VerticalAlignment="Center" Opacity="0.7"/>
                    </TextBox.InnerLeftContent>
                </TextBox>
            </Border>

            <Border x:Name="SearchResultsPanel" IsVisible="False"
                    Margin="0,36,0,0" VerticalAlignment="Top"
                    CornerRadius="4" BorderThickness="1" MaxHeight="380"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
                <ListBox x:Name="SearchResults" BorderThickness="0" Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Spacing="1">
                                <TextBlock Text="{Binding Title}" FontSize="13"/>
                                <TextBlock Text="{Binding PageName}" FontSize="11" Opacity="0.6"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Grid>
    </Grid>
</Window>
