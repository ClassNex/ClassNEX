<wd:AppWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="using:AvaloniaFluentUI.Controls"
        xmlns:wd="using:AvaloniaFluentUI.Windowing"
        mc:Ignorable="d" d:DesignWidth="460" d:DesignHeight="720"
        x:Class="ClassNex.Views.LoginWindow"
        Title="ClassNEX 账户"
        Icon="/Assets/icon.ico"
        TitleBarHeight="48"
        IsTitleBarContentVisible="False"
        Width="460" Height="720"
        CanResize="False"
        WindowStartupLocation="CenterScreen">

    <StackPanel Margin="36,24,36,24" Spacing="16">

        <StackPanel Spacing="8">
            <TextBlock Text="ClassNEX 账户" FontSize="22" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            <TextBlock Text="登录后，头像、用户名与邮箱会从账户服务同步到本机。"
                       TextWrapping="Wrap" Opacity="0.75"/>
        </StackPanel>

        <StackPanel x:Name="StateForm" Spacing="14">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="ModeLoginButton" Content="登录" Classes="Primary" MinWidth="72"/>
                <Button x:Name="ModeSignupButton" Content="注册" MinWidth="72"/>
            </StackPanel>

            <StackPanel x:Name="LoginForm" Spacing="10">
                <TextBox x:Name="LoginAccountBox" Watermark="用户名" FontSize="14"/>
                <TextBox x:Name="LoginPasswordBox" Watermark="密码" PasswordChar="●" FontSize="14"/>
                <Button x:Name="SignInButton" Content="登录" Classes="Primary" HorizontalAlignment="Stretch"/>
                <TextBlock x:Name="LoginStatusText" FontSize="12" TextWrapping="Wrap" Opacity="0.8"/>
            </StackPanel>

            <StackPanel x:Name="SignupForm" IsVisible="False" Spacing="10">
                <TextBox x:Name="SignupUsernameBox" Watermark="用户名" FontSize="14"/>
                <TextBox x:Name="SignupDisplayNameBox" Watermark="显示名（可选）" FontSize="14"/>
                <TextBox x:Name="SignupEmailBox" Watermark="邮箱" FontSize="14"/>
                <TextBox x:Name="SignupPasswordBox" Watermark="密码" PasswordChar="●" FontSize="14"/>
                <TextBox x:Name="SignupConfirmBox" Watermark="确认密码" PasswordChar="●" FontSize="14"/>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox x:Name="SignupCodeBox" Watermark="邮箱验证码" FontSize="14"/>
                    <Button Grid.Column="1" x:Name="SendCodeButton" Content="发送验证码" MinWidth="104"/>
                </Grid>
                <TextBlock x:Name="SignupStatusText" FontSize="12" TextWrapping="Wrap" Opacity="0.8"/>
                <Button x:Name="SignUpButton" Content="创建账户" Classes="Primary" HorizontalAlignment="Stretch"/>
            </StackPanel>
        </StackPanel>

        <StackPanel x:Name="StateDone" IsVisible="False" Spacing="12">
            <Border CornerRadius="8" Padding="20" BorderThickness="1"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <Border x:Name="DoneAvatar" Width="64" Height="64" CornerRadius="16"
                                BorderThickness="3"/>
                        <StackPanel VerticalAlignment="Center" Spacing="4">
                            <TextBlock x:Name="DoneNameText" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock x:Name="DoneEmailText" FontSize="13" Opacity="0.7"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="登录成功，账号信息已同步到本机。"
                               FontSize="13" Opacity="0.8" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <Button x:Name="FinishButton" Content="完成" Classes="Primary"
                    HorizontalAlignment="Left" MinWidth="120"/>
        </StackPanel>

        <StackPanel x:Name="StateLoggedIn" IsVisible="False" Spacing="12">
            <Border CornerRadius="8" Padding="20" BorderThickness="1"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <Border x:Name="CurrentAvatar" Width="64" Height="64" CornerRadius="16"
                            BorderThickness="3"/>
                    <StackPanel VerticalAlignment="Center" Spacing="4">
                        <TextBlock x:Name="CurrentNameText" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock x:Name="CurrentEmailText" FontSize="13" Opacity="0.7"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button x:Name="LogoutButton" Content="退出登录" HorizontalAlignment="Left"/>
                <Button x:Name="CloseButton" Content="关闭" HorizontalAlignment="Left"/>
            </StackPanel>
        </StackPanel>

    </StackPanel>
</wd:AppWindow>
