<wd:AppWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="using:AvaloniaFluentUI.Controls"
        xmlns:wd="using:AvaloniaFluentUI.Windowing"
        mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="560"
        x:Class="ClassNex.Views.LoginWindow"
        Title="登录 ClassNEX"
        Icon="/Assets/icon.ico"
        TitleBarHeight="48"
        IsTitleBarContentVisible="False"
        Width="460" Height="410" MinWidth="340" MinHeight="300"
        WindowStartupLocation="CenterScreen">

    <Grid Background="{DynamicResource ClassNexCanvasBrush}" RowDefinitions="48,*">
        <StackPanel Orientation="Horizontal" Margin="16,0" Spacing="8" VerticalAlignment="Center">
            <Image Source="/Assets/icon.ico" Width="22" Height="22"/>
            <TextBlock Text="ClassNEX ID" VerticalAlignment="Center"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="26,10,26,26" Spacing="18" MaxWidth="530" HorizontalAlignment="Stretch">
                <StackPanel Spacing="5">
                    <TextBlock Text="账户与登录" FontSize="26"/>
                    <TextBlock Text="通过 ClassNEX ID 同步资料，连接教室设备。" Classes="muted" TextWrapping="Wrap"/>
                </StackPanel>
                <Border Classes="sectionSurface"><Grid>
                    <StackPanel x:Name="StateIdle" Spacing="13">
                        <StackPanel Orientation="Horizontal" Spacing="10"><ui:FontIcon Glyph="&#xE1FF;" FontSize="20" VerticalAlignment="Center"/><TextBlock Text="浏览器授权" FontSize="17" VerticalAlignment="Center"/></StackPanel>
                        <TextBlock Text="将在默认浏览器中打开登录或注册页面。完成授权后，回到这里即可。" TextWrapping="Wrap" Classes="muted"/>
                        <Button x:Name="StartLoginButton" Content="在浏览器中登录" Classes="workPrimary" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                    <StackPanel x:Name="StateFlow" IsVisible="False" Spacing="13">
                        <TextBlock Text="等待浏览器授权" FontSize="17"/>
                        <TextBlock x:Name="FlowStatusText" TextWrapping="Wrap" Classes="muted"/>
                        <WrapPanel><Button x:Name="ReopenBrowserButton" Content="重新打开浏览器" Classes="sectionLink"/><Button x:Name="CancelFlowButton" Content="取消登录" Classes="sectionLink"/></WrapPanel>
                    </StackPanel>
                    <StackPanel x:Name="StateDone" IsVisible="False" Spacing="13">
                        <TextBlock Text="登录成功" FontSize="17"/>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Border x:Name="DoneAvatar" Width="48" Height="48" CornerRadius="24" BorderThickness="1" ClipToBounds="True"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="DoneNameText" TextWrapping="Wrap"/><TextBlock x:Name="DoneEmailText" Classes="muted" TextWrapping="Wrap"/></StackPanel>
                        </Grid>
                        <Button x:Name="FinishButton" Content="完成" Classes="workPrimary" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                    <StackPanel x:Name="StateLoggedIn" IsVisible="False" Spacing="13">
                        <TextBlock Text="当前账户" FontSize="17"/>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Border x:Name="CurrentAvatar" Width="48" Height="48" CornerRadius="24" BorderThickness="1" ClipToBounds="True"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="CurrentNameText" TextWrapping="Wrap"/><TextBlock x:Name="CurrentEmailText" Classes="muted" TextWrapping="Wrap"/></StackPanel>
                        </Grid>
                        <WrapPanel><Button x:Name="CloseButton" Content="关闭" Classes="sectionLink"/><Button x:Name="LogoutButton" Content="退出登录" Classes="sectionLink"/></WrapPanel>
                    </StackPanel>
                </Grid></Border>
                <TextBlock Text="密码只提交给账户服务，ClassNEX 不读取或保存你的账户密码。" Classes="muted" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</wd:AppWindow>
