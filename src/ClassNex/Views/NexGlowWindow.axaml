<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ClassNex.Views.NexGlowWindow"
        Title="NEX 跑马灯"
        Width="1" Height="1"
        Topmost="True"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        SystemDecorations="None"
        ShowInTaskbar="False"
        ShowActivated="False"
        CanResize="False">
    <!-- 跑马灯（滚回第一版的参数，只把那圈贴着屏幕边框的细线删掉）：
         一圈厚光带 + 高斯模糊，边缘是一圈柔和的辉光，没有硬边、没有描边。 -->
    <Grid>
        <Border x:Name="GlowOuter" Margin="12" CornerRadius="26" BorderThickness="14" Opacity="0.9">
            <Border.Effect>
                <BlurEffect Radius="34"/>
            </Border.Effect>
        </Border>
    </Grid>
</Window>
