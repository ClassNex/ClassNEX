<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ClassNex.Views.NexGlowWindow"
        Title="NEX 跑马灯"
        Width="1" Height="1"
        Topmost="True"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        SystemDecorations="None"
        ShowInTaskbar="False"
        ShowActivated="False"
        CanResize="False">
    <!-- 苹果智能那种「跑马灯」：屏幕四边流动的彩色光带。
         用户要求：**不要贴着边框的细线**，只要流光 —— 所以只有一圈厚光带 + 大半径模糊，
         让光从边缘漫进来，没有任何硬边。 -->
    <Grid>
        <Border x:Name="GlowOuter" Margin="18" CornerRadius="34" BorderThickness="22" Opacity="0.9">
            <Border.Effect>
                <BlurEffect Radius="52"/>
            </Border.Effect>
        </Border>
    </Grid>
</Window>
