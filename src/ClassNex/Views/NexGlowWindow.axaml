<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ClassNex.Views.NexGlowWindow"
        Title="NEX 跑马灯"
        Width="1" Height="1"
        Topmost="True"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        SystemDecorations="None"
        ShowInTaskbar="False"
        ShowActivated="False"
        CanResize="False">
    <!-- 跑马灯：上/下两条横带 + 左右各两条「半段」竖带。
         出场顺序：① 触发侧从中间向上下长开 → ② 上/下从触发侧推向对侧 → ③ 对侧从上下两端同时向中间合拢。
         竖直半段用 ScaleTransform 从指定一端展开（不触发重排）。 -->
    <Grid x:Name="Root">
        <Border x:Name="TopStrip" Height="16" VerticalAlignment="Top" HorizontalAlignment="Right" Width="0">
            <Border.Effect>
                <BlurEffect Radius="26"/>
            </Border.Effect>
        </Border>

        <Border x:Name="BottomStrip" Height="16" VerticalAlignment="Bottom" HorizontalAlignment="Right" Width="0">
            <Border.Effect>
                <BlurEffect Radius="26"/>
            </Border.Effect>
        </Border>

        <!-- 右侧上半段（触发侧：从中间向上长开 → 原点在底边） -->
        <Border x:Name="RightTopStrip" Width="16" VerticalAlignment="Top" HorizontalAlignment="Right"
                Opacity="0" RenderTransformOrigin="0.5,1">
            <Border.RenderTransform>
                <ScaleTransform ScaleY="0"/>
            </Border.RenderTransform>
            <Border.Effect>
                <BlurEffect Radius="26"/>
            </Border.Effect>
        </Border>

        <!-- 右侧下半段（触发侧：从中间向下长开 → 原点在顶边） -->
        <Border x:Name="RightBottomStrip" Width="16" VerticalAlignment="Bottom" HorizontalAlignment="Right"
                Opacity="0" RenderTransformOrigin="0.5,0">
            <Border.RenderTransform>
                <ScaleTransform ScaleY="0"/>
            </Border.RenderTransform>
            <Border.Effect>
                <BlurEffect Radius="26"/>
            </Border.Effect>
        </Border>

        <!-- 左侧上半段（对侧：从上往下长 → 原点在顶边） -->
        <Border x:Name="LeftTopStrip" Width="16" VerticalAlignment="Top" HorizontalAlignment="Left"
                Opacity="0" RenderTransformOrigin="0.5,0">
            <Border.RenderTransform>
                <ScaleTransform ScaleY="0"/>
            </Border.RenderTransform>
            <Border.Effect>
                <BlurEffect Radius="26"/>
            </Border.Effect>
        </Border>

        <!-- 左侧下半段（对侧：从下往上长 → 原点在底边） -->
        <Border x:Name="LeftBottomStrip" Width="16" VerticalAlignment="Bottom" HorizontalAlignment="Left"
                Opacity="0" RenderTransformOrigin="0.5,1">
            <Border.RenderTransform>
                <ScaleTransform ScaleY="0"/>
            </Border.RenderTransform>
            <Border.Effect>
                <BlurEffect Radius="26"/>
            </Border.Effect>
        </Border>
    </Grid>
</Window>
