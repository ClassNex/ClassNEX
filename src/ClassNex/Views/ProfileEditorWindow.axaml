<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="using:FluentAvalonia.UI.Controls"
        mc:Ignorable="d" d:DesignWidth="1240" d:DesignHeight="760"
        x:Class="ClassNex.Views.ProfileEditorWindow"
        Title="档案编辑器"
        Icon="/Assets/icon.ico"
        Width="1240" Height="760"
        MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen">

    <DockPanel Background="{DynamicResource ApplicationPageBackgroundThemeBrush}">

        <Border DockPanel.Dock="Top" Padding="20,14"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="档案编辑器" FontSize="18" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <TextBlock x:Name="ProfileInfoText" FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button x:Name="OpenButton" Content="打开课表…"/>
                    <Button x:Name="ReloadButton" Content="重新加载"/>
                    <Button x:Name="ExportButton" Content="导出 CSES…"/>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl x:Name="Tabs" Margin="8">

            <!-- ==================== 课表（1:1 复刻 CI 档案编辑器「课表」页） ====================
                 CI 结构：CommandBar（工具栏）
                 + Grid[ DataGrid 列表视图（启用/时间/科目下拉框，每行=一个节次） | 分割条 | 编辑科目面板 ]
                 编辑模型：选中一行 → 改科目下拉框或点右侧科目 → 立即生效；
                 勾选「选完科目自动移动到下一个课程」后自动下移一行。 -->
            <TabItem Header="课表">
                <Grid Margin="12" ColumnDefinitions="*,5,350">

                    <DockPanel Grid.Column="0">
                        <!-- 工具栏（对应 CI CommandBar，按其可映射项） -->
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="4,0,4,10">
                            <Button x:Name="RefreshButton" Content="刷新"/>
                            <Button x:Name="DeleteCourseButton" Content="删除"/>
                            <ComboBox x:Name="DayCombo" Width="110">
                                <ComboBoxItem Content="周一"/>
                                <ComboBoxItem Content="周二"/>
                                <ComboBoxItem Content="周三"/>
                                <ComboBoxItem Content="周四"/>
                                <ComboBoxItem Content="周五"/>
                                <ComboBoxItem Content="周六"/>
                                <ComboBoxItem Content="周日"/>
                            </ComboBox>
                            <ComboBox x:Name="ParityCombo" Width="110">
                                <ComboBoxItem Content="全部课程"/>
                                <ComboBoxItem Content="单周"/>
                                <ComboBoxItem Content="双周"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- 列表视图 / 周视图（对应 CI 的两种视图） -->
                        <TabControl x:Name="ClassPlanViews" Padding="0">
                            <TabItem Header="列表视图">
                                <DataGrid x:Name="ClassGrid" Margin="0,0,4,0"
                                          AutoGenerateColumns="False"
                                          CanUserSortColumns="False"
                                          CanUserReorderColumns="False"
                                          GridLinesVisibility="Horizontal">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="启用" Width="72">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="时间"
                                                             Binding="{Binding TimeText}"
                                                             IsReadOnly="True"
                                                             Width="130"/>
                                        <DataGridTemplateColumn Header="科目" Width="*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ComboBox ItemsSource="{Binding Subjects}"
                                                              SelectedItem="{Binding Subject, Mode=TwoWay}"
                                                              HorizontalAlignment="Stretch"
                                                              FontSize="13"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>

                            <TabItem Header="周视图">
                                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Auto">
                                    <Grid x:Name="TimetableGrid" Margin="4"/>
                                </ScrollViewer>
                            </TabItem>
                        </TabControl>
                    </DockPanel>

                    <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch" Background="Transparent"/>

                    <!-- 编辑科目面板（对应 CI 右侧 TabControl「编辑科目」） -->
                    <DockPanel Grid.Column="2" Margin="12,0,0,0">
                        <TextBlock DockPanel.Dock="Top" Text="编辑科目" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <CheckBox DockPanel.Dock="Bottom" x:Name="AutoAdvanceCheck"
                                  Content="选完科目自动移动到下一个课程" Margin="0,10,0,0"/>
                        <TextBlock DockPanel.Dock="Bottom" x:Name="PaletteHintText" FontSize="11" TextWrapping="Wrap"
                                   Margin="0,6,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <Border Margin="0,10,0,0"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="14">
                            <ScrollViewer>
                                <WrapPanel x:Name="SubjectPalettePanel"/>
                            </ScrollViewer>
                        </Border>
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- ==================== 时间表（对应 CI「时间表」页的可视化时间轴） ==================== -->
            <TabItem Header="时间表">
                <Grid Margin="12" ColumnDefinitions="*,330">

                    <DockPanel Grid.Column="0">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
                            <Button x:Name="AddTimeButton" Content="添加"/>
                            <Button x:Name="RemoveTimeButton" Content="删除"/>
                            <Button x:Name="MoveUpButton" Content="上移"/>
                            <Button x:Name="MoveDownButton" Content="下移"/>
                            <Button x:Name="ResetTimeButton" Content="从课表重建"/>
                        </StackPanel>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="TimeAxisPanel" Spacing="2" Margin="0,0,8,0"/>
                        </ScrollViewer>
                    </DockPanel>

                    <Border Grid.Column="1" Margin="12,0,0,0"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="14">
                        <StackPanel Spacing="12">
                            <TextBlock x:Name="TimeEditorTitle" Text="时间点" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

                            <StackPanel Spacing="4">
                                <TextBlock Text="名称" FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <TextBox x:Name="TimeNameBox"/>
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Text="开始时间" FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <TimePicker x:Name="TimeStartPicker" HorizontalAlignment="Stretch"/>
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Text="结束时间" FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <TimePicker x:Name="TimeEndPicker" HorizontalAlignment="Stretch"/>
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Text="类型" FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <ComboBox x:Name="TimeKindCombo" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="上课"/>
                                    <ComboBoxItem Content="课间"/>
                                </ComboBox>
                            </StackPanel>

                            <Button x:Name="SaveTimeButton" Content="保存修改" HorizontalAlignment="Left"/>

                            <TextBlock Text="课程的时间跟随其所在节次；修改时间会同步更新课表中使用该时段的课程。"
                                       FontSize="11" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ==================== 科目（对应 CI「科目」页的表格） ==================== -->
            <TabItem Header="科目">
                <Grid Margin="12" ColumnDefinitions="*,330">

                    <DockPanel Grid.Column="0">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
                            <Button x:Name="AddSubjectButton" Content="添加"/>
                            <Button x:Name="DeleteSubjectButton" Content="删除"/>
                        </StackPanel>

                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <Grid x:Name="SubjectTableGrid" Margin="0,0,8,0"/>
                        </ScrollViewer>
                    </DockPanel>

                    <Border Grid.Column="1" Margin="12,0,0,0"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="14">
                        <ScrollViewer>
                            <StackPanel Spacing="12">
                                <TextBlock Text="编辑科目信息" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

                                <StackPanel Spacing="4">
                                    <TextBlock Text="科目名" FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <TextBox x:Name="SubjectNameBox"/>
                                </StackPanel>

                                <StackPanel Spacing="4">
                                    <TextBlock Text="简称" FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <TextBox x:Name="SubjectSimplifiedBox"/>
                                </StackPanel>

                                <StackPanel Spacing="4">
                                    <TextBlock Text="科任老师" FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <TextBox x:Name="SubjectTeacherBox"/>
                                </StackPanel>

                                <CheckBox x:Name="OutdoorCheck" Content="该科目是户外课程"/>

                                <Button x:Name="SaveSubjectsButton" Content="保存" HorizontalAlignment="Left"/>

                                <TextBlock Text="修改会写回 CSES 课表文件。"
                                           FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ==================== 调课 ==================== -->
            <TabItem Header="调课">
                <StackPanel Margin="16" Spacing="12">
                    <TextBlock Text="调课" FontSize="18" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <TextBlock Text="临时调课（不改动基础课表，只覆盖某一天）功能开发中。"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>
