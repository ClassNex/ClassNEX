<wd:AppWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="using:AvaloniaFluentUI.Controls"
        xmlns:wd="using:AvaloniaFluentUI.Windowing"
        xmlns:views="using:ClassNex.Views"
        mc:Ignorable="d" d:DesignWidth="1240" d:DesignHeight="760"
        x:Class="ClassNex.Views.ProfileEditorWindow"
        Title="编辑档案"
        Icon="/Assets/icon.ico"
        TitleBarHeight="48"
        IsTitleBarContentVisible="False"
        Width="1150" Height="730"
        MinWidth="700" MinHeight="510"
        Background="Transparent" TransparencyBackgroundFallback="{DynamicResource ClassNexCanvasBrush}"
        WindowStartupLocation="CenterScreen">

    
    <Grid x:Name="EditorShell" Classes="profileShell" RowDefinitions="48,*">
        <Grid.Styles>
            <Style Selector="Grid.profileShell"><Setter Property="Background" Value="{DynamicResource ClassNexCanvasBrush}"/></Style>
            <Style Selector="Grid.profileShell.mica"><Setter Property="Background" Value="Transparent"/></Style>
            <Style Selector="Border.editorCard">
                <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="12"/>
            </Style>
        </Grid.Styles>
        <Border Grid.Row="0" Height="48" BorderThickness="0">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="14,0,0,0">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button x:Name="BackButton" Theme="{StaticResource TransparentButton}"
                            Padding="6,4" VerticalAlignment="Center" ToolTip.Tip="返回上一页"
                            Click="OnNavigateBack">
                        <ui:FontIcon FontFamily="avares://ClassNex/Assets/Fonts/#lucide"
                                     Glyph="&#xE06E;" FontSize="14"/>
                    </Button>
                    <Image Source="/Assets/icon.ico" Width="18" Height="18"
                           IsHitTestVisible="False" RenderOptions.BitmapInterpolationMode="HighQuality"/>
                    <TextBlock Text="编辑档案" FontSize="12" VerticalAlignment="Center"
                               IsHitTestVisible="False"/>
                </StackPanel>

                <Border Grid.Column="1" MaxWidth="420" Height="32" CornerRadius="8" BorderThickness="1"
                        HorizontalAlignment="Stretch" VerticalAlignment="Center"
                        Margin="16,0"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        Background="{DynamicResource ControlFillColorDefaultBrush}">
                    <Grid ColumnDefinitions="Auto,*" Margin="10,0">
                        <ui:FontIcon Grid.Column="0"
                                     FontFamily="avares://ClassNex/Assets/Fonts/#lucide"
                                     Glyph="&#xE0CC;" FontSize="12" Margin="0,0,8,0"
                                     VerticalAlignment="Center" Opacity="0.7"/>
                        <TextBlock Grid.Column="1" x:Name="ProfileInfoText"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock x:Name="ProfileVersionText" FontSize="12"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <Button x:Name="MoreOptionsButton" Theme="{StaticResource TransparentButton}"
                            VerticalAlignment="Center" ToolTip.Tip="更多选项…">
                        <ui:FontIcon FontFamily="avares://ClassNex/Assets/Fonts/#lucide"
                                     Glyph="&#xE0B6;" FontSize="14"/>
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuItem Header="保存" Click="OnSaveNow">
                                    <MenuItem.Icon>
                                        <ui:FontIcon FontFamily="avares://ClassNex/Assets/Fonts/#lucide"
                                                     Glyph="&#xE11D;"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="打开课表…" Click="OnOpenTimetable">
                                    <MenuItem.Icon>
                                        <ui:FontIcon FontFamily="avares://ClassNex/Assets/Fonts/#lucide"
                                                     Glyph="&#xE102;"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="重新加载" Click="OnReloadProfile">
                                    <MenuItem.Icon>
                                        <ui:FontIcon FontFamily="avares://ClassNex/Assets/Fonts/#lucide"
                                                     Glyph="&#xE0B5;"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="导出 CSES…" Click="OnExport">
                                    <MenuItem.Icon>
                                        <ui:FontIcon FontFamily="avares://ClassNex/Assets/Fonts/#lucide"
                                                     Glyph="&#xE0B2;"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>

                <Border Grid.Column="3" Width="152"/>
            </Grid>
        </Border>

        <ui:NavigationView Grid.Row="1" x:Name="NavView" Margin="8"
                           Background="Transparent"
                           PaneDisplayMode="Auto" CompactModeThresholdWidth="540" ExpandedModeThresholdWidth="980"
                           OpenPaneLength="186"
                           PaneTitle="编辑档案"
                           IsBackButtonVisible="False"
                           IsSettingsVisible="False"
                           IsPaneToggleButtonVisible="True">
            <ui:NavigationView.Resources>
                <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent"/>
                <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent"/>
            </ui:NavigationView.Resources>

            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="档案信息">
                    <ui:NavigationViewItem.IconSource>
                        <ui:FontIconSource FontFamily="avares://ClassNex/Assets/Fonts/#lucide"
                                           Glyph="&#xE0F9;" FontSize="16"/>
                    </ui:NavigationViewItem.IconSource>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="课表">
                    <ui:NavigationViewItem.IconSource>
                        <ui:FontIconSource FontFamily="avares://ClassNex/Assets/Fonts/#lucide"
                                           Glyph="&#xE2B9;" FontSize="16"/>
                    </ui:NavigationViewItem.IconSource>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="时间表">
                    <ui:NavigationViewItem.IconSource>
                        <ui:FontIconSource FontFamily="avares://ClassNex/Assets/Fonts/#lucide"
                                           Glyph="&#xE087;" FontSize="16"/>
                    </ui:NavigationViewItem.IconSource>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="科目">
                    <ui:NavigationViewItem.IconSource>
                        <ui:FontIconSource FontFamily="avares://ClassNex/Assets/Fonts/#lucide"
                                           Glyph="&#xE198;" FontSize="16"/>
                    </ui:NavigationViewItem.IconSource>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="调课">
                    <ui:NavigationViewItem.IconSource>
                        <ui:FontIconSource FontFamily="avares://ClassNex/Assets/Fonts/#lucide"
                                           Glyph="&#xE049;" FontSize="16"/>
                    </ui:NavigationViewItem.IconSource>
                </ui:NavigationViewItem>
            </ui:NavigationView.MenuItems>

            <Grid RowDefinitions="Auto,Auto,*" Background="{DynamicResource ControlFillColorDefaultBrush}" ClipToBounds="True">
                <TextBlock x:Name="PageTitleText" Grid.Row="0" FontSize="28"
                           MinHeight="48" VerticalAlignment="Top"
                           Margin="22,16,22,0" HorizontalAlignment="Left"/>

                <WrapPanel x:Name="BaseCommands" Grid.Row="1" Margin="22,6,22,0">
                    <Button x:Name="SaveNowButton" Content="保存基础课表" Margin="0,0,8,4"/>
                    <Button x:Name="OpenButton" Content="打开课表…" Margin="0,0,8,4"/>
                    <Button x:Name="ReloadButton" Content="重新加载" Margin="0,0,8,4"/>
                    <Button x:Name="ExportButton" Content="导出 CSES…" Margin="0,0,0,4"/>
                </WrapPanel>

                <Grid Grid.Row="2">
                    <ScrollViewer x:Name="PageProfile" IsVisible="False" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="22,12,22,24" Spacing="16" HorizontalAlignment="Stretch">
                            <TextBlock x:Name="ProfileSummaryText" FontSize="14" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                            <Border Padding="20"
                                    Background="{DynamicResource ClassNexSurfaceBrush}"
                                    BorderBrush="{DynamicResource ClassNexOutlineBrush}"
                                    BorderThickness="1" CornerRadius="8">
                                <Grid ColumnDefinitions="150,*"
                                      RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                                      RowSpacing="12">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="档案名称"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="ProfileNameValueText"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="课表文件"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="ProfileFileValueText"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="开学日期"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="ProfileSemesterValueText"/>
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="周次规则"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="支持每周、单周和双周课程"/>
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="保存位置"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="修改会写回当前 CSES 课表文件"
                                               TextWrapping="Wrap"/>
                                </Grid>
                            </Border>

                            <TextBlock Text="编辑内容" Classes="sectionLabel"/>
                            <StackPanel Spacing="6">
                                <Button Classes="homeLink" Tag="0" Click="OnWorkspaceLink">
                                    <Grid ColumnDefinitions="*,Auto"><TextBlock Text="每周课表"/><TextBlock Grid.Column="1" x:Name="ProfileCourseCountText" Classes="muted"/></Grid>
                                </Button>
                                <Button Classes="homeLink" Tag="1" Click="OnWorkspaceLink">
                                    <Grid ColumnDefinitions="*,Auto"><TextBlock Text="作息时间表"/><TextBlock Grid.Column="1" x:Name="ProfileTimePointCountText" Classes="muted"/></Grid>
                                </Button>
                                <Button Classes="homeLink" Tag="2" Click="OnWorkspaceLink">
                                    <Grid ColumnDefinitions="*,Auto"><TextBlock Text="科目与任课老师"/><TextBlock Grid.Column="1" x:Name="ProfileSubjectCountText" Classes="muted"/></Grid>
                                </Button>
                                <Button Classes="homeLink" Tag="3" Click="OnWorkspaceLink">
                                    <Grid ColumnDefinitions="*,Auto"><TextBlock Text="按日期调课"/><TextBlock Grid.Column="1" Text="单日生效" Classes="muted"/></Grid>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <Grid x:Name="PageSchedule" IsVisible="False" Margin="22,12,22,20"
                          RowDefinitions="Auto,*">

                    <WrapPanel Grid.Row="0" Margin="0,0,0,6">
                        <Border Background="{DynamicResource ControlFillColorDefaultBrush}" Margin="0,0,8,6"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="10,4">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock x:Name="NavDateText" FontSize="13" VerticalAlignment="Center"/>
                                <TextBlock x:Name="NavWeekText" FontSize="13" Classes="muted" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <StackPanel Margin="0,0,8,6" Orientation="Horizontal" Spacing="4">
                        <Button x:Name="PrevWeekButton" Padding="8,4" VerticalAlignment="Center" AutomationProperties.Name="上一周" ToolTip.Tip="上一周">
                            <ui:FontIcon FontFamily="avares://ClassNex/Assets/Fonts/#lucide" Glyph="&#xE06E;" FontSize="14"/>
                        </Button>
                        <Button x:Name="NextWeekButton" Padding="8,4" VerticalAlignment="Center" AutomationProperties.Name="下一周" ToolTip.Tip="下一周">
                            <ui:FontIcon FontFamily="avares://ClassNex/Assets/Fonts/#lucide" Glyph="&#xE06F;" FontSize="14"/>
                        </Button>
                        </StackPanel>
                        <ComboBox x:Name="ParityCombo" Width="126" Margin="0,0,8,6" VerticalAlignment="Center" AutomationProperties.Name="课程周次">
                            <ComboBoxItem Content="全部课程"/>
                            <ComboBoxItem Content="单周"/>
                            <ComboBoxItem Content="双周"/>
                        </ComboBox>
                        <Button x:Name="DeleteSelectedCourseButton" Content="删除所选课程" Margin="0,0,0,6" VerticalAlignment="Center"/>
                    </WrapPanel>

                    <Grid x:Name="WeekWorkspace" Grid.Row="1" ColumnDefinitions="*,8,252" RowDefinitions="*,0">
                    <DataGrid x:Name="WeekGrid" ClipToBounds="True"
                              AutoGenerateColumns="False"
                              CanUserSortColumns="False"
                              CanUserReorderColumns="False"
                              CanUserResizeColumns="False"
                              SelectionMode="Single"
                              MinColumnWidth="60"
                              GridLinesVisibility="All"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Resources>
                            <x:Double x:Key="DataGridSortIconMinWidth">0</x:Double>
                        </DataGrid.Resources>
                        <DataGrid.Styles>
                            <Style Selector="DataGridColumnHeader">
                                <Setter Property="Padding" Value="6,5"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            </Style>
                        </DataGrid.Styles>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="时间" Width="88">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding TimeText}" FontSize="13"
                                                   VerticalAlignment="Center" Margin="4,0,0,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Sunday}" FontSize="13" TextWrapping="Wrap"
                                                   VerticalAlignment="Center" Margin="6,4"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Monday}" FontSize="13" TextWrapping="Wrap"
                                                   VerticalAlignment="Center" Margin="6,4"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Tuesday}" FontSize="13" TextWrapping="Wrap"
                                                   VerticalAlignment="Center" Margin="6,4"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Wednesday}" FontSize="13" TextWrapping="Wrap"
                                                   VerticalAlignment="Center" Margin="6,4"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Thursday}" FontSize="13" TextWrapping="Wrap"
                                                   VerticalAlignment="Center" Margin="6,4"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Friday}" FontSize="13" TextWrapping="Wrap"
                                                   VerticalAlignment="Center" Margin="6,4"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Saturday}" FontSize="13" TextWrapping="Wrap"
                                                   VerticalAlignment="Center" Margin="6,4"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <GridSplitter x:Name="WeekSplitter" Grid.Column="1" HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch" ResizeDirection="Columns" Background="Transparent"/>

                    <Border x:Name="WeekInspector" Grid.Column="2" Classes="editorCard">
                        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="6">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBlock Text="选科排课" FontSize="15" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="自动下一节" VerticalAlignment="Center"/>
                            <ToggleSwitch Grid.Column="1" x:Name="AutoAdvanceCheck" AutomationProperties.Name="自动选中下一节课"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Grid.Row="1" x:Name="PaletteHintText" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <ListBox x:Name="SubjectPaletteList" Grid.Row="2" Background="Transparent" BorderThickness="0"
                                     SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="Transparent" Padding="8">
                                            <TextBlock Text="{Binding DisplayName}" FontSize="16"
                                                       ToolTip.Tip="{Binding Name}" IsHitTestVisible="False"/>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                    </Grid>
                </Grid>

                    <DockPanel x:Name="PageTime" IsVisible="False" Margin="22,12,22,20">
                    <ui:InfoBar x:Name="TimeInfoBar" DockPanel.Dock="Top" Severity="Informational"
                                IsOpen="False" IsClosable="True" Margin="0,0,0,8"/>

                    <WrapPanel DockPanel.Dock="Top" x:Name="TimeToolbar" Margin="0,0,0,6">
                        <Button x:Name="AddTimeButton" Margin="0,0,8,6" AutomationProperties.Name="添加时间点">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="添加时间点"/>
                                <ui:FontIcon FontFamily="avares://ClassNex/Assets/Fonts/#lucide" Glyph="&#xE06D;" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuItem x:Name="AddClassTimeButton" Header="上课"/>
                                    <MenuItem x:Name="AddBreakTimeButton" Header="课间"/>
                                    <MenuItem x:Name="AddSeparatorButton" Header="分割线"/>
                                    <MenuItem x:Name="AddActionButton" Header="活动"/>
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                        <Button x:Name="MoveUpButton" Content="上移" Margin="0,0,4,6"/>
                        <Button x:Name="MoveDownButton" Content="下移" Margin="0,0,8,6"/>
                        <Button x:Name="TimeOptionsButton" Margin="0,0,0,6" AutomationProperties.Name="更多时间表操作" ToolTip.Tip="更多时间表操作">
                            <ui:FontIcon FontFamily="avares://ClassNex/Assets/Fonts/#lucide" Glyph="&#xE0B6;" FontSize="16"/>
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuItem x:Name="DuplicateTimeButton" Header="创建副本"/>
                                    <MenuItem x:Name="RemoveTimeButton" Header="删除选中的时间点"/>
                                    <Separator/>
                                    <MenuItem x:Name="ResetTimeButton" Header="从课表重建…"/>
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </WrapPanel>

                    <Grid x:Name="TimeWorkspace" ColumnDefinitions="*,12,284" RowDefinitions="*,0">
                        <ScrollViewer x:Name="TimeAxisScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="TimeAxisPanel" Spacing="4" Margin="0,0,8,0">
                                <StackPanel.Styles>
                                    <Style Selector="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    </Style>
                                    <Style Selector="Border.timelineItem">
                                        <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource FocusStrokeColorOuterBrush}"/>
                                    </Style>
                                    <Style Selector="Border.timelineItem.lesson">
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                                    </Style>
                                    <Style Selector="Border.timelineItem.marker">
                                        <Setter Property="Background" Value="{DynamicResource DividerStrokeColorDefaultBrush}"/>
                                    </Style>
                                    <Style Selector="Border.timelineFocus">
                                        <Setter Property="BorderBrush" Value="{DynamicResource FocusStrokeColorInnerBrush}"/>
                                    </Style>
                                </StackPanel.Styles>
                            </StackPanel>
                        </ScrollViewer>

                        <ScrollViewer x:Name="TimeInspector" Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="8">
                        <Border Classes="editorCard">
                            <StackPanel Spacing="12">
                                <TextBlock x:Name="TimeEditorTitle" Text="时间点" FontSize="15" TextWrapping="Wrap"/>
                                <StackPanel x:Name="TimeFields" IsEnabled="False" IsVisible="False" Spacing="10">

                                <StackPanel Spacing="4">
                                    <TextBlock Text="名称" Classes="muted"/>
                                    <TextBox x:Name="TimeNameBox" AutomationProperties.Name="时间点名称"/>
                                </StackPanel>

                                <StackPanel Spacing="4">
                                    <TextBlock Text="开始时间" Classes="muted"/>
                                    <TimePicker x:Name="TimeStartPicker" ClockIdentifier="24HourClock" HorizontalAlignment="Stretch" AutomationProperties.Name="开始时间"/>
                                </StackPanel>

                                <StackPanel Spacing="4">
                                    <TextBlock Text="结束时间" Classes="muted"/>
                                    <TimePicker x:Name="TimeEndPicker" ClockIdentifier="24HourClock" HorizontalAlignment="Stretch" AutomationProperties.Name="结束时间"/>
                                </StackPanel>

                                <StackPanel Spacing="4">
                                    <TextBlock Text="类型" Classes="muted"/>
                                    <ComboBox x:Name="TimeKindCombo" HorizontalAlignment="Stretch" AutomationProperties.Name="时间点类型">
                                        <ComboBoxItem Content="上课"/>
                                        <ComboBoxItem Content="课间"/>
                                        <ComboBoxItem Content="分割线"/>
                                        <ComboBoxItem Content="活动"/>
                                    </ComboBox>
                                </StackPanel>

                                <Button x:Name="SaveTimeButton" Content="应用修改" HorizontalAlignment="Left"/>
                                </StackPanel>
                                <TextBlock x:Name="TimeFieldHint" Text="选择一个时间点进行编辑。上课时间调整后，引用该节次的课程会一起调整。"
                                           Classes="muted" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                            <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Header="默认时间长度" Padding="10">
                                <StackPanel Spacing="4">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="上课" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                            <ui:NumberBox x:Name="ClassMinutesBox" Maximum="36000" Minimum="0"
                                                          Width="120" SpinButtonPlacementMode="Inline"/>
                                            <TextBlock Text="分钟" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="课间" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                            <ui:NumberBox x:Name="BreakMinutesBox" Maximum="36000" Minimum="0"
                                                          Width="120" SpinButtonPlacementMode="Inline"/>
                                            <TextBlock Text="分钟" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                        </ScrollViewer>
                    </Grid>
                    </DockPanel>

                    <Grid x:Name="PageSubject" IsVisible="False" Margin="22,12,22,20"
                          ColumnDefinitions="*,12,284" RowDefinitions="*,0">

                    <DockPanel x:Name="SubjectListPane" Grid.Column="0">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
                            <Button x:Name="AddSubjectButton" Content="添加科目"/>
                            <Button x:Name="DeleteSubjectButton" Content="删除所选科目" IsEnabled="False"/>
                        </StackPanel>

                        <ScrollViewer x:Name="SubjectTableScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <Grid x:Name="SubjectTableGrid" Margin="0,0,8,0"/>
                        </ScrollViewer>
                    </DockPanel>

                    <ScrollViewer x:Name="SubjectInspector" Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Border Classes="editorCard">
                            <StackPanel Spacing="12">
                                <TextBlock Text="编辑科目信息" FontSize="15"/>
                                <TextBlock x:Name="SubjectFieldHint" Text="选择一个现有科目，或先添加科目。" Classes="muted" TextWrapping="Wrap"/>
                                <StackPanel x:Name="SubjectFields" IsEnabled="False" Spacing="10">

                                <StackPanel Spacing="4">
                                    <TextBlock Text="科目名" FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <TextBox x:Name="SubjectNameBox" AutomationProperties.Name="科目名"/>
                                </StackPanel>

                                <StackPanel Spacing="4">
                                    <TextBlock Text="简称" FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <TextBox x:Name="SubjectSimplifiedBox" AutomationProperties.Name="简称"/>
                                </StackPanel>

                                <StackPanel Spacing="4">
                                    <TextBlock Text="科任老师" FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <TextBox x:Name="SubjectTeacherBox" AutomationProperties.Name="科任老师"/>
                                </StackPanel>

                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="该科目是户外课程" TextWrapping="Wrap"
                                               VerticalAlignment="Center"/>
                                    <ToggleSwitch Grid.Column="1" x:Name="OutdoorCheck" AutomationProperties.Name="户外课程"/>
                                </Grid>

                                <Button x:Name="SaveSubjectsButton" Content="保存科目信息" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </ScrollViewer>
                    </Grid>

                    <views:TemporaryScheduleEditor x:Name="PageSwap" IsVisible="False"/>
                </Grid>
            </Grid>
        </ui:NavigationView>
    </Grid>
</wd:AppWindow>
