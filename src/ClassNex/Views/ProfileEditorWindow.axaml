<wd:AppWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="using:AvaloniaFluentUI.Controls"
        xmlns:wd="using:AvaloniaFluentUI.Windowing"
        mc:Ignorable="d" d:DesignWidth="1240" d:DesignHeight="760"
        x:Class="ClassNex.Views.ProfileEditorWindow"
        Title="档案编辑器"
        Icon="/Assets/icon.ico"
        TitleBarHeight="48"
        IsTitleBarContentVisible="False"
        Width="1240" Height="760"
        MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen">

    
    <Grid RowDefinitions="48,*">
        <Border Grid.Row="0" Height="48" BorderThickness="0">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="14,0,0,0">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button x:Name="BackButton" Theme="{StaticResource TransparentButton}"
                            Padding="6,4" VerticalAlignment="Center" ToolTip.Tip="返回上一页"
                            Click="OnNavigateBack">
                        <ui:FontIcon FontFamily="avares://ClassNex/Assets/Fonts/#lucide"
                                     Glyph="&#xE06E;" FontSize="14"/>
                    </Button>
                    <Image Source="/Assets/icon.ico" Width="18" Height="18"
                           IsHitTestVisible="False" RenderOptions.BitmapInterpolationMode="HighQuality"/>
                    <TextBlock Text="档案编辑器" FontSize="12" VerticalAlignment="Center"
                               IsHitTestVisible="False"/>
                </StackPanel>

                <Border Grid.Column="1" Width="420" Height="32" CornerRadius="8" BorderThickness="1"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Margin="110,0,0,0"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        Background="{DynamicResource ControlFillColorDefaultBrush}">
                    <Grid ColumnDefinitions="Auto,*" Margin="10,0">
                        <ui:FontIcon Grid.Column="0"
                                     FontFamily="avares://ClassNex/Assets/Fonts/#lucide"
                                     Glyph="&#xE0CC;" FontSize="12" Margin="0,0,8,0"
                                     VerticalAlignment="Center" Opacity="0.7"/>
                        <TextBlock Grid.Column="1" x:Name="ProfileInfoText"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock x:Name="ProfileVersionText" FontSize="12"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <Button x:Name="MoreOptionsButton" Theme="{StaticResource TransparentButton}"
                            VerticalAlignment="Center" ToolTip.Tip="更多选项…">
                        <ui:FontIcon FontFamily="avares://ClassNex/Assets/Fonts/#lucide"
                                     Glyph="&#xE0B6;" FontSize="14"/>
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuItem Header="保存" Click="OnSaveNow">
                                    <MenuItem.Icon>
                                        <ui:FontIcon FontFamily="avares://ClassNex/Assets/Fonts/#lucide"
                                                     Glyph="&#xE11D;"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="打开课表…" Click="OnOpenTimetable">
                                    <MenuItem.Icon>
                                        <ui:FontIcon FontFamily="avares://ClassNex/Assets/Fonts/#lucide"
                                                     Glyph="&#xE102;"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="重新加载" Click="OnReloadProfile">
                                    <MenuItem.Icon>
                                        <ui:FontIcon FontFamily="avares://ClassNex/Assets/Fonts/#lucide"
                                                     Glyph="&#xE0B5;"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="导出 CSES…" Click="OnExport">
                                    <MenuItem.Icon>
                                        <ui:FontIcon FontFamily="avares://ClassNex/Assets/Fonts/#lucide"
                                                     Glyph="&#xE0B2;"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>

                <Border Grid.Column="3" Width="152"/>
            </Grid>
        </Border>

        <ui:NavigationView Grid.Row="1" x:Name="NavView" Margin="8"
                           Background="Transparent"
                           PaneDisplayMode="Left"
                           OpenPaneLength="220"
                           IsPaneOpen="True"
                           PaneTitle="档案编辑器"
                           IsBackButtonVisible="False"
                           IsSettingsVisible="False"
                           IsPaneToggleButtonVisible="True">
            <ui:NavigationView.Resources>
                <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent"/>
                <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent"/>
            </ui:NavigationView.Resources>

            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="档案信息">
                    <ui:NavigationViewItem.IconSource>
                        <ui:FontIconSource FontFamily="avares://ClassNex/Assets/Fonts/#lucide"
                                           Glyph="&#xE0F9;" FontSize="16"/>
                    </ui:NavigationViewItem.IconSource>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="课表">
                    <ui:NavigationViewItem.IconSource>
                        <ui:FontIconSource FontFamily="avares://ClassNex/Assets/Fonts/#lucide"
                                           Glyph="&#xE2B9;" FontSize="16"/>
                    </ui:NavigationViewItem.IconSource>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="时间表">
                    <ui:NavigationViewItem.IconSource>
                        <ui:FontIconSource FontFamily="avares://ClassNex/Assets/Fonts/#lucide"
                                           Glyph="&#xE087;" FontSize="16"/>
                    </ui:NavigationViewItem.IconSource>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="科目">
                    <ui:NavigationViewItem.IconSource>
                        <ui:FontIconSource FontFamily="avares://ClassNex/Assets/Fonts/#lucide"
                                           Glyph="&#xE198;" FontSize="16"/>
                    </ui:NavigationViewItem.IconSource>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="调课">
                    <ui:NavigationViewItem.IconSource>
                        <ui:FontIconSource FontFamily="avares://ClassNex/Assets/Fonts/#lucide"
                                           Glyph="&#xE049;" FontSize="16"/>
                    </ui:NavigationViewItem.IconSource>
                </ui:NavigationViewItem>
            </ui:NavigationView.MenuItems>

            <Grid RowDefinitions="Auto,Auto,*">
                <TextBlock x:Name="PageTitleText" Grid.Row="0" FontSize="28"
                           Margin="32,24,32,0" HorizontalAlignment="Left"/>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8"
                            Margin="32,12,32,0">
                    <Button x:Name="SaveNowButton" Content="保存"/>
                    <Button x:Name="OpenButton" Content="打开课表…"/>
                    <Button x:Name="ReloadButton" Content="重新加载"/>
                    <Button x:Name="ExportButton" Content="导出 CSES…"/>
                </StackPanel>

                <Grid Grid.Row="2">
                    <ScrollViewer x:Name="PageProfile" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="32,16,32,32" Spacing="16" MaxWidth="860"
                                    HorizontalAlignment="Left">
                            <TextBlock x:Name="ProfileSummaryText" FontSize="14" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                            <Border Padding="20"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="8">
                                <Grid ColumnDefinitions="150,*"
                                      RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                                      RowSpacing="12">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="档案名称"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="ProfileNameValueText"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="课表文件"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="ProfileFileValueText"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="开学日期"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="ProfileSemesterValueText"/>
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="周次规则"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="支持每周、单周和双周课程"/>
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="保存位置"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="修改会写回当前 CSES 课表文件"
                                               TextWrapping="Wrap"/>
                                </Grid>
                            </Border>

                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                                <Border Grid.Column="0" Padding="18"
                                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1" CornerRadius="8">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="课程"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock x:Name="ProfileCourseCountText" FontSize="24"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Padding="18"
                                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1" CornerRadius="8">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="科目"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock x:Name="ProfileSubjectCountText" FontSize="24"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Padding="18"
                                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1" CornerRadius="8">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="时间点"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock x:Name="ProfileTimePointCountText" FontSize="24"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <TextBlock Text="使用左侧导航在课表、时间表、科目和调课页面之间切换。"
                                       FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </ScrollViewer>

                    <Grid x:Name="PageSchedule" IsVisible="False" Margin="32,16,32,24"
                          RowDefinitions="Auto,Auto,*" ColumnDefinitions="*,5,350">

                    
                    <StackPanel Grid.Row="0" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="8"
                                Margin="0,0,4,8">
                        <ui:CommandBar x:Name="ClassCommandBar" DefaultLabelPosition="Right"
                                       Background="Transparent" VerticalAlignment="Center"/>
                        <ComboBox x:Name="ParityCombo" Width="120" VerticalAlignment="Center">
                            <ComboBoxItem Content="全部课程"/>
                            <ComboBoxItem Content="单周"/>
                            <ComboBoxItem Content="双周"/>
                        </ComboBox>
                    </StackPanel>

                    
                    <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Spacing="8" Margin="4,0,4,8">
                        <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="10,4">
                            <TextBlock x:Name="NavDateText" FontSize="13" VerticalAlignment="Center"/>
                        </Border>
                        <Button x:Name="PrevWeekButton" Padding="8,2" VerticalAlignment="Center">
                            <ui:FontIcon FontFamily="avares://ClassNex/Assets/Fonts/#lucide" Glyph="&#xE06E;" FontSize="14"/>
                        </Button>
                        <Button x:Name="NextWeekButton" Padding="8,2" VerticalAlignment="Center">
                            <ui:FontIcon FontFamily="avares://ClassNex/Assets/Fonts/#lucide" Glyph="&#xE06F;" FontSize="14"/>
                        </Button>
                        <TextBlock x:Name="NavWeekText" Text="第1周" FontSize="13" Opacity="0.8"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    
                    <DataGrid x:Name="WeekGrid" Grid.Row="2" Grid.Column="0"
                              Margin="0,0,4,0"
                              AutoGenerateColumns="False"
                              CanUserSortColumns="False"
                              CanUserReorderColumns="False"
                              CanUserResizeColumns="False"
                              SelectionMode="Single"
                              GridLinesVisibility="All"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="时间" Width="88">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding TimeText}" FontSize="13"
                                                   VerticalAlignment="Center" Margin="4,0,0,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Sunday}" FontSize="13"
                                                   VerticalAlignment="Center" Margin="6,4"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Monday}" FontSize="13"
                                                   VerticalAlignment="Center" Margin="6,4"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Tuesday}" FontSize="13"
                                                   VerticalAlignment="Center" Margin="6,4"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Wednesday}" FontSize="13"
                                                   VerticalAlignment="Center" Margin="6,4"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Thursday}" FontSize="13"
                                                   VerticalAlignment="Center" Margin="6,4"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Friday}" FontSize="13"
                                                   VerticalAlignment="Center" Margin="6,4"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Saturday}" FontSize="13"
                                                   VerticalAlignment="Center" Margin="6,4"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <GridSplitter Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch" Background="Transparent"/>

                    
                    <DockPanel Grid.Row="2" Grid.Column="2" Margin="12,0,0,0">
                        <TextBlock DockPanel.Dock="Top" Text="编辑科目" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <CheckBox DockPanel.Dock="Bottom" x:Name="AutoAdvanceCheck"
                                  Content="选完科目自动移动到下一个课程" Margin="0,10,0,0"/>
                        <TextBlock DockPanel.Dock="Bottom" x:Name="PaletteHintText" FontSize="11" TextWrapping="Wrap"
                                   Margin="0,6,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <Border Margin="0,10,0,0"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="10">
                            
                            <ListBox x:Name="SubjectPaletteList" Background="Transparent" BorderThickness="0"
                                     SelectionMode="Single">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="Transparent" Padding="8">
                                            <TextBlock Text="{Binding DisplayName}" FontSize="16"
                                                       ToolTip.Tip="{Binding Name}" IsHitTestVisible="False"/>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </DockPanel>
                </Grid>

                    <DockPanel x:Name="PageTime" IsVisible="False" Margin="32,16,32,24">
                    <ui:InfoBar x:Name="TimeInfoBar" DockPanel.Dock="Top" Severity="Informational"
                                IsOpen="False" IsClosable="True" Margin="0,0,0,8"/>

                    <Grid ColumnDefinitions="*,330">
                        <DockPanel Grid.Column="0">
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
                                <Button x:Name="AddClassTimeButton" Content="上课"/>
                                <Button x:Name="AddBreakTimeButton" Content="课间"/>
                                <Button x:Name="AddSeparatorButton" Content="分割线"/>
                                <Button x:Name="AddActionButton" Content="行动"/>
                                <Button x:Name="DuplicateTimeButton" Content="创建副本"/>
                                <Button x:Name="RemoveTimeButton" Content="删除"/>
                                <Button x:Name="MoveUpButton" Content="上移"/>
                                <Button x:Name="MoveDownButton" Content="下移"/>
                                <Button x:Name="ResetTimeButton" Content="从课表重建"/>
                            </StackPanel>

                            <Expander DockPanel.Dock="Bottom" HorizontalAlignment="Stretch" Margin="0,8,8,0"
                                      ExpandDirection="Up" Header="时间点时长" Padding="12,10">
                                <StackPanel Spacing="4">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="默认上课时间点时长" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                            <ui:NumberBox x:Name="ClassMinutesBox" Maximum="36000" Minimum="0"
                                                          Width="120" SpinButtonPlacementMode="Inline"/>
                                            <TextBlock Text="分钟" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="默认课间时间点时长" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                            <ui:NumberBox x:Name="BreakMinutesBox" Maximum="36000" Minimum="0"
                                                          Width="120" SpinButtonPlacementMode="Inline"/>
                                            <TextBlock Text="分钟" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Expander>

                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="TimeAxisPanel" Spacing="2" Margin="0,0,8,0"/>
                            </ScrollViewer>
                        </DockPanel>

                        <Border Grid.Column="1" Margin="12,0,0,0"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="14">
                            <StackPanel Spacing="12">
                                <TextBlock x:Name="TimeEditorTitle" Text="时间点" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

                                <StackPanel Spacing="4">
                                    <TextBlock Text="名称" FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <TextBox x:Name="TimeNameBox"/>
                                </StackPanel>

                                <StackPanel Spacing="4">
                                    <TextBlock Text="开始时间" FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <TimePicker x:Name="TimeStartPicker" HorizontalAlignment="Stretch"/>
                                </StackPanel>

                                <StackPanel Spacing="4">
                                    <TextBlock Text="结束时间" FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <TimePicker x:Name="TimeEndPicker" HorizontalAlignment="Stretch"/>
                                </StackPanel>

                                <StackPanel Spacing="4">
                                    <TextBlock Text="类型" FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <ComboBox x:Name="TimeKindCombo" HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="上课"/>
                                        <ComboBoxItem Content="课间"/>
                                        <ComboBoxItem Content="分割线"/>
                                        <ComboBoxItem Content="行动"/>
                                    </ComboBox>
                                </StackPanel>

                                <Button x:Name="SaveTimeButton" Content="保存修改" HorizontalAlignment="Left"/>

                                <TextBlock Text="课程的时间跟随其所在节次；修改时间会同步更新课表中使用该时段的课程。"
                                           FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    </DockPanel>

                    <Grid x:Name="PageSubject" IsVisible="False" Margin="32,16,32,24"
                          ColumnDefinitions="*,330">

                    <DockPanel Grid.Column="0">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
                            <Button x:Name="AddSubjectButton" Content="添加"/>
                            <Button x:Name="DeleteSubjectButton" Content="删除"/>
                        </StackPanel>

                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <Grid x:Name="SubjectTableGrid" Margin="0,0,8,0"/>
                        </ScrollViewer>
                    </DockPanel>

                    <Border Grid.Column="1" Margin="12,0,0,0"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="14">
                        <ScrollViewer>
                            <StackPanel Spacing="12">
                                <TextBlock Text="编辑科目信息" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

                                <StackPanel Spacing="4">
                                    <TextBlock Text="科目名" FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <TextBox x:Name="SubjectNameBox"/>
                                </StackPanel>

                                <StackPanel Spacing="4">
                                    <TextBlock Text="简称" FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <TextBox x:Name="SubjectSimplifiedBox"/>
                                </StackPanel>

                                <StackPanel Spacing="4">
                                    <TextBlock Text="科任老师" FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <TextBox x:Name="SubjectTeacherBox"/>
                                </StackPanel>

                                <CheckBox x:Name="OutdoorCheck" Content="该科目是户外课程"/>

                                <Button x:Name="SaveSubjectsButton" Content="保存" HorizontalAlignment="Left"/>

                                <TextBlock Text="修改会写回 CSES 课表文件。"
                                           FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                    </Grid>

                    <StackPanel x:Name="PageSwap" IsVisible="False" Margin="32,16,32,24" Spacing="12">
                    <TextBlock Text="临时调课（不改动基础课表，只覆盖某一天）功能开发中。"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </ui:NavigationView>
    </Grid>
</wd:AppWindow>
