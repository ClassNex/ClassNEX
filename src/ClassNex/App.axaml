<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sty="using:AvaloniaFluentUI.Styling"
             x:Class="ClassNex.App"
             RequestedThemeVariant="Default">

    <!-- 全局字体：内置的鸿蒙字体 HarmonyOS Sans SC -->
    <Application.Resources>
        <ResourceDictionary>
            <FontFamily x:Key="AppFontFamily">avares://ClassNex/Assets/Fonts/HarmonyOS_Sans_SC_Regular.ttf#HarmonyOS Sans SC</FontFamily>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <sty:FluentAvaloniaTheme PreferSystemTheme="True" />

        <!-- 所有窗口统一使用鸿蒙字体（TextElement.FontFamily 为继承属性，会下发到全部子控件） -->
        <Style Selector="Window">
            <Setter Property="TextElement.FontFamily" Value="{DynamicResource AppFontFamily}" />
        </Style>
    </Application.Styles>

    <!--
      注意：这里**不覆盖任何颜色资源**。
      经核实 CI 源码（ClassIsland/XamlThemes/FluentTheme/Styles.axaml），CI 的默认主题
      完全使用 FluentAvalonia 的标准资源键，没有硬编码色值；强调色跟随 Windows 系统强调色。
      本应用因此保持一致，不写死颜色。
    -->

    <!-- 系统托盘图标与菜单 -->
    <TrayIcon.Icons>
        <TrayIcons>
            <TrayIcon Icon="/Assets/icon.ico"
                      ToolTipText="ClassNex 课表"
                      Clicked="OnTrayIconClick">
                <TrayIcon.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="显示 / 隐藏主界面" Click="OnTrayToggleMainWindow"/>
                        <NativeMenuItemSeparator/>
                        <NativeMenuItem Header="编辑档案…" Click="OnTrayEditProfile"/>
                        <NativeMenuItem Header="加载课表…" Click="OnTrayLoadTimetable"/>
                        <NativeMenuItem Header="换课…" Click="OnTrayChangeClass"/>
                        <NativeMenuItemSeparator/>
                        <NativeMenuItem Header="编辑主界面…" Click="OnTrayEditMainWindow"/>
                        <NativeMenuItem Header="应用设置…" Click="OnTrayOpenSettings"/>
                        <NativeMenuItemSeparator/>
                        <NativeMenuItem Header="重启" Click="OnTrayRestart"/>
                        <NativeMenuItem Header="退出" Click="OnTrayExit"/>
                    </NativeMenu>
                </TrayIcon.Menu>
            </TrayIcon>
        </TrayIcons>
    </TrayIcon.Icons>

</Application>
