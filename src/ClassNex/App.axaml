<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sty="using:AvaloniaFluentUI.Styling"
             xmlns:afui="using:AvaloniaFluentUI.Controls"
             x:Class="ClassNex.App"
             RequestedThemeVariant="Default">

    
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="ClassNexCanvasBrush" Color="#F5F6F7"/>
                    <SolidColorBrush x:Key="ClassNexSurfaceBrush" Color="#FDFDFE"/>
                    <SolidColorBrush x:Key="ClassNexOutlineBrush" Color="#DCE0E3"/>
                    <SolidColorBrush x:Key="ClassNexOverlayBrush" Color="#242831"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="ClassNexCanvasBrush" Color="#202226"/>
                    <SolidColorBrush x:Key="ClassNexSurfaceBrush" Color="#2A2D32"/>
                    <SolidColorBrush x:Key="ClassNexOutlineBrush" Color="#404449"/>
                    <SolidColorBrush x:Key="ClassNexOverlayBrush" Color="#242831"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <CornerRadius x:Key="ClassNexCardRadius">10</CornerRadius>
            <FontFamily x:Key="AppFontFamily">avares://ClassNex/Assets/Fonts/#HarmonyOS Sans SC, Microsoft YaHei UI, Noto Sans CJK SC, sans-serif</FontFamily>
            <StaticResource x:Key="ContentControlThemeFontFamily" ResourceKey="AppFontFamily" />
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <sty:FluentAvaloniaTheme PreferSystemTheme="True" UseSystemFontOnWindows="False"
                                 TextVerticalAlignmentOverrideBehavior="AlwaysEnabled" />
        <StyleInclude Source="avares://ClassNex/Styles/ShellStyles.axaml"/>

        
        <Style Selector=":is(Window)">
            <Setter Property="TextElement.FontFamily" Value="{DynamicResource AppFontFamily}" />
        </Style>

        <Style Selector="ToggleSwitch">
            <Setter Property="OnContent" Value="开" />
            <Setter Property="OffContent" Value="关" />
        </Style>

        

        
        <Style Selector="afui|FontIcon">
            <Setter Property="FontFamily" Value="avares://ClassNex/Assets/Fonts/#lucide" />
        </Style>
    </Application.Styles>

    

    
    <TrayIcon.Icons>
        <TrayIcons>
            <TrayIcon Icon="/Assets/icon.ico"
                      ToolTipText="ClassNex 课表"
                      Clicked="OnTrayIconClick"/>
        </TrayIcons>
    </TrayIcon.Icons>

</Application>
