<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sty="using:FluentAvalonia.Styling"
             x:Class="ClassNex.App"
             RequestedThemeVariant="Default">

    <Application.Styles>
        <sty:FluentAvaloniaTheme PreferSystemTheme="True" />
    </Application.Styles>

    <!--
      深色主题的表面色对齐 CI（ClassIsland）实测值。
      FluentAvaloniaTheme.TryGetResource 会优先采用应用级资源，因此这里的同名键可覆盖主题默认值。
      取值来源：CI 运行界面截图像素统计（_tools/analyze_ci_palette.py）。
    -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#272D2E" />
                    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#272D2E" />
                    <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="#252829" />
                    <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush" Color="#292D2E" />
                    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#1A2225" />
                    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#292D2E" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <!-- 系统托盘图标与菜单 -->
    <TrayIcon.Icons>
        <TrayIcons>
            <TrayIcon Icon="/Assets/icon.ico"
                      ToolTipText="ClassNex 课表"
                      Clicked="OnTrayIconClick">
                <TrayIcon.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="显示 / 隐藏主界面" Click="OnTrayToggleMainWindow"/>
                        <NativeMenuItemSeparator/>
                        <NativeMenuItem Header="编辑档案…" Click="OnTrayEditProfile"/>
                        <NativeMenuItem Header="加载课表…" Click="OnTrayLoadTimetable"/>
                        <NativeMenuItem Header="换课…" Click="OnTrayChangeClass"/>
                        <NativeMenuItemSeparator/>
                        <NativeMenuItem Header="编辑主界面…" Click="OnTrayEditMainWindow"/>
                        <NativeMenuItem Header="应用设置…" Click="OnTrayOpenSettings"/>
                        <NativeMenuItemSeparator/>
                        <NativeMenuItem Header="重启" Click="OnTrayRestart"/>
                        <NativeMenuItem Header="退出" Click="OnTrayExit"/>
                    </NativeMenu>
                </TrayIcon.Menu>
            </TrayIcon>
        </TrayIcons>
    </TrayIcon.Icons>

</Application>
