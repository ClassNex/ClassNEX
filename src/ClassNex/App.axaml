<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sty="using:AvaloniaFluentUI.Styling"
             xmlns:afui="using:AvaloniaFluentUI.Controls"
             x:Class="ClassNex.App"
             RequestedThemeVariant="Default">

    
    <Application.Resources>
        <ResourceDictionary>
            <FontFamily x:Key="AppFontFamily">avares://ClassNex/Assets/Fonts/#MiSans</FontFamily>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <sty:FluentAvaloniaTheme PreferSystemTheme="True" />

        
        <Style Selector="Window">
            <Setter Property="TextElement.FontFamily" Value="{DynamicResource AppFontFamily}" />
        </Style>

        

        
        <Style Selector="afui|FontIcon">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
        </Style>
    </Application.Styles>

    

    
    <TrayIcon.Icons>
        <TrayIcons>
            <TrayIcon Icon="/Assets/icon.ico"
                      ToolTipText="ClassNex 课表"
                      Clicked="OnTrayIconClick"/>
        </TrayIcons>
    </TrayIcon.Icons>

</Application>
