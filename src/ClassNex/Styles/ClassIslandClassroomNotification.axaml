<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StyleInclude Source="/Styles/Upstream/ClassIsland/SlidingListBox.axaml"/>
    <StyleInclude Source="/Styles/Upstream/ClassIsland/Layers.axaml"/>
    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light"><SolidColorBrush x:Key="TextFillColorInformativeSecondaryBrush" Color="#c0000000"/></ResourceDictionary>
                <ResourceDictionary x:Key="Dark"><SolidColorBrush x:Key="TextFillColorInformativeSecondaryBrush" Color="#daffffff"/></ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <x:Double x:Key="MainWindowBodyFontSize">16</x:Double>
            <x:Double x:Key="MainWindowSecondaryFontSize">14</x:Double>
            <x:Double x:Key="MainWindowEmphasizedFontSize">18</x:Double>
            <x:Double x:Key="MainWindowLargeFontSize">20</x:Double>
        </ResourceDictionary>
    </Styles.Resources>
    <Style Selector="ListBoxItem TextBlock"><Setter Property="Margin" Value="0 0 0 -3"/></Style>
    <Style Selector="Border#IslandBackground.reminder-resize">
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Width" Duration="0:0:0.300" Easing="0.65, 0, 0.35, 1.0"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border#NotificationMaskContent.entering">
        <Style.Animations>
            <Animation Delay="0:0:0.26" Duration="0:0:0.25" IterationCount="1"
                       FillMode="Both"
                       Easing="0.25, 1, 0.5, 1">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0.0"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1.0"/>
                </KeyFrame>
            </Animation>
            <Animation Delay="0:0:0.26" Duration="0:0:0.75" IterationCount="1"
                       FillMode="Both"
                       Easing="0.25, 1, 0.5, 1">
                <KeyFrame Cue="0%">
                    <Setter Property="ScaleTransform.ScaleX" Value="1.1"/>
                    <Setter Property="ScaleTransform.ScaleY" Value="1.1"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="ScaleTransform.ScaleX" Value="1.0"/>
                    <Setter Property="ScaleTransform.ScaleY" Value="1.0"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Border#NotificationMaskContent.revealing">
        <Style.Animations>
            <Animation Duration="0:0:0.2" IterationCount="1"
                       FillMode="Forward">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="1.0"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="0.0"/>
                </KeyFrame>
            </Animation>
            <Animation Duration="0:0:0.2" IterationCount="1"
                       FillMode="Both"
                       Easing="0.5, 0, 0.75, 0">
                <KeyFrame Cue="0%">
                    <Setter Property="ScaleTransform.ScaleX" Value="1.0"/>
                    <Setter Property="ScaleTransform.ScaleY" Value="1.0"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="ScaleTransform.ScaleX" Value="1.1"/>
                    <Setter Property="ScaleTransform.ScaleY" Value="1.1"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
</Styles>
